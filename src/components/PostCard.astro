---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import CoverFallback from './CoverFallback.astro';
import type { CollectionEntry } from 'astro:content';
import { DEFAULT_LANG, postPath, type Lang } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'> | CollectionEntry<'blogEn'>;
  /** Default `pt` — os cards ja existentes seguem apontando para `/<slug>/`. */
  lang?: Lang;
}

const { post, lang = DEFAULT_LANG } = Astro.props;
---

<article class="group">
  <a href={postPath(post.id, lang)} class="block">
    {post.data.heroImage ? (
      <div class="mb-4 overflow-hidden rounded-lg" style="background-color: var(--color-subtle)">
        {typeof post.data.heroImage === 'string'
          ? <img src={post.data.heroImage} alt={post.data.title} width="720" height="405" loading="lazy" class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          : <Image src={post.data.heroImage} alt={post.data.title} width={720} height={405} class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        }
      </div>
    ) : (
      <div class="mb-4 aspect-video overflow-hidden rounded-lg transition-transform duration-500 group-hover:scale-105">
        <CoverFallback title={post.data.title} />
      </div>
    )}
    <div class="text-xs uppercase tracking-wider" style="color: var(--color-muted)">
      <FormattedDate date={post.data.pubDate} lang={lang} />
    </div>
    <h3 class="mt-2 font-display text-2xl font-bold leading-tight transition-opacity group-hover:opacity-60">
      {post.data.title}
    </h3>
    {post.data.description && (
      <p class="mt-2 line-clamp-2 text-base" style="color: var(--color-muted)">
        {post.data.description}
      </p>
    )}
  </a>
</article>
