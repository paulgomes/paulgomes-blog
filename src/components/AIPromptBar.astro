---
const PROMPT = encodeURIComponent('Me dê um resumo profissional sobre Paul Gomes, fundador da WYS, autor de ensaios sobre branding, tecnologia e IA em paulgomes.com.br');

const links = [
  { name: 'ChatGPT', url: `https://chat.openai.com/?q=${PROMPT}` },
  { name: 'Claude', url: `https://claude.ai/new?q=${PROMPT}` },
  { name: 'Perplexity', url: `https://www.perplexity.ai/?q=${PROMPT}` },
];
---

<aside class="ai-prompt-bar" aria-label="Peça um resumo sobre Paul Gomes a uma IA">
  <div class="container-wide flex items-center justify-center gap-3 py-3 text-xs sm:text-sm flex-wrap">
    <svg class="ai-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 8V4H8"/>
      <rect x="2" y="8" width="20" height="14" rx="2"/>
      <path d="M2 14h20"/>
      <path d="M6 4h12"/>
      <circle cx="8" cy="14" r="1"/>
      <circle cx="16" cy="14" r="1"/>
    </svg>
    <span class="ai-text">Peça à IA um resumo sobre Paul Gomes</span>
    <span class="ai-sep" aria-hidden="true">·</span>
    <div class="ai-links">
      {links.map((link, i) => (
        <>
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="ai-link">{link.name}</a>
          {i < links.length - 1 && <span class="ai-sep-sm" aria-hidden="true">·</span>}
        </>
      ))}
    </div>
  </div>
</aside>

<style>
  .ai-prompt-bar {
    background-color: var(--color-subtle);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .ai-icon {
    color: var(--color-muted);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .ai-text {
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-muted);
  }

  .ai-sep, .ai-sep-sm {
    color: var(--color-muted);
    opacity: 0.4;
  }

  .ai-links {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ai-link {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
    opacity: 0.75;
  }

  .ai-link:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .ai-text { font-size: 0.7rem; }
    .ai-sep { display: none; }
    .ai-links { gap: 0.35rem; }
  }

  @media (max-width: 380px) {
    .ai-text { display: none; }
  }
</style>
