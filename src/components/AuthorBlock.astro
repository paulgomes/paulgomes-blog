---
import { Image } from 'astro:assets';
import SocialIcons from './SocialIcons.astro';
import authorPhoto from '../assets/brand/paul-avatar.png';
---

<section class="author-light author-as-hero">
  <!-- Canvas do matrix sutil em ciano claro -->
  <canvas class="matrix-canvas-light" aria-hidden="true"></canvas>

  <!-- Overlay branco suave nas bordas pra fundir -->
  <div class="matrix-overlay-light" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    <div class="grid gap-8 lg:grid-cols-[5fr_6fr] lg:gap-16 items-center">
      <!-- Foto à esquerda — sem moldura, integra com o fundo -->
      <div class="photo-wrap-light">
        <Image
          src={authorPhoto}
          alt="Paul Gomes"
          width={900}
          widths={[480, 720, 900]}
          class="photo-light w-full h-auto"
          loading="lazy"
        />
      </div>

      <!-- Texto à direita -->
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] eyebrow-light">
          ◆ Sobre o autor
        </p>
        <h2 class="font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
          Paul Gomes —<br />
          <span class="brand-cyan-light">Thinking Forward</span>.
        </h2>
        <div class="mt-8 space-y-5 text-lg leading-relaxed" style="color: var(--color-muted)">
          <p>
            Escrevo sobre inteligência artificial, GEO, SEO, arquitetura digital e as transformações que redefinem negócios, marcas e comportamento.
          </p>
          <p>
            Pra quem quer pensar adiante, e não apenas correr atrás.
          </p>
        </div>

        <!-- Newsletter inline -->
        <div class="mt-10">
          <form
            action="#"
            method="post"
            class="flex flex-col gap-3 sm:flex-row max-w-lg"
            onsubmit="event.preventDefault(); alert('Newsletter em breve! Me siga no LinkedIn ou Instagram.');"
          >
            <input
              type="email"
              name="email"
              required
              placeholder="seu@email.com"
              aria-label="Seu e-mail"
              class="newsletter-input-light flex-1 rounded-full px-6 py-4 text-base outline-none"
            />
            <button
              type="submit"
              class="newsletter-btn-cyan-light rounded-full px-7 py-4 text-sm font-bold"
            >
              Inscrever →
            </button>
          </form>
        </div>

        <!-- Redes sociais -->
        <div class="mt-8 social-dark">
          <SocialIcons size={22} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .author-light {
    position: relative;
    background-color: var(--color-paper);
    color: var(--color-ink);
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--color-border);
  }

  .author-as-hero {
    margin-top: 0;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .author-as-hero {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }
  }

  .matrix-canvas-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.55;
    pointer-events: none;
  }

  /* Overlay branco que fade nas bordas */
  .matrix-overlay-light {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(
      ellipse at center,
      transparent 40%,
      var(--color-paper) 95%
    );
    pointer-events: none;
  }

  /* Forward em ciano vibrante */
  .brand-cyan-light {
    color: #00b4d8;
    text-shadow: 0 0 22px rgba(0, 180, 216, 0.15);
  }

  .eyebrow-light {
    color: #00b4d8;
    opacity: 0.85;
  }

  /* Foto integra com o fundo (sem moldura) */
  .photo-wrap-light {
    position: relative;
  }

  .photo-light {
    /* Não tem aspect-ratio fixo — deixa a foto natural */
    max-width: 100%;
    object-fit: contain;
    object-position: bottom;
    /* Sombra suave abaixo pra dar profundidade */
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.12));
  }

  /* Newsletter clara */
  .newsletter-input-light {
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    color: var(--color-ink);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .newsletter-input-light::placeholder {
    color: var(--color-muted);
  }

  .newsletter-input-light:focus {
    border-color: #00b4d8;
    box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.15);
  }

  .newsletter-btn-cyan-light {
    background: linear-gradient(45deg, #00b4d8, #0096b8);
    color: #fff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
    border: none;
  }

  .newsletter-btn-cyan-light:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 180, 216, 0.35);
  }

  /* Redes sociais escuras (sobre fundo claro) */
  .social-dark :global(svg) {
    color: var(--color-ink);
    opacity: 0.65;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .social-dark :global(a:hover svg) {
    color: #00b4d8;
    opacity: 1;
  }

  /* DARK MODE: inverte tudo */
  :global(.dark) .author-light {
    background-color: #020202;
    color: #fff;
  }

  :global(.dark) .matrix-overlay-light {
    background: radial-gradient(
      ellipse at center,
      transparent 30%,
      #020202 95%
    );
  }

  :global(.dark) .author-light h2 {
    color: #fff;
  }

  :global(.dark) .author-light p {
    color: rgba(255, 255, 255, 0.7) !important;
  }
</style>

<script>
  // Matrix rain CLARO — caracteres ciano sutis sobre fundo branco
  (function () {
    const section = document.querySelector<HTMLElement>('.author-light');
    const canvas = section?.querySelector<HTMLCanvasElement>('.matrix-canvas-light');
    if (!section || !canvas) return;

    // Respeitar prefers-reduced-motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Desligar no mobile (economia de bateria)
    if (window.matchMedia('(max-width: 768px)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const CHARS = 'PAULGOMESWYSMARKETING01THINKINGFORWARD◆';
    const FONT_SIZE = 18;
    let drops: number[] = [];
    let rafId = 0;

    function isDark(): boolean {
      return document.documentElement.classList.contains('dark');
    }

    function resize() {
      if (!canvas || !section) return;
      canvas.width = section.offsetWidth;
      canvas.height = section.offsetHeight;
      const columns = Math.floor(canvas.width / FONT_SIZE);
      drops = new Array(columns).fill(0).map(() => Math.random() * -50);
    }

    let lastFrame = 0;
    const FRAME_INTERVAL = 60; // ms entre frames (mais sutil que a versão escura)

    function draw(now: number) {
      if (!canvas || !ctx) return;
      if (now - lastFrame >= FRAME_INTERVAL) {
        lastFrame = now;

        const dark = isDark();
        // Cor de fundo do fade (varia com tema)
        ctx.fillStyle = dark ? 'rgba(2, 2, 2, 0.10)' : 'rgba(255, 255, 255, 0.10)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Cor dos caracteres: ciano sempre, mas mais opaco no dark
        ctx.fillStyle = dark
          ? 'rgba(0, 210, 211, 0.85)'
          : 'rgba(0, 180, 216, 0.42)';
        ctx.font = `${FONT_SIZE}px ui-monospace, "Courier New", monospace`;

        for (let i = 0; i < drops.length; i++) {
          const char = CHARS[Math.floor(Math.random() * CHARS.length)];
          ctx.fillText(char, i * FONT_SIZE, drops[i] * FONT_SIZE);
          if (drops[i] * FONT_SIZE > canvas.height && Math.random() > 0.975) {
            drops[i] = 0;
          }
          drops[i]++;
        }
      }
      rafId = requestAnimationFrame(draw);
    }

    function start() {
      resize();
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(draw);
    }

    // Inicia quando a seção entra na viewport
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            cancelAnimationFrame(rafId);
          }
        });
      },
      { threshold: 0.1 }
    );

    io.observe(section);
    window.addEventListener('resize', resize);
  })();
</script>
