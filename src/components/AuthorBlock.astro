---
import { Image } from 'astro:assets';
import authorPhoto from '../assets/brand/paul-avatar.png';
---

<section class="author-cinematic">
  <!-- Canvas matrix sutil -->
  <canvas class="cinematic-matrix" aria-hidden="true"></canvas>

  <!-- Overlay com gradient radial pra fundir nas bordas -->
  <div class="cinematic-overlay" aria-hidden="true"></div>

  <div class="cinematic-inner">
    <div class="cinematic-grid">
      <!-- COLUNA FOTO -->
      <div class="cinematic-photo">
        <Image
          src={authorPhoto}
          alt="Paul Gomes"
          width={1440}
          widths={[720, 1080, 1440]}
          class="photo-img"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- COLUNA TEXTO -->
      <div class="cinematic-text">
        <p class="cinematic-eyebrow">
          <span class="eyebrow-dot">◆</span> Sobre o autor
        </p>

        <h1 class="cinematic-headline">
          Paul Gomes —<br />
          <span class="forward-cyan">Thinking Forward</span>.
        </h1>

        <div class="cinematic-bio">
          <p>
            Escrevo sobre inteligência artificial, GEO, SEO, arquitetura digital e as transformações que redefinem negócios, marcas e comportamento.
          </p>
          <p>
            Pra quem quer pensar adiante, e não apenas correr atrás.
          </p>
        </div>

        <!-- NEWSLETTER -->
        <form
          action="#"
          method="post"
          class="cinematic-form"
          onsubmit="event.preventDefault(); alert('Newsletter em breve! Me siga no LinkedIn ou Instagram.');"
        >
          <input
            type="email"
            name="email"
            required
            placeholder="seu@email.com"
            aria-label="Seu e-mail"
            class="cinematic-input"
          />
          <button type="submit" class="cinematic-btn">
            Inscrever →
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .author-cinematic {
    position: relative;
    background-color: var(--color-paper);
    color: var(--color-ink);
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--color-border);
    min-height: 80vh;
    display: flex;
    align-items: stretch;
  }

  .cinematic-matrix {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.7;
    pointer-events: none;
  }

  .cinematic-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(ellipse 70% 50% at center, transparent 30%, var(--color-paper) 95%);
    pointer-events: none;
  }

  .cinematic-inner {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem 0;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .cinematic-inner {
      padding: 5rem 2rem 0;
    }
  }

  @media (min-width: 1280px) {
    .cinematic-inner {
      padding: 6rem 3rem 0;
    }
  }

  .cinematic-grid {
    flex: 1;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .cinematic-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
    }
  }

  /* === FOTO: sólida, sem mask, encosta no rodapé === */
  .cinematic-photo {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    align-self: end;
  }

  .photo-img {
    width: 100%;
    height: auto;
    max-width: 540px;
    margin: 0 auto;
    display: block;
    filter:
      drop-shadow(0 24px 48px rgba(0, 0, 0, 0.12))
      drop-shadow(0 8px 16px rgba(0, 0, 0, 0.06));
  }

  @media (min-width: 1024px) {
    .photo-img {
      max-width: 620px;
    }
  }

  @media (min-width: 1280px) {
    .photo-img {
      max-width: 680px;
    }
  }

  /* === TEXTO === */
  .cinematic-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: #00b4d8;
    margin: 0 0 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .eyebrow-dot {
    font-size: 0.7em;
  }

  /* === HEADLINE BALANCEADA === */
  .cinematic-headline {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    margin: 0;
    color: var(--color-ink);
    text-align: left;
  }

  @media (min-width: 1024px) {
    .cinematic-headline {
      font-size: clamp(1.8rem, 2.6vw, 2.6rem);
    }
  }

  .forward-cyan {
    color: #00b4d8;
    background: linear-gradient(135deg, #00b4d8 0%, #0096b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 30px rgba(0, 180, 216, 0.18);
  }

  /* === BIO E SPACING === */
  .cinematic-bio {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 500px;
  }

  .cinematic-bio p {
    margin: 0;
  }

  /* === FORM NEWSLETTER === */
  .cinematic-form {
    margin-top: 2rem;
    display: flex;
    gap: 0.75rem;
    max-width: 460px;
    flex-direction: column;
  }

  @media (min-width: 480px) {
    .cinematic-form {
      flex-direction: row;
    }
  }

  .cinematic-input {
    flex: 1;
    padding: 1rem 1.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cinematic-input::placeholder {
    color: var(--color-muted);
  }

  .cinematic-input:focus {
    border-color: #00b4d8;
    box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.15);
  }

  .cinematic-btn {
    padding: 1rem 1.75rem;
    border-radius: 9999px;
    border: none;
    background: linear-gradient(135deg, #00b4d8 0%, #0096b8 100%);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .cinematic-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 180, 216, 0.35);
  }

  /* === MOBILE: foto antes do texto === */
  @media (max-width: 1023px) {
    .author-cinematic {
      min-height: auto;
    }
    .cinematic-photo {
      order: -1;
      max-width: 340px;
      margin: 0 auto;
    }
  }

  /* === DARK MODE === */
  :global(.dark) .author-cinematic {
    background-color: #020202;
  }

  :global(.dark) .cinematic-overlay {
    background: radial-gradient(ellipse 70% 50% at center, transparent 30%, #020202 95%);
  }

  :global(.dark) .cinematic-headline {
    color: #fff;
  }

  :global(.dark) .cinematic-bio {
    color: rgba(255, 255, 255, 0.72);
  }

  :global(.dark) .cinematic-input {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  :global(.dark) .cinematic-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  /* === FADE-IN ANIMATIONS === */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Aplica animações com delays escalonados */
  .cinematic-photo {
    animation: fadeInLeft 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .cinematic-eyebrow {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  .cinematic-headline {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
  }

  .cinematic-bio {
    animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.75s both;
  }

  .cinematic-form {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.95s both;
  }

  .cinematic-matrix {
    animation: fadeIn 2s ease 0.3s both;
  }

  /* Respeita usuários com motion reduzido (acessibilidade) */
  @media (prefers-reduced-motion: reduce) {
    .cinematic-photo,
    .cinematic-eyebrow,
    .cinematic-headline,
    .cinematic-bio,
    .cinematic-form,
    .cinematic-matrix {
      animation: none;
    }
  }
</style>

<script>
  // Matrix rain refinado — mais sutil e atmosférico
  (function () {
    const section = document.querySelector<HTMLElement>('.author-cinematic');
    const canvas = section?.querySelector<HTMLCanvasElement>('.cinematic-matrix');
    if (!section || !canvas) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(max-width: 1023px)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const CHARS = 'PAULGOMESWYSAITHINKINGFORWARDGEOSEOINTELIGENCIAARTIFICIAL01◆';
    const FONT_SIZE = 16;
    let drops: { x: number; y: number; speed: number; opacity: number }[] = [];
    let rafId = 0;

    function isDark(): boolean {
      return document.documentElement.classList.contains('dark');
    }

    function resize() {
      if (!canvas || !section) return;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = section.offsetWidth * dpr;
      canvas.height = section.offsetHeight * dpr;
      canvas.style.width = section.offsetWidth + 'px';
      canvas.style.height = section.offsetHeight + 'px';
      ctx?.scale(dpr, dpr);

      const columns = Math.floor(section.offsetWidth / FONT_SIZE);
      drops = new Array(columns).fill(null).map((_, i) => ({
        x: i * FONT_SIZE,
        y: Math.random() * -section.offsetHeight,
        speed: 0.5 + Math.random() * 1.5,
        opacity: 0.3 + Math.random() * 0.7,
      }));
    }

    let lastFrame = 0;
    const FRAME_INTERVAL = 50;

    function draw(now: number) {
      if (!canvas || !ctx || !section) return;
      if (now - lastFrame >= FRAME_INTERVAL) {
        lastFrame = now;

        const dark = isDark();
        // Fade do frame anterior
        ctx.fillStyle = dark ? 'rgba(2, 2, 2, 0.08)' : 'rgba(255, 255, 255, 0.10)';
        ctx.fillRect(0, 0, section.offsetWidth, section.offsetHeight);

        ctx.font = `${FONT_SIZE}px ui-monospace, "SF Mono", "Courier New", monospace`;

        for (const drop of drops) {
          const char = CHARS[Math.floor(Math.random() * CHARS.length)];
          // Cor varia com tema, opacidade variável por drop pra dar profundidade
          const color = dark
            ? `rgba(0, 210, 211, ${drop.opacity * 0.85})`
            : `rgba(0, 180, 216, ${drop.opacity * 0.55})`;
          ctx.fillStyle = color;
          ctx.fillText(char, drop.x, drop.y);

          drop.y += drop.speed * FONT_SIZE * 0.4;
          if (drop.y > section.offsetHeight && Math.random() > 0.97) {
            drop.y = Math.random() * -100;
          }
        }
      }
      rafId = requestAnimationFrame(draw);
    }

    function start() {
      resize();
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(draw);
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            cancelAnimationFrame(rafId);
          }
        });
      },
      { threshold: 0.1 }
    );

    io.observe(section);
    window.addEventListener('resize', () => {
      cancelAnimationFrame(rafId);
      setTimeout(start, 100);
    });
  })();
</script>
