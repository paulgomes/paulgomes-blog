---
// Newsletter — placeholder. Quando definir provedor (ConvertKit, Mailchimp, Beehiiv, Buttondown),
// substituir o action e o input pelo embed deles.
---

<section class="newsletter-section border-t" style="border-color: var(--color-border)">
  <div class="container-wide py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em]" style="color: var(--color-muted)">
        ◆ Newsletter
      </p>
      <h2 class="font-display text-3xl font-bold leading-tight tracking-tight md:text-5xl">
        Receba os próximos ensaios<br class="hidden md:inline" />
        no seu e-mail.
      </h2>
      <p class="mt-5 text-lg" style="color: var(--color-muted)">
        Sem spam. Cancele quando quiser. Apenas pensamento sobre branding, tecnologia e negócios.
      </p>

      <form
        action="#"
        method="post"
        class="newsletter-form mt-10 mx-auto flex max-w-xl flex-col gap-3 sm:flex-row"
        onsubmit="event.preventDefault(); alert('Newsletter em breve! Por enquanto, me siga no LinkedIn ou Instagram.');"
      >
        <input
          type="email"
          name="email"
          required
          placeholder="seu@email.com"
          aria-label="Seu e-mail"
          class="newsletter-input flex-1 rounded-full px-6 py-4 text-base outline-none transition"
        />
        <button
          type="submit"
          class="newsletter-btn rounded-full px-7 py-4 text-sm font-medium transition-opacity hover:opacity-80"
          style="background-color: var(--color-ink); color: var(--color-paper);"
        >
          Inscrever →
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .newsletter-input {
    background-color: var(--color-paper);
    border: 1px solid var(--color-border);
    color: var(--color-ink);
  }

  .newsletter-input:focus {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-ink) 15%, transparent);
  }

  .newsletter-input::placeholder {
    color: var(--color-muted);
  }
</style>
