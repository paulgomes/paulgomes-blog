---
// Banner AdSense responsivo (leaderboard / billboard).
// O loader do AdSense fica no <head> (BaseHead.astro), com o publisher
// ca-pub-6639862760844520. Para usar um bloco de anúncio específico, informe
// o `slot` (data-ad-slot do painel do AdSense); sem ele o Auto Ads decide.
interface Props {
  label?: string;
  slot?: string;
}
const { label = 'Publicidade', slot } = Astro.props;
const client = 'ca-pub-6639862760844520';
---

<aside class="adslot" aria-label="Publicidade">
  <div class="container-wide">
    <p class="adslot-eyebrow">{label}</p>
    <div class="adslot-inner" data-ad-slot>
      <ins
        class="adsbygoogle"
        style="display:block;width:100%"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="horizontal"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  </div>
</aside>

<style>
  .adslot {
    padding: 1.5rem 0 2.25rem;
  }

  .adslot-eyebrow {
    text-align: center;
    margin: 0 0 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.55;
  }

  /* Bloco, não flex: o AdSense precisa medir a largura do <ins> para
     escolher o formato (em flex ele recebe availableWidth=0 e falha). */
  .adslot-inner {
    display: block;
    width: 100%;
    max-width: 970px;
    margin: 0 auto;
    min-height: 90px;
    border-radius: 12px;
    overflow: hidden;
  }

  .adslot-inner :global(ins.adsbygoogle) {
    display: block;
    width: 100%;
  }

  @media (min-width: 768px) {
    .adslot-inner {
      min-height: 120px;
    }
  }

  :global(.dark) .adslot-inner {
    background: rgba(255, 255, 255, 0.03);
  }
</style>
