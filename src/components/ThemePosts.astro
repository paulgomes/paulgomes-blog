---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  eyebrow?: string;
  title: string;
  description?: string;
  perPage?: number;
  // Quando informado, contador mostra paginas do arquivo inteiro (autoridade),
  // e o "Proximo" da ultima pagina interna leva ao link /blog.
  totalCount?: number;
  archiveHref?: string;
}

const {
  posts,
  eyebrow,
  title,
  description,
  perPage = 4,
  totalCount,
  archiveHref = '/blog',
} = Astro.props;
const totalPages = Math.max(1, Math.ceil(posts.length / perPage));
const pageIndices = Array.from({ length: totalPages }, (_, i) => i);
// Total de paginas considerando TODOS os posts do site (sinaliza autoridade).
const displayTotalPages = totalCount && totalCount > posts.length
  ? Math.ceil(totalCount / perPage)
  : totalPages;
const hasArchiveOverflow = displayTotalPages > totalPages;
---

<section class="theme-section border-t" style="border-color: var(--color-border)">
  <div class="container-wide py-16 md:py-20">
    <SectionHeader eyebrow={eyebrow} title={title} description={description} />

    <div class="theme-pages">
      {pageIndices.map((pageIdx) => (
        <div class="theme-page" data-page={pageIdx} hidden={pageIdx !== 0}>
          {posts.slice(pageIdx * perPage, (pageIdx + 1) * perPage).map((post) => <PostCard post={post} />)}
        </div>
      ))}
    </div>

    {(totalPages > 1 || hasArchiveOverflow) && (
      <nav
        class="theme-pagination"
        aria-label="Paginação"
        data-archive-href={archiveHref}
        data-internal-pages={totalPages}
        data-has-overflow={hasArchiveOverflow ? '1' : '0'}
      >
        <button type="button" class="btn-neu btn-sm" data-action="prev" disabled aria-label="Página anterior">
          ← Anterior
        </button>
        <span class="pagination-count" aria-live="polite">
          <span data-current>1</span> <span class="pagination-sep">/</span> {displayTotalPages}
        </span>
        <button type="button" class="btn-neu btn-sm" data-action="next" aria-label="Próxima página">
          Próximo →
        </button>
      </nav>
    )}
  </div>
</section>

<style>
  .theme-section {
    background-color: var(--color-subtle);
  }

  .theme-page {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .theme-page {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .theme-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .pagination-btn {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-border);
    padding: 0.7rem 1.4rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .pagination-btn:hover:not(:disabled) {
    background-color: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  .pagination-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .pagination-count {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    min-width: 3rem;
    text-align: center;
  }

  .pagination-sep {
    opacity: 0.5;
    margin: 0 0.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .pagination-btn {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.theme-section');
  if (section) {
    const pages = section.querySelectorAll<HTMLElement>('.theme-page');
    const nav = section.querySelector<HTMLElement>('.theme-pagination');
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-action="prev"]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-action="next"]');
    const counter = section.querySelector<HTMLElement>('[data-current]');

    if (pages.length > 0 && nav && prevBtn && nextBtn && counter) {
      const total = pages.length;
      const hasOverflow = nav.dataset.hasOverflow === '1';
      const archiveHref = nav.dataset.archiveHref || '/blog';
      let current = 0;

      const render = (idx: number) => {
        pages.forEach((p, i) => {
          p.hidden = i !== idx;
        });
        prevBtn.disabled = idx === 0;
        // Quando ha mais conteudo no arquivo, Proximo da ultima pagina interna leva pro /blog;
        // senao, desabilita ao final.
        nextBtn.disabled = !hasOverflow && idx === total - 1;
        counter.textContent = String(idx + 1);
        current = idx;
      };

      prevBtn.addEventListener('click', () => {
        if (current > 0) render(current - 1);
      });
      nextBtn.addEventListener('click', () => {
        if (current < total - 1) {
          render(current + 1);
        } else if (hasOverflow) {
          window.location.href = archiveHref;
        }
      });
    }
  }
</script>
