---
import { SITE_THESIS } from '../consts';
const lines = SITE_THESIS.split('\n');
---

<section class="manifesto-act" aria-label="Manifesto editorial">
  <div class="manifesto-content">
    <p class="manifesto-eyebrow">Manifesto</p>
    <blockquote class="manifesto-quote">
      {lines.map((line) => (
        <span class="manifesto-line">{line}</span>
      ))}
    </blockquote>
    <p class="manifesto-attr">— Paul Gomes</p>
  </div>
</section>

<style>
  .manifesto-act {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-paper);
    padding: 6rem 1.5rem;
    position: relative;
  }

  .manifesto-content {
    max-width: 1000px;
    width: 100%;
    text-align: center;
  }

  .manifesto-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--color-muted);
    margin: 0 0 2.5rem;
  }

  .manifesto-quote {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 6vw, 5rem);
    color: var(--color-ink);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    quotes: none;
  }

  .manifesto-line {
    display: block;
    opacity: 0;
    transform: translateY(20px);
  }

  .manifesto-act.in-view .manifesto-line {
    animation: line-rise 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .manifesto-act.in-view .manifesto-line:nth-child(1) { animation-delay: 0.1s; }
  .manifesto-act.in-view .manifesto-line:nth-child(2) { animation-delay: 0.35s; }
  .manifesto-act.in-view .manifesto-line:nth-child(3) { animation-delay: 0.6s; }
  .manifesto-act.in-view .manifesto-line:nth-child(4) { animation-delay: 0.85s; }

  @keyframes line-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .manifesto-attr {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 3rem 0 0;
    opacity: 0;
  }

  .manifesto-act.in-view .manifesto-attr {
    animation: line-rise 1s ease 1.1s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-line, .manifesto-attr {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // Intersection Observer pra disparar animação quando entra na viewport
  const sections = document.querySelectorAll('.manifesto-act');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
        }
      });
    },
    { threshold: 0.3 }
  );
  sections.forEach((section) => observer.observe(section));
</script>
