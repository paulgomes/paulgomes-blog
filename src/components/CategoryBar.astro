---
import { CATEGORIAS, CATEGORIA_SLUGS } from '../lib/categorias';

const items = [
  { label: 'Todos', href: '/blog' },
  ...CATEGORIAS.map((c) => ({
    label: c,
    href: `/categoria/${CATEGORIA_SLUGS[c]}/`,
  })),
];

// Duplica a lista pra criar o loop infinito sem corte (translateX -50%).
// A 1a copia sao os links reais; a 2a e decorativa (aria-hidden, fora do tab).
---

<nav class="cat-bar" aria-label="Categorias">
  <div class="cat-marquee">
    <ul class="cat-track">
      {items.map((item) => (
        <li><a href={item.href} class="cat-pill">{item.label}</a></li>
      ))}
      {items.map((item) => (
        <li aria-hidden="true"><a href={item.href} class="cat-pill" tabindex="-1">{item.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .cat-bar {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Trilho com fade nas bordas + clip do conteudo que passa do viewport */
  .cat-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 7%,
      black 93%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 7%,
      black 93%,
      transparent 100%
    );
  }

  .cat-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    /* levemente lento (~40s p/ um ciclo completo), constante e infinito */
    animation: cat-marquee-scroll 40s linear infinite;
    will-change: transform;
  }

  /* Espacamento via margin (nao gap) pra emenda do loop ficar perfeita */
  .cat-track li {
    flex: 0 0 auto;
    margin-right: 0.6rem;
  }

  /* Pausa pra ler/clicar (mouse ou teclado) */
  .cat-marquee:hover .cat-track,
  .cat-marquee:focus-within .cat-track {
    animation-play-state: paused;
  }

  .cat-pill {
    display: inline-block;
    white-space: nowrap;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .cat-pill:hover {
    border-color: #0103F9;
    color: #0103F9;
  }

  :global(.dark) .cat-pill {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
  }

  :global(.dark) .cat-pill:hover {
    border-color: #3d40ff;
    color: #3d40ff;
  }

  @keyframes cat-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Acessibilidade: sem animacao -> faixa estatica e rolavel, sem duplicatas */
  @media (prefers-reduced-motion: reduce) {
    .cat-track {
      animation: none;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 0 1.25rem;
    }
    .cat-track::-webkit-scrollbar {
      display: none;
    }
    .cat-track li[aria-hidden='true'] {
      display: none;
    }
  }
</style>
