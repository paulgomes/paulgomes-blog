---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
---

<header class="border-b" style="border-color: var(--color-border)">
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="font-display text-xl font-bold tracking-tight transition-opacity hover:opacity-60">
      {SITE_TITLE}
    </a>
    <nav class="flex items-center gap-8 text-sm font-medium">
      <HeaderLink href="/">Início</HeaderLink>
      <HeaderLink href="/blog">Ensaios</HeaderLink>
      <HeaderLink href="/about">Sobre</HeaderLink>
      <ThemeToggle />
    </nav>
  </div>
</header>
