---
import { Image } from 'astro:assets';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import HeaderSocial from './HeaderSocial.astro';
import logo from '../assets/brand/logo-paulgomes.webp';
import menuHeader from '../data/menu-header.json';
import { getTopicGroups } from '../lib/topics';

const navItems = menuHeader.items || [];

// Mega menu "Tópicos": grupos temáticos só com categorias que têm conteúdo.
const { groups: topicGroups, total: totalPosts } = await getTopicGroups();
---

<header class="border-b sticky top-0 z-50 backdrop-blur" style="border-color: var(--color-border); background-color: color-mix(in srgb, var(--color-paper) 88%, transparent);">
  <div class="container-wide flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex flex-shrink-0 items-center transition-opacity hover:opacity-70" aria-label="Paul Gomes — Página inicial">
      <Image
        src={logo}
        alt="Paul Gomes"
        width={180}
        height={56}
        class="logo-img h-10 w-auto sm:h-12"
        loading="eager"
      />
    </a>

    <!-- Desktop nav (md+) -->
    <nav class="desktop-nav items-center gap-5 text-sm font-medium">
      <!-- Mega menu Tópicos -->
      <div class="topics-nav" data-topics>
        <button type="button" class="topics-trigger" aria-expanded="false" aria-haspopup="true" data-topics-trigger>
          Tópicos
          <svg class="topics-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
        </button>
        <div class="topics-panel" data-topics-panel>
          <div class="topics-panel-inner container-wide">
            <div class="topics-grid">
              {topicGroups.map((g) => (
                <div class="topics-col">
                  <p class="topics-col-title">{g.title}</p>
                  <ul>
                    {g.items.map((it) => (
                      <li>
                        <a href={it.href} data-topics-link>
                          <span>{it.label}</span>
                          <span class="topics-count">{it.count}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="topics-col topics-cta">
                <p class="topics-col-title">Explorar</p>
                <a href="/blog" class="topics-cta-link" data-topics-link>Todos os insights &rarr;</a>
                <p class="topics-cta-desc">{totalPosts} ensaios sobre IA, SEO, tecnologia e o futuro dos negócios.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {navItems.map((item) => (
        <HeaderLink
          href={item.url}
          target={item.open_new_tab ? '_blank' : undefined}
          rel={item.open_new_tab ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </HeaderLink>
      ))}
      <span class="mx-1 hidden h-5 w-px lg:inline-block" style="background-color: var(--color-border)"></span>
      <HeaderSocial />
      <span class="mx-1 hidden h-5 w-px sm:inline-block" style="background-color: var(--color-border)"></span>
      <ThemeToggle />
    </nav>

    <!-- Hamburger (mobile only) -->
    <button
      type="button"
      class="hamburger"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="mobile-menu"
  aria-hidden="true"
  data-mobile-menu
>
  <div class="mobile-menu-inner">
    <div class="mobile-menu-header">
      <span class="mobile-menu-brand">Paul Gomes</span>
      <button
        type="button"
        class="mobile-menu-close"
        aria-label="Fechar menu"
        data-menu-close
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <nav class="mobile-menu-nav" aria-label="Menu principal">
      {navItems.map((item) => (
        <a
          href={item.url}
          target={item.open_new_tab ? '_blank' : undefined}
          rel={item.open_new_tab ? 'noopener noreferrer' : undefined}
          data-menu-link
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mobile-menu-footer">
      <HeaderSocial />
      <ThemeToggle />
    </div>
  </div>
</div>

<style>
  :global(.dark) .logo-img {
    filter: invert(1);
  }

  /* ==========================================================================
     Desktop nav vs mobile hamburger — controlado por @media scoped
     (Tailwind md:hidden perde pra Astro scoped CSS por specificity)
     ========================================================================== */
  .desktop-nav { display: none; }
  .hamburger {
    position: relative;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .desktop-nav { display: flex; }
    .hamburger { display: none; }
    .mobile-menu { display: none !important; }
  }

  /* ==========================================================================
     Hamburger lines + morph para X
     ========================================================================== */
  .hamburger-line {
    display: block;
    width: 24px;
    height: 1.5px;
    margin: 0 auto;
    background-color: var(--color-ink);
    border-radius: 1px;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease,
      width 0.3s ease;
    transform-origin: center;
  }

  .hamburger[aria-expanded='true'] .hamburger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] .hamburger-line:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .hamburger[aria-expanded='true'] .hamburger-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ==========================================================================
     Mobile menu overlay
     ========================================================================== */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--color-paper) 97%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    display: flex;
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    transition:
      opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-menu-inner {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    height: 100%;
  }

  /* Header do menu (brand + close X) */
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-menu-brand {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .mobile-menu-close {
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    border-radius: 9999px;
    color: var(--color-ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, transform 0.2s ease;
  }
  .mobile-menu-close:hover {
    background-color: var(--color-subtle);
  }
  .mobile-menu-close:active {
    transform: scale(0.94);
  }

  /* Nav stack centralizado */
  .mobile-menu-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem 0;
  }
  .mobile-menu-nav a {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    text-decoration: none;
    opacity: 0;
    transform: translateX(-24px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.2s ease;
  }
  .mobile-menu-nav a:hover,
  .mobile-menu-nav a:focus-visible {
    color: #0103F9;
  }
  .mobile-menu.open .mobile-menu-nav a {
    opacity: 1;
    transform: translateX(0);
  }
  .mobile-menu.open .mobile-menu-nav a:nth-child(1) { transition-delay: 0.08s; }
  .mobile-menu.open .mobile-menu-nav a:nth-child(2) { transition-delay: 0.14s; }
  .mobile-menu.open .mobile-menu-nav a:nth-child(3) { transition-delay: 0.20s; }
  .mobile-menu.open .mobile-menu-nav a:nth-child(4) { transition-delay: 0.26s; }
  .mobile-menu.open .mobile-menu-nav a:nth-child(5) { transition-delay: 0.32s; }

  /* Footer com social + tema */
  .mobile-menu-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.45s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-menu.open .mobile-menu-footer {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.45s;
  }

  /* ==========================================================================
     Mega menu "Tópicos" (desktop) — painel full-width sob o header
     ========================================================================== */
  .topics-nav { position: static; display: inline-flex; }
  .topics-trigger {
    display: inline-flex; align-items: center; gap: 4px;
    font: inherit; font-weight: 500; line-height: 1;
    background: none; border: 0; padding: 0; cursor: pointer;
    color: var(--color-ink); opacity: 0.6;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .topics-trigger:hover { opacity: 1; }
  .topics-nav.is-open .topics-trigger { opacity: 1; color: #0103F9; }
  .topics-chevron { transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
  .topics-nav.is-open .topics-chevron { transform: rotate(180deg); }

  .topics-panel {
    position: absolute; left: 0; right: 0; top: 100%;
    background-color: var(--color-paper);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 30px 60px -30px rgba(1, 3, 249, 0.28), 0 10px 30px -20px rgba(0, 0, 0, 0.22);
    opacity: 0; transform: translateY(-8px);
    pointer-events: none; visibility: hidden;
    transition:
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.28s;
  }
  .topics-nav.is-open .topics-panel {
    opacity: 1; transform: translateY(0);
    pointer-events: auto; visibility: visible;
  }
  .topics-panel-inner { padding: 2.25rem 1.5rem 2.5rem; }
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1.5rem 2rem;
  }
  .topics-col-title {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--color-muted); margin: 0 0 0.85rem;
  }
  .topics-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .topics-col li a {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    text-decoration: none; color: var(--color-ink);
    font-size: 0.95rem; font-weight: 500; padding: 0.35rem 0;
    transition: color 0.15s ease;
  }
  .topics-col li a:hover, .topics-col li a:focus-visible { color: #0103F9; }
  .topics-count {
    font-size: 0.7rem; font-weight: 600; color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    padding: 1px 7px; border-radius: 999px;
  }
  .topics-cta-link { color: #0103F9; font-weight: 600; text-decoration: none; font-size: 0.95rem; }
  .topics-cta-link:hover { text-decoration: underline; }
  .topics-cta-desc { margin: 0.5rem 0 0; font-size: 0.8rem; line-height: 1.5; color: var(--color-muted); }
  :global(.dark) .topics-nav.is-open .topics-trigger,
  :global(.dark) .topics-col li a:hover,
  :global(.dark) .topics-cta-link { color: #3D40FF; }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu-nav a,
    .mobile-menu-footer,
    .hamburger-line,
    .mobile-menu-close,
    .topics-panel,
    .topics-chevron {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const menu = document.querySelector<HTMLDivElement>('[data-mobile-menu]');

  if (toggle && menu) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menu');
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Fechar menu');
      menu.classList.add('open');
      menu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') closeMenu();
      else openMenu();
    });

    closeBtn?.addEventListener('click', closeMenu);

    // Fecha ao clicar em link interno do menu
    menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Fecha com ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });

    // Fecha se viewport crescer pra desktop (evita estado inconsistente)
    const mql = window.matchMedia('(min-width: 768px)');
    mql.addEventListener('change', (e) => {
      if (e.matches && toggle.getAttribute('aria-expanded') === 'true') closeMenu();
    });
  }

  // === Mega menu "Tópicos" ===
  const topicsNav = document.querySelector<HTMLElement>('[data-topics]');
  const topicsTrigger = document.querySelector<HTMLButtonElement>('[data-topics-trigger]');
  if (topicsNav && topicsTrigger) {
    let closeTimer: ReturnType<typeof setTimeout>;
    const openTopics = () => {
      clearTimeout(closeTimer);
      topicsNav.classList.add('is-open');
      topicsTrigger.setAttribute('aria-expanded', 'true');
    };
    const closeTopics = () => {
      topicsNav.classList.remove('is-open');
      topicsTrigger.setAttribute('aria-expanded', 'false');
    };
    // Hover com delay p/ atravessar o vão entre trigger e painel sem fechar.
    topicsNav.addEventListener('mouseenter', openTopics);
    topicsNav.addEventListener('mouseleave', () => {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(closeTopics, 180);
    });
    topicsTrigger.addEventListener('click', () => {
      topicsNav.classList.contains('is-open') ? closeTopics() : openTopics();
    });
    topicsNav.querySelectorAll('[data-topics-link]').forEach((l) => l.addEventListener('click', closeTopics));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTopics(); });
    document.addEventListener('click', (e) => { if (!topicsNav.contains(e.target as Node)) closeTopics(); });
  }
</script>
