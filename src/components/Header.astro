---
import { Image } from 'astro:assets';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import HeaderSocial from './HeaderSocial.astro';
import logo from '../assets/brand/logo-paulgomes.webp';
---

<header class="border-b sticky top-0 z-50 backdrop-blur" style="border-color: var(--color-border); background-color: color-mix(in srgb, var(--color-paper) 88%, transparent);">
  <div class="container-wide flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-center transition-opacity hover:opacity-70" aria-label="Paul Gomes — Página inicial">
      <Image
        src={logo}
        alt="Paul Gomes"
        width={180}
        height={56}
        class="logo-img h-12 w-auto"
        loading="eager"
      />
    </a>

    <nav class="flex items-center gap-7 text-sm font-medium">
      <HeaderLink href="/" class="hidden sm:inline-block">Início</HeaderLink>
      <HeaderLink href="/blog">Ensaios</HeaderLink>
      <HeaderLink href="/about">Sobre</HeaderLink>
      <span class="mx-1 hidden h-5 w-px sm:inline-block" style="background-color: var(--color-border)"></span>
      <HeaderSocial />
      <span class="mx-1 hidden h-5 w-px sm:inline-block" style="background-color: var(--color-border)"></span>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .dark .logo-img {
    filter: invert(1);
  }
</style>
