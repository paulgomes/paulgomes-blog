---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { SITE_AUTHOR } from '../consts';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

// Tempo de leitura aproximado (200 palavras/min) a partir do corpo do post.
function readingTime(body: string | undefined): number {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}

const slides = posts.map((post) => ({
  post,
  href: `/${post.id}/`,
  // Primeira categoria do post; fallback "Insight" pra o badge nunca ficar vazio
  // (espelha o tempo de leitura do outro lado). Categorias reais aparecem
  // automaticamente quando atribuídas pelo painel.
  categoria: post.data.categorias?.[0] ?? 'Insight',
  minutes: readingTime(post.body),
}));

const multiple = slides.length > 1;
---

<div class="carousel" data-carousel data-count={slides.length}>
  <div class="carousel-track" data-track>
    {slides.map(({ post, href, categoria, minutes }) => {
      const { title, description, pubDate, heroImage } = post.data;
      return (
        <a class="slide" href={href} aria-label={`Ler: ${title}`}>
          {heroImage ? (
            typeof heroImage === 'string' ? (
              <img src={heroImage} alt="" width="1280" height="800" loading="lazy" class="slide-bg" />
            ) : (
              <Image src={heroImage} alt="" width={1280} widths={[640, 960, 1280]} class="slide-bg" loading="lazy" />
            )
          ) : (
            <div class="slide-bg slide-bg-fallback" aria-hidden="true"></div>
          )}

          <div class="slide-overlay" aria-hidden="true"></div>

          <span class="slide-badge">{categoria}</span>

          <span class="slide-readtime">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            {minutes} min de leitura
          </span>

          <div class="slide-content">
            <p class="slide-meta">
              <FormattedDate date={pubDate} /><span class="slide-meta-sep"> · </span>Por {SITE_AUTHOR}
            </p>
            <h2 class="slide-title">{title}</h2>
            {description && <p class="slide-excerpt">{description}</p>}
          </div>
        </a>
      );
    })}
  </div>

  {multiple && (
    <>
      <button type="button" class="nav nav-prev" data-prev aria-label="Post anterior">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button type="button" class="nav nav-next" data-next aria-label="Próximo post">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </>
  )}
</div>

<style>
  .carousel {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-ink);
    isolation: isolate;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    min-height: 480px;
    aspect-ratio: 16 / 11;
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .slide:hover .slide-bg {
    transform: scale(1.04);
  }

  .slide-bg-fallback {
    background: linear-gradient(135deg, #1a1a2e 0%, #0a0a1a 50%, #0103f9 200%);
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.1) 45%,
      rgba(0, 0, 0, 0.78) 100%
    );
  }

  .slide-badge,
  .slide-readtime {
    position: absolute;
    top: 1.25rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .slide-badge {
    left: 1.25rem;
  }

  .slide-readtime {
    right: 1.25rem;
  }

  .slide-content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    padding: 2rem 2.25rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .slide-meta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .slide-meta-sep {
    opacity: 0.5;
  }

  .slide-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    margin: 0;
    color: #fff;
    max-width: 90%;
  }

  .slide-excerpt {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 56ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* === SETAS — slim, deslizam a partir da borda do post no hover === */
  .nav {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 38px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: #fff;
    color: #555;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
    will-change: transform, opacity;
  }

  /* Estado escondido: encolhidas contra a borda (esquerda/direita) */
  .nav-prev {
    left: 0.85rem;
    transform: translate(-150%, -50%);
  }

  .nav-next {
    right: 0.85rem;
    transform: translate(150%, -50%);
  }

  /* Hover do carrossel: deslizam pra dentro */
  .carousel:hover .nav-prev,
  .carousel:focus-within .nav-prev,
  .carousel:hover .nav-next,
  .carousel:focus-within .nav-next {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .nav:hover {
    color: #0103f9;
  }

  @media (max-width: 768px) {
    .slide {
      min-height: 420px;
      aspect-ratio: 4 / 5;
    }
    .slide-content {
      padding: 1.5rem 1.5rem 1.75rem;
    }
    /* Touch (sem hover): setas sempre visíveis e já posicionadas */
    .nav {
      width: 36px;
      height: 56px;
    }
    .nav-prev {
      left: 0.6rem;
      opacity: 1;
      transform: translate(0, -50%);
    }
    .nav-next {
      right: 0.6rem;
      opacity: 1;
      transform: translate(0, -50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-bg,
    .nav {
      transition: none;
    }
    .slide:hover .slide-bg {
      transform: none;
    }
  }
</style>

<script>
  (function () {
    const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');
    carousels.forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-track]');
      const prev = carousel.querySelector<HTMLButtonElement>('[data-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
      const count = Number(carousel.dataset.count || '0');
      if (!track || count <= 1) return;

      let index = 0;

      function render() {
        if (!track) return;
        track.style.transform = `translateX(-${index * 100}%)`;
      }

      function go(delta: number) {
        index = (index + delta + count) % count;
        render();
      }

      prev?.addEventListener('click', (e) => {
        e.preventDefault();
        go(-1);
      });
      next?.addEventListener('click', (e) => {
        e.preventDefault();
        go(1);
      });

      // Teclado: setas ← → quando o carrossel está focado
      carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(1);
        }
      });
    });
  })();
</script>
