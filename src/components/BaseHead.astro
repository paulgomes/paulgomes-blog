---
import '../styles/global.css';
import { baseSchemaDocument } from '../lib/schema';
import { HEAD_SNIPPET } from '../consts';
import { DEFAULT_LANG, OG_LOCALE, BCP47, type Alternate, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** Idioma da pagina. Default `pt` — paginas existentes nao mudam. */
  lang?: Lang;
  /**
   * Paginas equivalentes em outros idiomas. Quando vazio (o caso de toda pagina
   * so-PT de hoje), NENHUM hreflang e emitido — evita sinal inconsistente.
   */
  alternates?: Alternate[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
  title,
  description,
  image = '/og-image.png',
  ogType = 'website',
  lang = DEFAULT_LANG,
  alternates = [],
} = Astro.props;
const ogImageURL = new URL(image, Astro.url).toString();

// hreflang so faz sentido com par real (2+ versoes). x-default aponta pro PT,
// que e a fonte de verdade do conteudo.
const hasPair = alternates.length > 1;
const xDefault = alternates.find((a) => a.lang === DEFAULT_LANG);

// Grafo JSON-LD base (WebSite + Organization + Person) — presente em todas as paginas.
const baseSchema = baseSchemaDocument();
// Nota: Cloudflare Web Analytics ja e injetado automaticamente na borda (RUM),
// entao nao ha snippet de analytics aqui de proposito.
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="google-site-verification" content="0FY8vPWeMOMZPUFq8-IQu323gZpIzByhfQpmPQBNb-0" />
{HEAD_SNIPPET && <Fragment set:html={HEAD_SNIPPET} />}

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
{hasPair && alternates.map((alt) => (
  <link rel="alternate" hreflang={BCP47[alt.lang]} href={new URL(alt.path, Astro.site).toString()} />
))}
{hasPair && xDefault && (
  <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, Astro.site).toString()} />
)}
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={title} href={new URL('rss.xml', Astro.site)} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- GEO/AEO metadata (autor + idioma — Open Graph article-specific vive em BlogPost.astro) -->
<meta name="author" content="Paul Gomes" />
<link rel="author" href="https://paulgomes.com.br/sobre" />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={OG_LOCALE[lang]} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
    return 'light';
  })();
  if (theme === 'dark') document.documentElement.classList.add('dark');
  else document.documentElement.classList.remove('dark');
  window.localStorage.setItem('theme', theme);
</script>

<!-- Grafo JSON-LD base: WebSite + Organization + Person (GEO/AEO, em toda pagina) -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(baseSchema)} />
