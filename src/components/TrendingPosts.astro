---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title?: string;
  perPage?: number;
}

const { posts, title = 'Em alta', perPage = 4 } = Astro.props;
const totalPages = Math.max(1, Math.ceil(posts.length / perPage));
const pageIndices = Array.from({ length: totalPages }, (_, i) => i);
---

<section class="trending">
  <div class="container-wide">
    <p class="trending-eyebrow">{title}</p>

    <div class="trending-pages">
      {pageIndices.map((pageIdx) => (
        <div class="trending-grid" data-page={pageIdx} hidden={pageIdx !== 0}>
          {posts.slice(pageIdx * perPage, (pageIdx + 1) * perPage).map((post) => (
            <a href={`/${post.id}/`} class="trending-card" aria-label={`Ler: ${post.data.title}`}>
              <div class="trending-image">
                {post.data.heroImage ? (
                  typeof post.data.heroImage === 'string'
                    ? <img src={post.data.heroImage} alt="" width="800" height="600" loading="lazy" class="trending-img" />
                    : <Image src={post.data.heroImage} alt="" width={800} widths={[400, 600, 800]} class="trending-img" loading="lazy" />
                ) : (
                  <div class="trending-img trending-img-fallback" aria-hidden="true"></div>
                )}
                <div class="trending-hover" aria-hidden="true">
                  <span class="trending-hover-text">Ler →</span>
                </div>
              </div>
              <p class="trending-tag">Insight</p>
              <h3 class="trending-title">{post.data.title}</h3>
              <p class="trending-meta">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </a>
          ))}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .trending {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid var(--color-border);
  }

  .trending-eyebrow {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-ink);
    margin: 0 0 3rem;
  }

  .trending-pages {
    position: relative;
  }

  .trending-grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .trending-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trending-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trending-card {
    display: block;
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .trending-card:hover {
    transform: translateY(-4px);
  }

  .trending-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-subtle);
    margin-bottom: 1.25rem;
    border-radius: 4px;
  }

  .trending-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .trending-img-fallback {
    background: linear-gradient(135deg, var(--color-subtle) 0%, var(--color-border) 100%);
  }

  .trending-card:hover .trending-img {
    transform: scale(1.06);
  }

  .trending-hover {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .trending-card:hover .trending-hover {
    opacity: 1;
  }

  .trending-hover-text {
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .trending-tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink);
    text-align: center;
    margin: 0 0 0.7rem;
  }

  .trending-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-size: 1.1rem;
    margin: 0 0 0.85rem;
    text-align: center;
    color: var(--color-ink);
  }

  .trending-meta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    text-align: center;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .trending-card,
    .trending-img,
    .trending-hover {
      transition: none;
    }
    .trending-card:hover {
      transform: none;
    }
    .trending-card:hover .trending-img {
      transform: none;
    }
  }
</style>
