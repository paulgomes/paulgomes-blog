---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title?: string;
  perPage?: number;
}

const { posts, title = 'Em alta', perPage = 4 } = Astro.props;
const totalPages = Math.max(1, Math.ceil(posts.length / perPage));
const pageIndices = Array.from({ length: totalPages }, (_, i) => i);
---

<section class="trending">
  <div class="container-wide">
    <p class="trending-eyebrow">{title}</p>

    <div class="trending-pages">
      {pageIndices.map((pageIdx) => (
        <div class="trending-grid" data-page={pageIdx} hidden={pageIdx !== 0}>
          {posts.slice(pageIdx * perPage, (pageIdx + 1) * perPage).map((post) => (
            <a href={`/blog/${post.id}/`} class="trending-card" aria-label={`Ler: ${post.data.title}`}>
              <div class="trending-image">
                {post.data.heroImage ? (
                  <Image
                    src={post.data.heroImage}
                    alt=""
                    width={800}
                    widths={[400, 600, 800]}
                    class="trending-img"
                    loading="lazy"
                  />
                ) : (
                  <div class="trending-img trending-img-fallback" aria-hidden="true"></div>
                )}
                <div class="trending-hover" aria-hidden="true">
                  <span class="trending-hover-text">Ler →</span>
                </div>
              </div>
              <p class="trending-tag">Insight</p>
              <h3 class="trending-title">{post.data.title}</h3>
              <p class="trending-meta">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </a>
          ))}
        </div>
      ))}
    </div>

    {totalPages > 1 && (
      <div class="trending-dots" role="tablist" aria-label="Paginação dos insights">
        {pageIndices.map((pageIdx) => (
          <button
            type="button"
            class:list={['trending-dot', { active: pageIdx === 0 }]}
            data-target={pageIdx}
            aria-label={`Página ${pageIdx + 1} de ${totalPages}`}
            aria-current={pageIdx === 0 ? 'page' : 'false'}
          ></button>
        ))}
      </div>
    )}

    <div class="trending-cta-wrap">
      <a href="/blog" class="trending-cta">
        Ver todos os insights
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .trending {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid var(--color-border);
  }

  .trending-eyebrow {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-ink);
    margin: 0 0 3rem;
  }

  .trending-pages {
    position: relative;
  }

  .trending-grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .trending-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trending-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trending-card {
    display: block;
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .trending-card:hover {
    transform: translateY(-4px);
  }

  .trending-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-subtle);
    margin-bottom: 1.25rem;
    border-radius: 4px;
  }

  .trending-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .trending-img-fallback {
    background: linear-gradient(135deg, var(--color-subtle) 0%, var(--color-border) 100%);
  }

  .trending-card:hover .trending-img {
    transform: scale(1.06);
  }

  .trending-hover {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .trending-card:hover .trending-hover {
    opacity: 1;
  }

  .trending-hover-text {
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .trending-tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink);
    text-align: center;
    margin: 0 0 0.7rem;
  }

  .trending-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-size: 1.1rem;
    margin: 0 0 0.85rem;
    text-align: center;
    color: var(--color-ink);
  }

  .trending-meta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    text-align: center;
    margin: 0;
  }

  /* Paginação por dots */
  .trending-dots {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }

  .trending-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: var(--color-border);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .trending-dot:hover {
    background-color: var(--color-muted);
    transform: scale(1.15);
  }

  .trending-dot.active {
    background-color: var(--color-ink);
    transform: scale(1.2);
  }

  /* CTA "Ver todos os insights" */
  .trending-cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .trending-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 2rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .trending-cta:hover {
    background-color: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .trending-card,
    .trending-img,
    .trending-hover,
    .trending-dot,
    .trending-cta {
      transition: none;
    }
    .trending-card:hover,
    .trending-cta:hover {
      transform: none;
    }
    .trending-card:hover .trending-img {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.trending-pages');
  const dotsContainer = document.querySelector<HTMLElement>('.trending-dots');
  if (root && dotsContainer) {
    const pages = root.querySelectorAll<HTMLElement>('.trending-grid');
    const dots = dotsContainer.querySelectorAll<HTMLButtonElement>('.trending-dot');

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.dataset.target ?? '0', 10);
        pages.forEach((p, i) => {
          p.hidden = i !== target;
        });
        dots.forEach((d, i) => {
          const isActive = i === target;
          d.classList.toggle('active', isActive);
          d.setAttribute('aria-current', isActive ? 'page' : 'false');
        });
      });
    });
  }
</script>
