---
import { SITE_TITLE, SOCIAL_LINKEDIN, SOCIAL_EMAIL } from '../consts';
const today = new Date();
---

<footer class="mt-24 border-t py-12" style="border-color: var(--color-border)">
  <div class="container-wide flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-display text-lg font-bold">{SITE_TITLE}</p>
      <p class="mt-1 text-sm" style="color: var(--color-muted)">
        © {today.getFullYear()} — Todos os direitos reservados.
      </p>
    </div>
    <div class="flex items-center gap-6 text-sm">
      <a href={SOCIAL_LINKEDIN} target="_blank" rel="noopener" class="transition-opacity hover:opacity-60">LinkedIn</a>
      <a href={SOCIAL_EMAIL} class="transition-opacity hover:opacity-60">E-mail</a>
      <a href="/rss.xml" class="transition-opacity hover:opacity-60">RSS</a>
    </div>
  </div>
</footer>
