---
import { Image } from 'astro:assets';
import SocialIcons from './SocialIcons.astro';
import signature from '../assets/brand/signature-paul-gomes.webp';
/*
 * Badges oficiais das duas lojas, em pt-BR, baixados das paginas de marketing
 * da Apple e do Google. Sao os assets que as diretrizes exigem: nenhuma das
 * duas aceita botao desenhado por terceiro no lugar, nem alteracao de cor,
 * proporcao ou texto.
 *
 * Ficam como arquivo do projeto, e nao como `hotlink` para os servidores
 * deles: imagem de terceiro num rodape global significa requisicao externa em
 * toda visita do site, e um link que quebra calado se o endereco mudar.
 */
import badgeAppStore from '../assets/brand/badge-app-store-ptbr.svg';
import badgeGooglePlay from '../assets/brand/badge-google-play-ptbr.png';
import menuFooter from '../data/menu-footer.json';
import { getTopicGroups } from '../lib/topics';

// O app existe nas duas lojas.
const APP_URL_IOS = 'https://apps.apple.com/us/app/paul-gomes/id6790929921';
const APP_URL_ANDROID = 'https://play.google.com/store/apps/details?id=br.com.paulgomes.app';

const year = new Date().getFullYear();
// Defesa em profundidade: filtra /privacidade aqui tambem (ja filtrado no sync)
const navItems = (menuFooter.items || []).filter((i) => i.url !== '/privacidade');

// Índice temático (mesma fonte do mega menu): reforça links internos para o Google/IA.
const { groups: topicGroups } = await getTopicGroups();
---

<footer class="mt-24 border-t" style="border-color: var(--color-border)">
  <div class="container-wide py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:items-start">
      <div>
        <p class="font-display text-2xl font-bold leading-tight">Paul Gomes - Thinking Forward</p>
        <p class="mt-3 max-w-xl text-base" style="color: var(--color-muted)">
          Escrevo sobre inteligência artificial, GEO, SEO, arquitetura digital e as transformações que redefinem negócios, marcas e comportamento.
        </p>
        <div class="mt-5">
          <SocialIcons size={22} />
        </div>

      </div>

      {/* Coluna da direita: assinatura e cartão do app.
          O cartão morava na coluna da esquerda, que então crescia para uns
          350px enquanto esta ficava com os 60px da assinatura — e `items-start`
          empurrava a sobra toda para baixo, abrindo um vazio do tamanho da
          diferença. Com o cartão aqui, as duas colunas têm altura parecida e o
          vazio deixa de existir. */}
      <div class="footer-aside">
        <Image
          src={signature}
          alt="Assinatura de Paul Gomes"
          width={180}
          height={60}
          class="signature-img hidden h-auto w-44 opacity-80 lg:block"
        />

        {/* Só os badges. Cada loja pede que o acesso seja feito pelo badge
            dela, e os dois já dizem o que são — o cartão com ícone e texto
            em volta repetia isso e ocupava quatro vezes o espaço. */}
        <div class="footer-lojas">
          <a class="footer-loja" href={APP_URL_IOS} target="_blank" rel="noopener">
            <img
              class="footer-loja-apple"
              src={badgeAppStore.src}
              alt="Baixar na App Store"
              width="120"
              height="40"
              loading="lazy"
            />
          </a>
          <a class="footer-loja" href={APP_URL_ANDROID} target="_blank" rel="noopener">
            <img
              class="footer-loja-google"
              src={badgeGooglePlay.src}
              alt="Disponível no Google Play"
              width="135"
              height="52"
              loading="lazy"
            />
          </a>
        </div>
      </div>
    </div>

    <hr class="my-10 border-0 border-t" style="border-color: var(--color-border)" />

    <!-- Índice temático (links internos por tópico) -->
    <nav class="footer-topics" aria-label="Tópicos do blog">
      {topicGroups.map((g) => (
        <div class="footer-topics-col">
          <p class="footer-topics-title">{g.title}</p>
          <ul>
            {g.items.map((it) => (
              <li><a href={it.href}>{it.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="footer-topics-col">
        <p class="footer-topics-title">Navegar</p>
        <ul>
          <li><a href="/blog">Todos os insights</a></li>
          <li><a href="/ferramentas">Ferramentas</a></li>
          <li><a href="/aprenda">Aprenda</a></li>
          <li><a href="/palestras">Palestras</a></li>
          <li><a href="/sobre">Sobre</a></li>
          <li><a href="/contato">Contato</a></li>
        </ul>
      </div>
    </nav>

    <hr class="my-10 border-0 border-t" style="border-color: var(--color-border)" />

    <div class="flex flex-col items-start gap-4 text-sm md:flex-row md:items-center md:justify-between">
      <nav class="flex flex-wrap gap-6">
        {navItems.map((item) => (
          <a
            href={item.url}
            target={item.open_new_tab ? '_blank' : undefined}
            rel={item.open_new_tab ? 'noopener noreferrer' : undefined}
            class="transition-opacity hover:opacity-60"
          >
            {item.label}
          </a>
        ))}
        <a href="/privacidade" class="transition-opacity hover:opacity-60">Política de Privacidade</a>
        <span style="color: var(--color-muted)">© {year} Paul Gomes</span>
      </nav>
      <!-- Crédito da agência — backlink dofollow (sem rel=nofollow) -->
      <a class="footer__wys" href="https://agenciawys.com.br" target="_blank" rel="noopener" title="Projeto criado pela Agência WYS">
        <span class="footer__wys-label">Projeto criado por</span>
        <span class="footer__wys-logo">
          <img src="/logo-wys.webp" alt="Agência WYS" width="58" height="58" loading="lazy" decoding="async" />
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  :global(.dark) .signature-img {
    filter: invert(1);
  }

  /* Coluna da direita: assinatura e os badges das lojas. */
  .footer-aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .footer-aside { align-items: flex-end; }
  }

  .footer-lojas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-loja {
    display: inline-block;
    line-height: 0;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }
  .footer-loja:hover { opacity: 0.78; }
  .footer-loja:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* Os dois badges precisam de alturas DIFERENTES para parecerem do mesmo
     tamanho, e isso não é ajuste de gosto — é o que os arquivos são.
     O da Apple tem 119,66x40 e nenhuma margem embutida: o desenho ocupa o
     arquivo inteiro. O do Google tem 646x250 com 29px transparentes em cima e
     embaixo, então o desenho ocupa só 192 dos 250. Com os dois em 40px, o do
     Google apareceria com 30,7px de arte contra os 40px do outro.
     52px no arquivo do Google = 40px de arte visível, igualando os dois. */
  .footer-loja-apple {
    height: 40px;
    width: auto;
    /* Declarado porque os atributos width/height do <img> — que existem para
       reservar espaço e evitar salto de layout — gerariam sozinhos 3:1, e o
       arquivo é 119,66x40. Sem isto o badge sai 0,28% esticado, e a Apple não
       permite alterar a proporção. */
    aspect-ratio: 119.66407 / 40;
    display: block;
  }
  .footer-loja-google {
    height: 52px;
    width: auto;
    aspect-ratio: 646 / 250;
    display: block;
    /* A margem transparente do arquivo vira espaço ocupado na linha: os 6px
       negativos devolvem a altura da caixa para os mesmos 40px do outro badge,
       senão o bloco cresce e os dois deixam de alinhar pelo centro. */
    margin-block: -6px;
  }

  /* Os dois badges são pretos e sumiriam no tema escuro. O contorno vai no
     link, e não na imagem: a caixa do <a> já tem a altura da ARTE nos dois
     casos — 40px — porque a margem negativa do Google desconta justamente o
     transparente do arquivo. Posto na imagem, o do Google desenharia um
     retângulo de 52px, maior que o badge. A arte em si não é tocada, que é o
     que as duas lojas exigem. */
  :global(.dark) .footer-loja {
    outline: 1px solid rgb(255 255 255 / 0.22);
    outline-offset: 0;
    border-radius: 7px;
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-loja { transition: none; }
  }

  /* Índice temático (links internos) */
  .footer-topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.75rem 2rem;
  }
  .footer-topics-title {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--color-ink); margin: 0 0 0.7rem;
  }
  .footer-topics-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .footer-topics-col a {
    font-size: 0.875rem; color: var(--color-muted); text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-topics-col a:hover { color: #0103F9; }
  :global(.dark) .footer-topics-col a:hover { color: #3D40FF; }

  /* Selo "Projeto criado por" + logo WYS animado (igual ao baterias-okm).
     O anel girando vem do próprio .webp animado; aqui é só o enquadramento. */
  .footer__wys {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-muted);
    font-size: 0.8rem;
    transition: color 0.2s ease;
  }

  .footer__wys:hover {
    color: var(--color-ink);
  }

  .footer__wys:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .footer__wys-label {
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .footer__wys-logo {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #000;
    border: 1px solid rgba(31, 221, 78, 0.35);
    box-shadow: 0 0 12px rgba(31, 221, 78, 0.25);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .footer__wys:hover .footer__wys-logo {
    border-color: #1fdd4e;
    box-shadow: 0 0 16px rgba(31, 221, 78, 0.5);
  }

  .footer__wys-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
