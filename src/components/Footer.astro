---
import { Image } from 'astro:assets';
import SocialIcons from './SocialIcons.astro';
import signature from '../assets/brand/signature-paul-gomes.webp';
import appIcon from '../assets/brand/app-icon.jpg';
/*
 * Badge oficial da App Store, versao pt-BR, baixada do Marketing Tools da
 * Apple. E o asset que as diretrizes exigem: a Apple nao aceita botao
 * desenhado por terceiro no lugar dele, nem alteracao de cor, proporcao ou
 * texto. Fica aqui como arquivo do projeto, e nao como `hotlink` para o
 * servidor deles, pelo mesmo motivo do icone — requisicao externa em todas as
 * paginas e link que quebra calado se o endereco mudar.
 */
import badgeAppStore from '../assets/brand/badge-app-store-ptbr.svg';
import menuFooter from '../data/menu-footer.json';
import { getTopicGroups } from '../lib/topics';

/*
 * App do blog na App Store.
 *
 * O icone e servido daqui, e nao da URL da Apple: imagem de terceiro no rodape
 * de todas as paginas significa uma requisicao externa em cada visita, e um
 * link que quebra calado no dia em que a Apple trocar o caminho do artwork.
 *
 * Dito que e iPhone e iPad de proposito. Quem usa Android descobriria no toque,
 * depois de sair do site — e um clique perdido que nao volta.
 */
const APP_URL = 'https://apps.apple.com/us/app/paul-gomes/id6790929921';

const year = new Date().getFullYear();
// Defesa em profundidade: filtra /privacidade aqui tambem (ja filtrado no sync)
const navItems = (menuFooter.items || []).filter((i) => i.url !== '/privacidade');

// Índice temático (mesma fonte do mega menu): reforça links internos para o Google/IA.
const { groups: topicGroups } = await getTopicGroups();
---

<footer class="mt-24 border-t" style="border-color: var(--color-border)">
  <div class="container-wide py-16">
    <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-start">
      <div>
        <p class="font-display text-2xl font-bold leading-tight">Paul Gomes - Thinking Forward</p>
        <p class="mt-3 max-w-xl text-base" style="color: var(--color-muted)">
          Escrevo sobre inteligência artificial, GEO, SEO, arquitetura digital e as transformações que redefinem negócios, marcas e comportamento.
        </p>
        <div class="mt-5">
          <SocialIcons size={22} />
        </div>

        <div class="footer-app">
          <Image
            src={appIcon}
            alt="Ícone do app Paul Gomes"
            width={56}
            height={56}
            loading="lazy"
            class="footer-app-icon"
          />
          <div class="footer-app-texto">
            <p class="footer-app-titulo">Leia no app</p>
            <p class="footer-app-sub">Os ensaios do blog num leitor feito para ler. Grátis, para iPhone e iPad.</p>
            {/* O badge e o link: a Apple pede que a loja seja acessada por ele,
                e nao por um botao proprio. Quem usa leitor de tela recebe o
                texto pelo alt, entao o elemento nao precisa de rotulo extra. */}
            <a class="footer-app-badge" href={APP_URL} target="_blank" rel="noopener">
              <img src={badgeAppStore.src} alt="Baixar na App Store" width="120" height="40" loading="lazy" />
            </a>
          </div>
        </div>
      </div>

      <div class="hidden md:block">
        <Image
          src={signature}
          alt="Assinatura de Paul Gomes"
          width={180}
          height={60}
          class="signature-img h-auto w-44 opacity-80"
        />
      </div>
    </div>

    <hr class="my-10 border-0 border-t" style="border-color: var(--color-border)" />

    <!-- Índice temático (links internos por tópico) -->
    <nav class="footer-topics" aria-label="Tópicos do blog">
      {topicGroups.map((g) => (
        <div class="footer-topics-col">
          <p class="footer-topics-title">{g.title}</p>
          <ul>
            {g.items.map((it) => (
              <li><a href={it.href}>{it.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="footer-topics-col">
        <p class="footer-topics-title">Navegar</p>
        <ul>
          <li><a href="/blog">Todos os insights</a></li>
          <li><a href="/ferramentas">Ferramentas</a></li>
          <li><a href="/aprenda">Aprenda</a></li>
          <li><a href="/palestras">Palestras</a></li>
          <li><a href="/sobre">Sobre</a></li>
          <li><a href="/contato">Contato</a></li>
        </ul>
      </div>
    </nav>

    <hr class="my-10 border-0 border-t" style="border-color: var(--color-border)" />

    <div class="flex flex-col items-start gap-4 text-sm md:flex-row md:items-center md:justify-between">
      <nav class="flex flex-wrap gap-6">
        {navItems.map((item) => (
          <a
            href={item.url}
            target={item.open_new_tab ? '_blank' : undefined}
            rel={item.open_new_tab ? 'noopener noreferrer' : undefined}
            class="transition-opacity hover:opacity-60"
          >
            {item.label}
          </a>
        ))}
        <a href="/privacidade" class="transition-opacity hover:opacity-60">Política de Privacidade</a>
        <span style="color: var(--color-muted)">© {year} Paul Gomes</span>
      </nav>
      <!-- Crédito da agência — backlink dofollow (sem rel=nofollow) -->
      <a class="footer__wys" href="https://agenciawys.com.br" target="_blank" rel="noopener" title="Projeto criado pela Agência WYS">
        <span class="footer__wys-label">Projeto criado por</span>
        <span class="footer__wys-logo">
          <img src="/logo-wys.webp" alt="Agência WYS" width="58" height="58" loading="lazy" decoding="async" />
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  :global(.dark) .signature-img {
    filter: invert(1);
  }

  /* Cartão do app. Discreto no repouso e com a borda acendendo no ponteiro:
     ele divide a coluna com a marca e os ícones sociais, e competir com eles
     num rodapé custaria a hierarquia que o bloco já tem. */
  .footer-app {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    max-width: 30rem;
    margin-top: 1.75rem;
    padding: 1rem 1.1rem 1.1rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    color: var(--color-ink);
  }
  /* 22% é o raio que a Apple usa no ícone do iOS; com o quadrado reto o
     cartão parece um banner, e não o app. */
  .footer-app-icon {
    width: 56px;
    height: 56px;
    border-radius: 22%;
    flex-shrink: 0;
  }
  .footer-app-texto { display: flex; flex-direction: column; gap: 0.15rem; }
  .footer-app-titulo { font-weight: 700; font-size: 0.95rem; margin: 0; }
  .footer-app-sub { font-size: 0.8rem; line-height: 1.4; color: var(--color-muted); margin: 0; }

  /* As diretrizes da Apple pedem 40px de altura minima na web e uma margem
     livre de 1/10 da altura em volta — daí os 4px. O badge nao muda de cor
     nem de proporcao: o unico efeito no ponteiro e a opacidade. */
  .footer-app-badge {
    display: inline-block;
    margin-top: 0.7rem;
    padding: 4px;
    margin-left: -4px;
    border-radius: 8px;
    line-height: 0;
    transition: opacity 0.2s ease;
  }
  .footer-app-badge:hover { opacity: 0.78; }
  .footer-app-badge:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* O `aspect-ratio` precisa ser declarado porque os atributos width/height do
     <img> — que existem para reservar o espaço e evitar salto de layout —
     geram sozinhos uma proporção de 3:1, e o arquivo da Apple é 119,66x40.
     Sem esta linha o badge sai 0,28% esticado, e a Apple não permite alterar
     a proporção do asset. */
  .footer-app-badge img {
    height: 40px;
    width: auto;
    aspect-ratio: 119.66407 / 40;
    display: block;
  }
  /* O badge preto some no tema escuro: a borda clara devolve o contorno sem
     tocar nas cores do asset, que a Apple nao deixa alterar. */
  :global(.dark) .footer-app-badge img {
    border-radius: 7px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.22);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-app-badge { transition: none; }
  }

  /* Índice temático (links internos) */
  .footer-topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.75rem 2rem;
  }
  .footer-topics-title {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--color-ink); margin: 0 0 0.7rem;
  }
  .footer-topics-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .footer-topics-col a {
    font-size: 0.875rem; color: var(--color-muted); text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-topics-col a:hover { color: #0103F9; }
  :global(.dark) .footer-topics-col a:hover { color: #3D40FF; }

  /* Selo "Projeto criado por" + logo WYS animado (igual ao baterias-okm).
     O anel girando vem do próprio .webp animado; aqui é só o enquadramento. */
  .footer__wys {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-muted);
    font-size: 0.8rem;
    transition: color 0.2s ease;
  }

  .footer__wys:hover {
    color: var(--color-ink);
  }

  .footer__wys:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .footer__wys-label {
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .footer__wys-logo {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #000;
    border: 1px solid rgba(31, 221, 78, 0.35);
    box-shadow: 0 0 12px rgba(31, 221, 78, 0.25);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .footer__wys:hover .footer__wys-logo {
    border-color: #1fdd4e;
    box-shadow: 0 0 16px rgba(31, 221, 78, 0.5);
  }

  .footer__wys-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
