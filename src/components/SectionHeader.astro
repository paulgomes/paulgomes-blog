---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  hrefLabel?: string;
  /**
   * Nível do heading. Default `h2`, que é o correto quando o componente abre uma
   * SEÇÃO dentro de uma página que já tem seu `h1`. Páginas cujo título principal
   * é este componente — as de categoria — devem passar `h1`, senão a página fica
   * sem heading de primeiro nível.
   */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, description, href, hrefLabel = 'Ver todos →', as: Heading = 'h2' } = Astro.props;
---

<header class="mb-12 flex flex-col items-center gap-4 text-center">
  {eyebrow && (
    <p class="text-xs font-semibold uppercase tracking-[0.3em]" style="color: var(--color-muted)">
      ◆ {eyebrow}
    </p>
  )}
  <Heading class="font-display text-2xl font-bold leading-tight tracking-tight md:text-4xl max-w-2xl">
    {title}
  </Heading>
  {description && (
    <p class="text-base md:text-lg max-w-xl" style="color: var(--color-muted)">
      {description}
    </p>
  )}
  {href && (
    <a href={href} class="mt-2 text-sm underline underline-offset-4 transition-opacity hover:opacity-60">
      {hrefLabel}
    </a>
  )}
</header>
