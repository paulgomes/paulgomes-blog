---
import { BRANDS } from '../consts';

// Duplica a lista pra criar loop infinito sem corte
const doubled = [...BRANDS, ...BRANDS];
---

<section class="marquee-section" style="border-color: var(--color-border)">
  <div class="container-wide pt-6 pb-4 md:pt-8 md:pb-5">
    <p class="text-center text-[0.65rem] font-semibold uppercase tracking-[0.3em]" style="color: var(--color-muted)">
      ◆ Marcas que passaram por aqui
    </p>
  </div>

  <!-- Marquee em scroll horizontal infinito -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {doubled.map((brand) => (
        <span class="marquee-item">{brand}</span>
      ))}
    </div>
  </div>

  <!-- Versão acessível pra leitores de tela -->
  <ul class="sr-only">
    {BRANDS.map((brand) => <li>{brand}</li>)}
  </ul>

  <div class="container-wide pb-6 md:pb-8"></div>
</section>

<style>
  .marquee-section {
    background-color: var(--color-paper);
    overflow: hidden;
  }

  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    /* Janela visível bem centralizada, fade longo nas duas pontas */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 30%,
      black 70%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 30%,
      black 70%,
      transparent 100%
    );
  }

  .marquee-track {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    padding: 0 1.5rem;
    white-space: nowrap;
    animation: marquee-scroll 50s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-muted);
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .marquee-item:hover {
    opacity: 1;
    color: var(--color-ink);
  }

  /* Separador "·" entre marcas */
  .marquee-item:not(:last-child)::after {
    content: '·';
    margin-left: 2.5rem;
    color: var(--color-muted);
    opacity: 0.35;
  }

  @media (max-width: 640px) {
    .marquee {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 20%,
        black 80%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 20%,
        black 80%,
        transparent 100%
      );
    }
    .marquee-item {
      font-size: 0.9rem;
    }
    .marquee-item:not(:last-child)::after {
      margin-left: 1.25rem;
    }
    .marquee-track {
      gap: 1.25rem;
    }
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
