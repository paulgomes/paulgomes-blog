---
import brandsData from '../data/brands.json';

interface Brand {
  name: string;
  url: string | null;
  logo_url?: string | null;
}

const title: string = brandsData.title || 'Marcas que passaram por aqui';
const items: Brand[] = (brandsData.items || []).filter((b) => b && b.name);
// Duplica a lista pra criar loop infinito sem corte
const doubled = [...items, ...items];
// Visibilidade da seção controlada pelo painel (Marcas → olho). Default: visível.
const visible: boolean = (brandsData as { visible?: boolean }).visible !== false;
---

{visible && (
<section class="marquee-section" style="border-color: var(--color-border)">
  <div class="container-wide pt-6 pb-4 md:pt-8 md:pb-5">
    <p class="text-center text-[0.65rem] font-semibold uppercase tracking-[0.3em]" style="color: var(--color-muted)">
      ◆ {title}
    </p>
  </div>

  <!-- Marquee em scroll horizontal infinito -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {doubled.map((brand) => {
        const inner = brand.logo_url
          ? <img src={brand.logo_url} alt={brand.name} class="marquee-logo" loading="lazy" />
          : <span class="marquee-text">{brand.name}</span>;
        return brand.url
          ? <a class="marquee-item marquee-link" href={brand.url} target="_blank" rel="noopener nofollow" aria-label={brand.name}>{inner}</a>
          : <span class="marquee-item" aria-label={brand.name}>{inner}</span>;
      })}
    </div>
  </div>

  <!-- Versão acessível pra leitores de tela -->
  <ul class="sr-only">
    {items.map((brand) => <li>{brand.name}</li>)}
  </ul>

  <div class="container-wide pb-6 md:pb-8"></div>
</section>
)}

<style>
  .marquee-section {
    background-color: var(--color-paper);
    overflow: hidden;
  }

  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 30%,
      black 70%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 30%,
      black 70%,
      transparent 100%
    );
  }

  .marquee-track {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    padding: 0 1.5rem;
    white-space: nowrap;
    animation: marquee-scroll 50s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.6vw, 1.15rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-muted);
    opacity: 0.7;
    transition: opacity 0.3s ease, color 0.3s ease, filter 0.3s ease;
    text-decoration: none;
  }

  .marquee-item:hover {
    opacity: 1;
    color: var(--color-ink);
  }

  .marquee-link:hover .marquee-text {
    color: #0103F9;
  }

  /* Logo: altura constante, mantem proporcao, dessaturado por default */
  .marquee-logo {
    height: clamp(22px, 2.4vw, 32px);
    width: auto;
    display: block;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.75;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }
  .marquee-item:hover .marquee-logo {
    filter: grayscale(0%);
    opacity: 1;
  }
  :global(.dark) .marquee-logo {
    filter: grayscale(100%) brightness(0.95);
  }
  :global(.dark) .marquee-item:hover .marquee-logo {
    filter: grayscale(0%) brightness(1);
  }

  /* Separador "·" entre marcas */
  .marquee-item:not(:last-child)::after {
    content: '·';
    margin-left: 2.5rem;
    color: var(--color-muted);
    opacity: 0.35;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .marquee {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 20%,
        black 80%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 20%,
        black 80%,
        transparent 100%
      );
    }
    .marquee-item {
      font-size: 0.9rem;
    }
    .marquee-item:not(:last-child)::after {
      margin-left: 1.25rem;
    }
    .marquee-track {
      gap: 1.25rem;
    }
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
