---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { SITE_AUTHOR } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, heroImage } = post.data;
const href = `/blog/${post.id}/`;
---

<div class="featured-wrap">
  <div class="container-wide">
    <a href={href} class="featured-banner" aria-label={`Ler ensaio: ${title}`}>
      {heroImage ? (
        <Image
          src={heroImage}
          alt=""
          width={1920}
          widths={[800, 1200, 1920]}
          class="banner-bg"
          loading="lazy"
        />
      ) : (
        <div class="banner-bg banner-bg-fallback" aria-hidden="true"></div>
      )}

      <div class="banner-overlay" aria-hidden="true"></div>

      <div class="banner-content">
        <p class="banner-eyebrow">Em destaque</p>
        <h2 class="banner-title">{title}</h2>
        <p class="banner-meta">
          {SITE_AUTHOR}<span class="meta-sep"> · </span><FormattedDate date={pubDate} />
        </p>
      </div>

      <div class="banner-hover" aria-hidden="true">
        <span class="banner-hover-text">Ler ensaio →</span>
      </div>
    </a>
  </div>
</div>

<style>
  .featured-wrap {
    padding: 3rem 0;
  }

  @media (min-width: 768px) {
    .featured-wrap {
      padding: 4rem 0;
    }
  }

  .featured-banner {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 8;
    width: 100%;
    background-color: var(--color-ink);
    isolation: isolate;
    text-decoration: none;
    color: #fff;
    border-radius: 12px;
  }

  .banner-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .banner-bg-fallback {
    background: linear-gradient(135deg, #1a1a2e 0%, #0a0a1a 50%, #00b4d8 200%);
  }

  .featured-banner:hover .banner-bg {
    transform: scale(1.04);
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.30) 50%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }

  .banner-content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
    gap: 0.85rem;
  }

  .banner-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
  }

  .banner-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-size: clamp(1.6rem, 4vw, 3.2rem);
    margin: 0;
    max-width: 900px;
    color: #fff;
  }

  .banner-meta {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin: 0.4rem 0 0;
  }

  .meta-sep {
    opacity: 0.55;
  }

  /* Hover: overlay escuro com CTA "Ler ensaio →" */
  .banner-hover {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .featured-banner:hover .banner-hover {
    opacity: 1;
  }

  .banner-hover-text {
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .featured-banner {
      aspect-ratio: 4 / 5;
      border-radius: 8px;
    }
    .banner-content {
      padding: 2rem 1.5rem;
      gap: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-bg,
    .banner-hover {
      transition: none;
    }
    .featured-banner:hover .banner-bg {
      transform: none;
    }
  }
</style>
