---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="group grid gap-8 md:grid-cols-2 md:items-center md:gap-12">
  <a href={`/blog/${post.id}/`} class="block overflow-hidden rounded-lg" style="background-color: var(--color-subtle)">
    {post.data.heroImage && (
      <Image
        src={post.data.heroImage}
        alt={post.data.title}
        width={1280}
        height={720}
        class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )}
  </a>
  <div>
    <span class="inline-block text-xs font-semibold uppercase tracking-widest" style="color: var(--color-muted)">
      Em destaque
    </span>
    <h2 class="mt-3 font-display text-3xl font-bold leading-tight md:text-5xl">
      <a href={`/blog/${post.id}/`} class="transition-opacity hover:opacity-60">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-4 text-lg" style="color: var(--color-muted)">
      {post.data.description}
    </p>
    <div class="mt-5 text-sm" style="color: var(--color-muted)">
      <FormattedDate date={post.data.pubDate} />
    </div>
    <a href={`/blog/${post.id}/`} class="mt-6 inline-flex items-center gap-2 text-sm font-medium underline underline-offset-4 transition-opacity hover:opacity-60">
      Ler ensaio
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
