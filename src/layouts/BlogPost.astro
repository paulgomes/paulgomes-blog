---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import CoverFallback from '../components/CoverFallback.astro';
import { Image } from 'astro:assets';
import { SITE_AUTHOR } from '../consts';
import authorPhoto from '../assets/brand/paul-gomes.webp';
import { CATEGORIA_SLUGS, CATEGORIA_COLORS, type Categoria } from '../lib/categorias';
import { breadcrumbList, SCHEMA_ID } from '../lib/schema';
import { SITE_CONFIG } from '../config/site';
import LangSwitcher from '../components/LangSwitcher.astro';
import { DEFAULT_LANG, BCP47, useTranslations, postPath, type Alternate, type Lang } from '../i18n';

type Props = CollectionEntry<'blog'>['data'] & {
  minutes?: number;
  id?: string;
  /** Idioma do post. Default `pt` — as paginas PT atuais nao mudam. */
  lang?: Lang;
  /** Versoes equivalentes em outros idiomas (vazio = post so-PT, sem hreflang). */
  alternates?: Alternate[];
};

const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, categorias = [], minutes, id, lang = DEFAULT_LANG, alternates = [], faq } = Astro.props as Props & { categorias?: Categoria[]; minutes?: number; id?: string };
const heroAlt = heroImageAlt || title;
const t = useTranslations(lang);

// URL canônica absoluta para os botões de compartilhamento.
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;

// === Schema.org Article (GEO/AEO) ===
const heroImageUrl = heroImage
  ? (typeof heroImage === 'string' ? heroImage : new URL(heroImage.src, Astro.site).toString())
  : undefined;
// Capa-fallback gerada (#0203FC + título) para posts sem heroImage — usada como
// imagem OG/social e no schema. Posts COM capa não mudam (continuam usando heroImage).
const ogFallbackUrl = id ? new URL(`/og/${id}.png`, Astro.site).toString() : undefined;
const articleImageUrl = heroImageUrl ?? ogFallbackUrl;
const publishedISO = new Date(pubDate).toISOString();
const modifiedISO = updatedDate ? new Date(updatedDate).toISOString() : publishedISO;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  ...(articleImageUrl
    ? { image: [{ '@type': 'ImageObject', url: articleImageUrl, width: heroImageUrl ? 1280 : 1200, height: heroImageUrl ? 720 : 630, caption: heroAlt }] }
    : {}),
  datePublished: publishedISO,
  dateModified: modifiedISO,
  author: { '@id': SCHEMA_ID.person },
  publisher: { '@id': SCHEMA_ID.organization },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
  ...(categorias.length ? { keywords: categorias.join(', '), articleSection: categorias[0] } : {}),
  inLanguage: BCP47[lang],
  // Numa traducao, o original PT e declarado como a obra-fonte.
  ...(lang !== DEFAULT_LANG && id
    ? { translationOfWork: { '@type': 'Article', '@id': `${SITE_CONFIG.url}${postPath(id, DEFAULT_LANG)}` } }
    : {}),
};

// FAQPage — só quando o post declara `faq` no frontmatter. Emitir a marcação
// vazia ou inferida do corpo seria pior que não emitir: schema que não
// corresponde ao conteúdo visível é violação de diretriz.
const faqSchema = faq && faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: BCP47[lang],
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;

// BreadcrumbList (Home > Blog > Categoria > Post) — navegacao estruturada pro Google.
const cats = categorias as Categoria[];
const breadcrumbSchema = breadcrumbList([
  { name: t('nav.home'), item: `${SITE_CONFIG.url}${lang === DEFAULT_LANG ? '/' : `/${lang}/`}` },
  { name: t('nav.blog'), item: `${SITE_CONFIG.url}${lang === DEFAULT_LANG ? '/blog/' : `/${lang}/`}` },
  ...(cats.length
    ? [{ name: cats[0], item: `${SITE_CONFIG.url}/categoria/${CATEGORIA_SLUGS[cats[0]]}/` }]
    : []),
  { name: title, item: Astro.url.href },
]);
---

<html lang={BCP47[lang]}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage
        ? (typeof heroImage === 'string' ? heroImage : heroImage.src)
        : (id ? `/og/${id}.png` : undefined)}
      ogType="article"
      lang={lang}
      alternates={alternates}
    />

    <!-- Schema.org Article (GEO/AEO) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

    <!-- BreadcrumbList -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- FAQPage (apenas quando o post declara `faq` no frontmatter) -->
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Open Graph article-specific (BaseHead ja emitiu og:type=article via prop) -->
    <meta property="article:published_time" content={publishedISO} />
    <meta property="article:modified_time" content={modifiedISO} />
    <meta property="article:author" content="https://paulgomes.com.br/sobre" />
    {categorias[0] && <meta property="article:section" content={categorias[0]} />}
    {categorias.map((cat) => <meta property="article:tag" content={cat} />)}
  </head>
  <body>
    <Header />
    <main>
      <article>
        <header class="container-prose pt-16 pb-12 md:pt-24">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-muted)">
            <FormattedDate date={pubDate} lang={lang} />
            {minutes && <span class="ml-3">· {minutes} {t('blog.min_de_leitura')}</span>}
            {updatedDate && (
              <span class="ml-3">· {t('blog.atualizado_em')} <FormattedDate date={updatedDate} lang={lang} /></span>
            )}
          </div>
          <LangSwitcher lang={lang} alternates={alternates} />
          <h1 class="mt-4 text-balance font-display text-4xl font-bold leading-[1.15] tracking-[-0.015em] md:text-6xl">
            {title}
          </h1>
          {description && (
            <p class="mt-6 text-xl leading-relaxed" style="color: var(--color-muted)">
              {description}
            </p>
          )}
          <div class="mt-8 flex items-center gap-3 text-sm">
            <Image
              src={authorPhoto}
              alt={SITE_AUTHOR}
              width={48}
              height={48}
              class="h-10 w-10 rounded-full object-cover"
            />
            <div>
              <p class="font-medium">{SITE_AUTHOR}</p>
              <p class="text-xs" style="color: var(--color-muted)">{t('blog.autor')}</p>
            </div>
          </div>
        </header>

        {heroImage ? (
          <div class="container-wide pb-12 md:pb-16">
            <div class="overflow-hidden rounded-lg" style="background-color: var(--color-subtle)">
              {typeof heroImage === 'string'
                ? <img src={heroImage} alt={heroAlt} class="w-full" loading="eager" />
                : <Image src={heroImage} alt={heroAlt} width={1280} height={720} class="w-full" />
              }
            </div>
          </div>
        ) : (
          <div class="container-wide pb-12 md:pb-16">
            <div class="aspect-[16/9] overflow-hidden rounded-lg">
              <CoverFallback title={title} />
            </div>
          </div>
        )}

        <div class="container-prose pb-12">
          <div class="text-lg leading-relaxed [&>p]:mb-6 [&>h2]:font-display [&>h2]:text-3xl [&>h2]:font-bold [&>h2]:mt-12 [&>h2]:mb-4 [&>h3]:font-display [&>h3]:text-2xl [&>h3]:font-bold [&>h3]:mt-10 [&>h3]:mb-4 [&>blockquote]:border-l-2 [&>blockquote]:pl-6 [&>blockquote]:my-8 [&>blockquote]:italic [&>blockquote]:text-xl [&>blockquote]:font-display [&>ul]:mb-6 [&>ul]:pl-6 [&>ol]:mb-6 [&>ol]:pl-6 [&>li]:mb-2 [&>img]:rounded-lg [&>img]:my-8 [&>a]:underline [&>a]:underline-offset-4">
            <slot />
          </div>
        </div>

        <RelatedPosts currentId={id ?? ''} categorias={cats} lang={lang} />

        {categorias.length > 0 && (
          <div class="container-prose pb-12">
            <div class="post-tags">
              <span class="post-tags-label">{t('blog.categorias')}:</span>
              {cats.map((categoria) => (
                <a
                  href={`/categoria/${CATEGORIA_SLUGS[categoria]}/`}
                  class="tag-chip"
                  style={`background:${CATEGORIA_COLORS[categoria].bg};color:${CATEGORIA_COLORS[categoria].fg}`}
                >
                  {categoria}
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="container-prose pb-24">
          <ShareButtons url={shareUrl} title={title} />
        </div>
      </article>
    </main>
    <Footer />

    <style>
      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: center;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
      }
      .post-tags-label {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--color-muted);
        margin-right: 0.25rem;
      }
      .tag-chip {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.9rem;
        border-radius: 9999px;
        font-family: var(--font-sans);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .tag-chip:hover {
        transform: translateY(-1px) scale(1.03);
        box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.2);
      }
    </style>
  </body>
</html>
