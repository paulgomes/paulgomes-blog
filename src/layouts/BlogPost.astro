---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import { SITE_AUTHOR } from '../consts';
import authorPhoto from '../assets/brand/paul-gomes.webp';
import { CATEGORIA_SLUGS, CATEGORIA_COLORS, type Categoria } from '../lib/categorias';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, categorias = [] } = Astro.props as Props & { categorias?: Categoria[] };
---

<html lang="pt-BR">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage
        ? (typeof heroImage === 'string' ? heroImage : heroImage.src)
        : undefined}
    />
  </head>
  <body>
    <Header />
    <main>
      <article>
        <header class="container-prose pt-16 pb-12 md:pt-24">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-muted)">
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span class="ml-3">— atualizado em <FormattedDate date={updatedDate} /></span>
            )}
          </div>
          <h1 class="mt-4 font-display text-4xl font-bold leading-[1.1] md:text-6xl">
            {title}
          </h1>
          {description && (
            <p class="mt-6 text-xl leading-relaxed" style="color: var(--color-muted)">
              {description}
            </p>
          )}
          <div class="mt-8 flex items-center gap-3 text-sm">
            <Image
              src={authorPhoto}
              alt={SITE_AUTHOR}
              width={48}
              height={48}
              class="h-10 w-10 rounded-full object-cover"
            />
            <div>
              <p class="font-medium">{SITE_AUTHOR}</p>
              <p class="text-xs" style="color: var(--color-muted)">Autor</p>
            </div>
          </div>
        </header>

        {heroImage && (
          <div class="container-wide pb-12 md:pb-16">
            <div class="overflow-hidden rounded-lg" style="background-color: var(--color-subtle)">
              {typeof heroImage === 'string'
                ? <img src={heroImage} alt={title} class="w-full" loading="eager" />
                : <Image src={heroImage} alt={title} width={1280} height={720} class="w-full" />
              }
            </div>
          </div>
        )}

        <div class="container-prose pb-12">
          <div class="text-lg leading-relaxed [&>p]:mb-6 [&>h2]:font-display [&>h2]:text-3xl [&>h2]:font-bold [&>h2]:mt-12 [&>h2]:mb-4 [&>h3]:font-display [&>h3]:text-2xl [&>h3]:font-bold [&>h3]:mt-10 [&>h3]:mb-4 [&>blockquote]:border-l-2 [&>blockquote]:pl-6 [&>blockquote]:my-8 [&>blockquote]:italic [&>blockquote]:text-xl [&>blockquote]:font-display [&>ul]:mb-6 [&>ul]:pl-6 [&>ol]:mb-6 [&>ol]:pl-6 [&>li]:mb-2 [&>img]:rounded-lg [&>img]:my-8 [&>a]:underline [&>a]:underline-offset-4">
            <slot />
          </div>
        </div>

        {categorias.length > 0 && (
          <div class="container-prose pb-24">
            <div class="post-tags">
              <span class="post-tags-label">Categorias:</span>
              {categorias.map((categoria) => (
                <a
                  href={`/categoria/${CATEGORIA_SLUGS[categoria]}/`}
                  class="tag-chip"
                  style={`background:${CATEGORIA_COLORS[categoria].bg};color:${CATEGORIA_COLORS[categoria].fg}`}
                >
                  {categoria}
                </a>
              ))}
            </div>
          </div>
        )}
      </article>
    </main>
    <Footer />

    <style>
      .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: center;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
      }
      .post-tags-label {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--color-muted);
        margin-right: 0.25rem;
      }
      .tag-chip {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.9rem;
        border-radius: 9999px;
        font-family: var(--font-sans);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .tag-chip:hover {
        transform: translateY(-1px) scale(1.03);
        box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.2);
      }
    </style>
  </body>
</html>
