---
// ChatGPT Ads Readiness — ferramenta de diagnóstico de aquisição via IA.
//
// Página independente do layout editorial do blog: sem Header/Footer, para que a
// experiência leia como produto e não como post. Mantém BaseHead (canonical,
// JSON-LD base, tema) para não abrir exceção na superfície de SEO do site.
import BaseHead from '../components/BaseHead.astro';
import ReadinessApp from '../components/readiness/ReadinessApp.tsx';
import { SITE_CONFIG } from '../config/site';
import { breadcrumbList, faqPage } from '../lib/schema';
import '../styles/readiness.css';

const title = 'ChatGPT Ads Readiness — diagnóstico gratuito';
const description =
  'Diagnóstico gratuito de prontidão para aquisição via IA: avalia oferta, conversão, mensuração e AI Discoverability, e devolve score, gargalos e roadmap.';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ChatGPT Ads Readiness',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: `${SITE_CONFIG.url}/chatgpt-ads-readiness/`,
  description,
  inLanguage: 'pt-BR',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  provider: {
    '@type': 'Organization',
    name: 'WYS',
    url: 'https://agenciawys.com.br/',
  },
  author: { '@type': 'Person', name: 'Paul Gomes', url: `${SITE_CONFIG.url}/sobre` },
};

const pageUrl = `${SITE_CONFIG.url}/chatgpt-ads-readiness/`;

// Sem Header na página, o breadcrumb é o único sinal de que ela pertence ao
// domínio, e não é uma ferramenta avulsa hospedada em algum canto.
const breadcrumbSchema = breadcrumbList([
  { name: 'Início', item: `${SITE_CONFIG.url}/` },
  { name: 'ChatGPT Ads Readiness', item: pageUrl },
]);

/*
 * O corpo desta página é um aplicativo: quase todo o texto aparece depois que
 * a pessoa começa o diagnóstico, e o que fica no HTML estático são pouco mais
 * de cem palavras. Para um buscador — e para um modelo decidindo o que citar —
 * isso é uma página quase muda.
 *
 * O FAQPage resolve pelo caminho certo: dá pares pergunta-resposta explícitos,
 * cada um autossuficiente o bastante para ser citado sozinho, sem inflar a
 * interface com texto que atrapalharia quem veio usar a ferramenta.
 */
const faqs = [
  {
    q: 'O que é o ChatGPT Ads Readiness?',
    a: 'É um diagnóstico gratuito que avalia se uma empresa está preparada para receber e converter tráfego vindo de sistemas de IA. Ele mede cinco frentes — oferta, conversão, mensuração, estrutura comercial e AI Discoverability — e devolve um score com os gargalos encontrados e um roadmap de prioridades.',
  },
  {
    q: 'O diagnóstico é gratuito e quanto tempo leva?',
    a: 'É gratuito e leva cerca de três minutos, sem compromisso. São perguntas sobre a operação real da empresa: como o site converte hoje, o que já é medido e como o time comercial recebe o contato. O resultado aparece na hora, ao final do questionário.',
  },
  {
    q: 'O que é AI Discoverability?',
    a: 'É a capacidade de uma marca ser encontrada e citada por sistemas de IA quando alguém pergunta sobre o mercado dela. Depende de presença distribuída e consistente entre site, perfis e menções de terceiros — e não do mesmo conjunto de sinais que rege o ranqueamento tradicional em buscadores.',
  },
  {
    q: 'O que o diagnóstico entrega no final?',
    a: 'Um score por dimensão, a lista dos gargalos que mais pesam contra a conversão e um roadmap com o que atacar primeiro. A leitura é de preparação estratégica: ele aponta onde a operação perde oportunidade antes de aumentar investimento em mídia, e não substitui uma auditoria técnica do site.',
  },
  {
    q: 'Para quem esse diagnóstico faz sentido?',
    a: 'Para empresas que já investem ou pretendem investir em aquisição paga e querem saber se a estrutura aguenta o tráfego antes de aumentar a verba. Faz menos sentido para quem ainda não tem oferta definida ou não consegue atender a demanda atual — nesses casos, o gargalo está antes da mídia.',
  },
];

const faqSchema = faqPage(faqs);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <main>
      <a class="rd-home-link" href="/">← paulgomes.com.br</a>
      <ReadinessApp client:load />
    </main>

    <style>
      .rd-home-link {
        position: absolute;
        top: 1.5rem;
        left: 1.5rem;
        z-index: 10;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .rd-home-link:hover {
        color: var(--color-ink);
      }
      @media (max-width: 640px) {
        .rd-home-link {
          position: static;
          display: inline-block;
          padding: 1rem 1.25rem 0;
        }
      }
    </style>
  </body>
</html>
