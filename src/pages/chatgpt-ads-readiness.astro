---
// ChatGPT Ads Readiness — ferramenta de diagnóstico de aquisição via IA.
//
// Página independente do layout editorial do blog: sem Header/Footer, para que a
// experiência leia como produto e não como post. Mantém BaseHead (canonical,
// JSON-LD base, tema) para não abrir exceção na superfície de SEO do site.
import BaseHead from '../components/BaseHead.astro';
import ReadinessApp from '../components/readiness/ReadinessApp.tsx';
import { SITE_CONFIG } from '../config/site';
import '../styles/readiness.css';

const title = 'ChatGPT Ads Readiness — diagnóstico gratuito';
const description =
  'Diagnóstico gratuito de prontidão para aquisição via IA: avalia oferta, conversão, mensuração, estrutura comercial e AI Discoverability, e devolve score, gargalos e roadmap de 90 dias.';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ChatGPT Ads Readiness',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: `${SITE_CONFIG.url}/chatgpt-ads-readiness/`,
  description,
  inLanguage: 'pt-BR',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  provider: {
    '@type': 'Organization',
    name: 'WYS',
    url: 'https://agenciawys.com.br/',
  },
  author: { '@type': 'Person', name: 'Paul Gomes', url: `${SITE_CONFIG.url}/sobre` },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </head>
  <body>
    <main>
      <a class="rd-home-link" href="/">← paulgomes.com.br</a>
      <ReadinessApp client:load />
    </main>

    <style>
      .rd-home-link {
        position: absolute;
        top: 1.5rem;
        left: 1.5rem;
        z-index: 10;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .rd-home-link:hover {
        color: var(--color-ink);
      }
      @media (max-width: 640px) {
        .rd-home-link {
          position: static;
          display: inline-block;
          padding: 1rem 1.25rem 0;
        }
      }
    </style>
  </body>
</html>
