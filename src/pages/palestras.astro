---
/**
 * /palestras — landing page AUTÔNOMA.
 *
 * Não usa <Header> nem <Footer>: é uma peça de conversão, e o menu completo do
 * blog só oferece caminhos para SAIR daqui antes do formulário. No lugar deles,
 * uma barra mínima (marca + um botão) e um rodapé curto.
 *
 * O rodapé curto existe de propósito em vez de "nenhum rodapé": página sem link
 * algum para o resto do domínio vira órfã para o rastreador e perde a ligação
 * com a entidade Paul Gomes construída nas outras páginas — que é o que
 * sustenta a busca por "palestrante de inteligência artificial". Poucos links,
 * escolhidos, resolvem os dois lados. Pelo mesmo motivo entra um BreadcrumbList.
 */
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { SCHEMA_ID, breadcrumbList, faqPage } from '../lib/schema';
import { SITE_CONFIG } from '../config/site';
import videosData from '../data/videos.json';

import brandHero from '../assets/brand/paul-gomes.webp';
import brandCitacao from '../assets/brand/paul-ai.jpeg';
import brandRetrato from '../assets/brand/paul-avatar.png';

/* ========================================================================== *
 * FOTOS
 *
 * A pasta src/assets/palestrante é varrida no build. Quem for trocar as fotos
 * só precisa commitar arquivo lá — nada aqui muda. A convenção de nomes está
 * documentada no README daquela pasta.
 * ========================================================================== */
const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/palestrante/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const fotos = Object.entries(arquivos)
  .map(([caminho, mod]) => {
    const arquivo = caminho.split('/').pop() ?? '';
    return { chave: arquivo.replace(/\.[^.]+$/, '').toLowerCase(), arquivo, src: mod.default };
  })
  .sort((a, b) => a.arquivo.localeCompare(b.arquivo, 'pt-BR'));

const acha = (chave: string) => fotos.find((f) => f.chave === chave)?.src;

const fotoHero = acha('hero') ?? brandHero;
const fotoRetrato = acha('retrato') ?? brandRetrato;
const fotoCitacao = acha('citacao') ?? brandCitacao;

// O `alt` sai do nome do arquivo: é o único dado que descreve a foto e que a
// pessoa que sobe a imagem controla. Documentado no README.
const RESERVADOS = new Set(['hero', 'retrato', 'citacao']);
const galeriaPalco = fotos
  .filter((f) => !RESERVADOS.has(f.chave))
  .map((f) => ({
    src: f.src,
    alt: `Paul Gomes — ${f.chave.replace(/[-_]+/g, ' ')}`,
  }));

/* ========================================================================== *
 * NÚMEROS
 *
 * Os dois derivados do conteúdo (artigos e ano do primeiro texto) são
 * CALCULADOS da coleção de posts, então seguem verdadeiros sozinhos conforme o
 * blog cresce, e qualquer um confere abrindo o /blog.
 * ========================================================================== */
const ANO_FUNDACAO_WYS = 2011;

const posts = await getCollection('blog');
const totalArtigos = posts.length;
const anoPrimeiroTexto = posts.reduce(
  (min, p) => Math.min(min, p.data.pubDate.getFullYear()),
  new Date().getFullYear()
);
const anosDeOperacao = new Date().getFullYear() - ANO_FUNDACAO_WYS;

const evidencias = [
  { valor: `${anosDeOperacao} anos`, label: 'Construindo estratégia digital, dados e IA aplicada dentro de empresas' },
  { valor: `${totalArtigos}`, label: 'Artigos publicados sobre IA, GEO, arquitetura digital e comportamento' },
  { valor: `${anoPrimeiroTexto}`, label: 'Ano da fundação do Grupo WYS e do primeiro texto do arquivo' },
  { valor: 'BrainPilot', label: 'Metodologia proprietária de transformação AI Native' },
];

const marcas = [
  'Disney', 'Senai', 'Grupo Petrópolis', 'Heliar', 'Ihara',
  'Jinko', 'Lufkin', 'Toyo', 'Hummel', 'Toroid',
];

const temas = [
  {
    titulo: 'A internet invisível',
    resumo:
      'A próxima camada da web não será navegada, será interpretada por modelos. O que muda na aquisição, na marca e na receita quando a descoberta deixa de passar pelo clique.',
  },
  {
    titulo: 'GEO: ser encontrado pelos modelos',
    resumo:
      'A disputa por atenção migrou dos buscadores para os sistemas generativos. Como marcas se tornam referência dentro das respostas, e não apenas resultados em uma página.',
  },
  {
    titulo: 'A empresa AI Native',
    resumo:
      'A diferença entre usar IA e operar com IA. Por que projetos isolados não escalam e o que precisa mudar na arquitetura da organização antes da próxima ferramenta entrar.',
  },
  {
    titulo: 'Terceirizando a cognição',
    resumo:
      'A IA está moldando percepção, memória e critério de decisão em silêncio. Uma leitura estratégica sobre dependência cognitiva, dentro e fora da empresa.',
  },
  {
    titulo: 'O futuro dos negócios na era dos agentes',
    resumo:
      'Quando o software deixa de responder e passa a agir, a vantagem competitiva muda de lugar. O que antecipar antes que vire obrigação.',
  },
];

const entregas = [
  {
    titulo: 'Um mapa da mudança real',
    texto:
      'Onde a IA está alterando margem, aquisição e confiança no seu setor, separado do que é apenas ruído de mercado.',
  },
  {
    titulo: 'Uma pergunta que ninguém tinha feito',
    texto:
      'A conversa expõe o ponto cego. Normalmente ele não está na tecnologia, está na forma como a empresa entendeu a tecnologia.',
  },
  {
    titulo: 'Critério para decidir',
    texto:
      'Como distinguir movimento estrutural de modismo antes de comprometer orçamento, time e reputação com a aposta errada.',
  },
];

const formatos = [
  { nome: 'Keynote', desc: 'Abertura ou encerramento de convenções, kickoffs e eventos corporativos.', duracao: '45 min a 1h30' },
  { nome: 'Imersão para liderança', desc: 'Sessão fechada com o time de decisão sobre IA, GEO e arquitetura de transformação.', duracao: '2h a meio período' },
  { nome: 'Painel e mediação', desc: 'Participação em debates sobre o futuro da tecnologia e dos negócios.', duracao: 'Sob demanda' },
];

const territorios = [
  {
    grupo: 'Estratégia e crescimento',
    itens: ['Business Intelligence', 'Growth Strategy', 'SEO', 'GEO', 'AEO', 'PPC'],
  },
  {
    grupo: 'IA empresarial e sistemas agênticos',
    itens: ['Enterprise AI Architecture', 'Agentic AI', 'Multi-Agent Systems', 'LLMOps', 'AI Governance'],
  },
  {
    grupo: 'Transformação AI Native',
    itens: ['Decision Intelligence', 'Cognitive Automation', 'Autonomous Workflows', 'Enterprise Knowledge Systems'],
  },
];

const etapas = [
  {
    titulo: 'Você envia o contexto',
    texto: 'Data, público, formato e o que precisa acontecer com a sala. Três minutos de formulário.',
  },
  {
    titulo: 'Retorno com uma proposta de tema',
    texto:
      'Não um catálogo. Uma recomendação de recorte para o seu público, com formato e disponibilidade. Resposta em até 24 horas úteis.',
  },
  {
    titulo: 'Ajuste fino antes do evento',
    texto: 'Alinhamento com o time organizador para calibrar linguagem, exemplos e profundidade ao setor.',
  },
];

const faq = [
  {
    q: 'Quem contratar para uma palestra sobre inteligência artificial no Brasil?',
    a: 'Depende do que o evento precisa entregar. Para demonstração de ferramentas e entretenimento tecnológico, o mercado tem opções fortes. Para uma leitura estratégica sobre como a IA está mudando descoberta, decisão e arquitetura de empresa, essa é a conversa que eu levo ao palco.',
  },
  {
    q: 'Qual a experiência prática por trás da palestra?',
    a: `${anosDeOperacao} anos à frente do Grupo WYS, projetos com marcas como Disney, Senai e Grupo Petrópolis, atuação como advisor de IA para times executivos e a criação do BrainPilot, metodologia proprietária de transformação AI Native. O conteúdo da palestra vem dessa operação.`,
  },
  {
    q: 'A palestra serve para conselho, diretoria e C-level?',
    a: 'Sim. O recorte é de decisão, não de operação. A discussão trata de risco, posicionamento e prioridade, na linguagem de quem responde por resultado.',
  },
  {
    q: 'Tem demonstração de ferramentas ao vivo?',
    a: 'Não como espetáculo. Ferramentas mudam a cada trimestre. O que a sala leva é o critério para entender o que está mudando por baixo delas, que é o que continua valendo depois do evento.',
  },
  {
    q: 'O conteúdo é adaptado ao setor da empresa?',
    a: 'Sim. Cada palestra é ajustada ao contexto do público, com exemplos do setor e do momento da empresa.',
  },
  {
    q: 'O que é GEO e por que isso aparece na palestra?',
    a: 'GEO é a disciplina de tornar uma marca visível e citável dentro das respostas geradas por sistemas de inteligência artificial. Entra na palestra porque é onde a disputa por atenção está migrando, e a maioria das empresas ainda mede presença digital com a régua anterior.',
  },
  {
    q: 'O que significa uma organização AI Native?',
    a: 'É uma empresa que não usa IA como ferramenta acessória, mas opera com IA integrada à arquitetura de processos, decisão e conhecimento. A diferença aparece na adoção, na governança e no retorno.',
  },
  {
    q: 'A palestra pode virar um trabalho de implementação depois?',
    a: 'Pode. A palestra é uma conversa de leitura estratégica. Quando a empresa decide agir, existe o BrainPilot, conduzido pelo Grupo WYS. São etapas distintas e a segunda nunca é condição da primeira.',
  },
  {
    q: 'Quanto tempo dura?',
    a: 'Keynote de 45 minutos a 1h30. Imersões fechadas de 2 horas a meio período.',
  },
  {
    q: 'Como solicitar uma palestra?',
    a: 'Pelo formulário de contato, com data, público e objetivo do evento. O retorno vem em até 24 horas úteis com tema, formato e disponibilidade.',
  },
];

// Alguns vídeos do canal são recortes diários cujo título é só a data. Numa
// página comercial eles não dizem nada — ficam de fora.
const TITULO_SO_DATA = /^\d{1,2}\s+de\s+[a-zà-ú]+\s+de\s+\d{4}$/i;
const videos = videosData.videos.filter((v) => !TITULO_SO_DATA.test(v.title.trim())).slice(0, 3);

const pageUrl = `${SITE_CONFIG.url}/palestras/`;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'Palestrante de inteligência artificial, GEO e AI Native',
  inLanguage: SITE_CONFIG.locale,
  isPartOf: { '@id': SCHEMA_ID.website },
  about: { '@id': SCHEMA_ID.person },
  primaryImageOfPage: `${SITE_CONFIG.url}${fotoHero.src}`,
  mainEntity: temas.map((tema) => ({
    '@type': 'Event',
    name: tema.titulo,
    description: tema.resumo,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    performer: { '@id': SCHEMA_ID.person },
    organizer: { '@id': SCHEMA_ID.organization },
  })),
};

// Sem menu na página, o breadcrumb é o único sinal de hierarquia que sobra.
const breadcrumbSchema = breadcrumbList([
  { name: 'Início', item: `${SITE_CONFIG.url}/` },
  { name: 'Palestras', item: pageUrl },
]);

// O FAQPage é o formato que sistemas de IA conseguem citar diretamente — é o
// mesmo motivo pelo qual ele existe nos posts (ver src/content.config.ts).
const faqSchema = faqPage(faq.map((f) => ({ q: f.q, a: f.a })));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title="Palestrante de Inteligência Artificial, GEO e AI Native | Paul Gomes"
      description="Palestras sobre inteligência artificial, GEO e transformação AI Native para conselhos, diretorias e eventos corporativos. Quinze anos de operação real, metodologia proprietária e projetos com grandes marcas. Retorno em até 24h."
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <body class="lp">
    <header class="lp-nav">
      <div class="lp-wrap lp-nav-inner">
        <a href="/" class="lp-brand" aria-label="Paul Gomes — página inicial">Paul&nbsp;Gomes</a>
        <!-- Todos os botões vão direto ao formulário. Mandar o visitante rolar
             até outra faixa que só tem OUTRO botão é um clique a mais sem
             informação nova no meio. -->
        <a href="/contato" class="lp-btn lp-btn-sm">Solicitar palestra</a>
      </div>
    </header>

    <main id="conteudo">
      <!-- ===================== 1. HERO ===================== -->
      <section class="lp-hero">
        <div class="lp-wrap lp-hero-grid">
          <div>
            <p class="lp-eyebrow">Palestras sobre inteligência artificial, GEO e transformação AI Native</p>
            <h1 class="lp-h1">Nem toda transformação avisa que começou</h1>
            <p class="lp-lead">
              A inteligência artificial não está mudando apenas as ferramentas que sua empresa usa.
              Está mudando como as pessoas procuram, decidem e confiam. Palestras para lideranças que
              precisam entender esse movimento enquanto ele ainda está em curso, não quando ele já
              virou consenso de mercado.
            </p>
            <div class="lp-hero-actions">
              <a href="/contato" class="lp-btn">Solicitar palestra <span aria-hidden="true">→</span></a>
              <a href="#temas" class="lp-link">Ver os temas</a>
            </div>
          </div>

          <div class="lp-hero-foto">
            <Image
              src={fotoHero}
              alt="Paul Gomes, palestrante de inteligência artificial e GEO"
              widths={[420, 640, 860]}
              sizes="(min-width: 900px) 440px, 80vw"
              loading="eager"
              class="lp-hero-img"
            />
          </div>
        </div>
      </section>

      <!-- ===================== 2. EVIDÊNCIA ===================== -->
      <section class="lp-evidencia" aria-label="Credenciais">
        <div class="lp-wrap lp-evidencia-grid">
          {evidencias.map((e) => (
            <div>
              <p class="lp-evidencia-valor">{e.valor}</p>
              <p class="lp-evidencia-label">{e.label}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ===================== 3. PROVA SOCIAL ===================== -->
      <section class="lp-secao lp-secao-curta">
        <div class="lp-wrap">
          <h2 class="lp-h3">Marcas que já passaram por projetos conduzidos pelo Grupo WYS</h2>
          <ul class="lp-marcas">
            {marcas.map((m) => <li>{m}</li>)}
          </ul>
          <p class="lp-nota lp-nota-italic">
            O que levo ao palco vem de projeto entregue, não de leitura de relatório.
          </p>
        </div>
      </section>

      <!-- ===================== 4. DIAGNÓSTICO ===================== -->
      <section class="lp-secao lp-secao-alt">
        <div class="lp-wrap lp-diagnostico">
          <div>
            <p class="lp-eyebrow lp-eyebrow-dark">Diagnóstico</p>
            <h2 class="lp-h2">A maioria das empresas está implementando IA da forma errada</h2>
            <p class="lp-destaque">Não por falta de investimento. Por falta de arquitetura.</p>
          </div>
          <div class="lp-diagnostico-corpo">
            <p>
              Adotam ferramentas sem estratégia, e cada nova licença vira mais ruído. Automatizam
              tarefas sem redesenhar processos, o que apenas acelera a ineficiência que já existia.
              Contratam plataformas sem governança, e o projeto vira passivo jurídico. Investem em
              tecnologia sem preparar equipes, porque a barreira nunca foi o modelo, foi a cultura.
            </p>
            <p>
              O resultado se repete com uma constância desconfortável: projetos isolados, adoção
              baixa, retorno difuso.
            </p>
            <p>
              Enquanto isso, uma segunda mudança acontece por fora da empresa. A camada de descoberta
              da internet está sendo reescrita. As pessoas pararam de pesquisar e começaram a
              perguntar. A resposta deixou de ser uma lista de links e passou a ser uma síntese
              produzida por um modelo, que decide quem citar e quem ignorar.
            </p>
            <p class="lp-punch">
              Quando a decisão de compra começa dentro de uma resposta gerada, a marca ausente
              daquela resposta não perde a disputa. Ela não entra na disputa.
            </p>
            <p>
              São dois movimentos simultâneos, um dentro e outro fora da organização. Poucas
              lideranças estão olhando para os dois ao mesmo tempo.
            </p>
          </div>
        </div>
      </section>

      <!-- ===================== 5. TEMAS ===================== -->
      <section id="temas" class="lp-secao">
        <div class="lp-wrap">
          <p class="lp-eyebrow lp-eyebrow-dark">Temas</p>
          <h2 class="lp-h2">Cinco conversas que mudam a régua da sala</h2>
          <div class="lp-temas">
            {temas.map((t, i) => (
              <article class="lp-tema">
                <span class="lp-tema-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="lp-tema-titulo">{t.titulo}</h3>
                <p class="lp-tema-resumo">{t.resumo}</p>
              </article>
            ))}
          </div>
          <p class="lp-nota">
            Todo tema é adaptado ao contexto do seu setor, do seu público e do momento da sua empresa.
          </p>
        </div>
      </section>

      <!-- ===================== 6. CITAÇÃO ===================== -->
      <section class="lp-citacao">
        <Image
          src={fotoCitacao}
          alt="Paul Gomes em retrato conceitual sobre inteligência artificial"
          widths={[900, 1400, 1900]}
          sizes="100vw"
          loading="lazy"
          class="lp-citacao-img"
        />
        <div class="lp-citacao-overlay">
          <div class="lp-wrap">
            <blockquote class="lp-citacao-texto">
              A maior mudança da nossa geração não está acontecendo na tela. Está acontecendo na
              forma como decidimos.
            </blockquote>
            <p class="lp-citacao-autor">Paul Gomes</p>
          </div>
        </div>
      </section>

      <!-- ===================== 7. O QUE A SALA LEVA ===================== -->
      <section class="lp-secao lp-secao-alt">
        <div class="lp-wrap">
          <p class="lp-eyebrow lp-eyebrow-dark">O que a sala leva</p>
          <h2 class="lp-h2">Sua liderança sai da palestra com três coisas</h2>
          <div class="lp-entregas">
            {entregas.map((e) => (
              <div class="lp-entrega">
                <h3 class="lp-entrega-titulo">{e.titulo}</h3>
                <p class="lp-entrega-texto">{e.texto}</p>
              </div>
            ))}
          </div>
          <p class="lp-nota lp-nota-forte">
            O objetivo não é entusiasmo. É desconforto produtivo, do tipo que sobrevive à
            segunda-feira.
          </p>
        </div>
      </section>

      <!-- ===================== 8. FORMATOS ===================== -->
      <section class="lp-secao">
        <div class="lp-wrap">
          <p class="lp-eyebrow lp-eyebrow-dark">Formatos</p>
          <h2 class="lp-h2">Do palco de convenção à sala fechada de diretoria</h2>
          <div class="lp-formatos">
            {formatos.map((f) => (
              <div class="lp-formato">
                <h3 class="lp-formato-nome">{f.nome}</h3>
                <p class="lp-formato-desc">{f.desc}</p>
                <p class="lp-formato-duracao">{f.duracao}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== 9. FILTRO DE INTENÇÃO ===================== -->
      <section class="lp-filtro">
        <div class="lp-wrap lp-filtro-grid">
          <div>
            <h2 class="lp-h3 lp-filtro-titulo">Para quem essa palestra foi construída</h2>
            <p>
              Conselhos, diretorias, convenções de liderança, times de marketing e comunicação,
              universidades corporativas e eventos setoriais que já passaram da fase de perguntar se
              a IA é relevante.
            </p>
          </div>
          <div>
            <h2 class="lp-h3 lp-filtro-titulo lp-filtro-titulo-nao">Para quem ela não foi</h2>
            <p>
              Não é treinamento de ferramenta, não é demonstração de gadget no palco e não é conteúdo
              motivacional sobre o futuro. Se o evento precisa de espetáculo, existem ótimos
              profissionais para isso. Aqui a proposta é outra: uma leitura estratégica que a sala
              leva embora.
            </p>
          </div>
        </div>
      </section>

      <!-- ===================== 10. QUEM SOBE NO PALCO ===================== -->
      <section class="lp-secao">
        <div class="lp-wrap lp-sobre">
          <!-- O retrato de fallback é um recorte com fundo transparente. Solto
               na página ele fica boiando no branco; o painel atrás transforma o
               recorte em decisão de layout. -->
          <div class="lp-sobre-foto">
            <Image
              src={fotoRetrato}
              alt="Paul Gomes, fundador e CEO do Grupo WYS"
              widths={[380, 560, 760]}
              sizes="(min-width: 900px) 420px, 80vw"
              loading="lazy"
              class="lp-sobre-img"
            />
          </div>
          <div class="lp-sobre-copy">
            <p class="lp-eyebrow lp-eyebrow-dark">Quem sobe no palco</p>
            <h2 class="lp-h2">Não é teoria de slide. É o que estou construindo agora.</h2>
            <p>
              Fundei o <a href="https://agenciawys.com.br" target="_blank" rel="noopener">Grupo WYS</a>
              em {ANO_FUNDACAO_WYS} e lidero a operação desde então, no cruzamento entre business
              intelligence, growth strategy e inteligência artificial aplicada. Nos últimos anos,
              passei a atuar também como advisor de IA para outras empresas, ajudando times
              executivos a estruturar arquitetura, governança e sistemas agênticos.
            </p>
            <p>
              Criei o BrainPilot, uma metodologia proprietária de diagnóstico, arquitetura e
              implementação de IA empresarial. Ela existe porque a pergunta que chega até mim
              raramente é qual ferramenta usar. É como transformar a IA de acessório isolado em
              capacidade central da organização.
            </p>
            <p>
              Em paralelo, escrevo sobre inteligência artificial, GEO, SEO, arquitetura digital e
              comportamento desde {anoPrimeiroTexto}. São {totalArtigos} artigos publicados que viram
              matéria-prima das palestras.
            </p>
            <p>
              O que levo para o palco não é uma lista de ferramentas. É o que estou testando, errando
              e ajustando com marcas reais enquanto o mercado ainda decide se acredita.
            </p>
            <a href="/sobre" class="lp-link lp-link-dark">Conhecer a trajetória completa</a>
          </div>
        </div>
      </section>

      <!-- ===================== 11. TERRITÓRIOS ===================== -->
      <section class="lp-secao lp-secao-alt">
        <div class="lp-wrap">
          <p class="lp-eyebrow lp-eyebrow-dark">Territórios de domínio</p>
          <h2 class="lp-h2">Onde a conversa tem lastro</h2>
          <div class="lp-territorios">
            {territorios.map((t) => (
              <div class="lp-territorio">
                <h3 class="lp-territorio-titulo">{t.grupo}</h3>
                <ul class="lp-tags">
                  {t.itens.map((i) => <li>{i}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== 12. POSIÇÃO ===================== -->
      <section class="lp-posicao">
        <div class="lp-wrap lp-posicao-inner">
          <h2 class="lp-posicao-titulo">Made by humans.<br />Amplified by AI.</h2>
          <div class="lp-posicao-corpo">
            <p>
              Não acredito em um futuro onde máquinas substituem pessoas. Acredito em um futuro onde
              organizações inteligentes ampliam o potencial humano.
            </p>
            <p>
              Os melhores resultados continuam nascendo da criatividade, da experiência e da
              capacidade humana de decidir. A inteligência artificial existe para acelerar esse
              processo, não para assumir o volante.
            </p>
            <p class="lp-posicao-punch">
              O futuro não será construído por empresas que utilizam IA. Será construído por empresas
              que operam com IA.
            </p>
          </div>
        </div>
      </section>

      <!-- ===================== GALERIA ===================== -->
      {galeriaPalco.length > 0 && (
        <section class="lp-secao">
          <div class="lp-wrap">
            <p class="lp-eyebrow lp-eyebrow-dark">No palco</p>
            <h2 class="lp-h2">Registros dos últimos eventos</h2>
            <div class="lp-galeria">
              {galeriaPalco.map((f) => (
                <figure class="lp-galeria-item">
                  <Image src={f.src} alt={f.alt} widths={[420, 720, 1000]} sizes="(min-width: 900px) 33vw, 50vw" loading="lazy" />
                </figure>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- ===================== 13. VÍDEO ===================== -->
      {videos.length > 0 && (
        <section class="lp-secao lp-secao-alt">
          <div class="lp-wrap">
            <p class="lp-eyebrow lp-eyebrow-dark">Prova em vídeo</p>
            <h2 class="lp-h2">Veja o tom antes de contratar</h2>
            <div class="lp-videos">
              {videos.map((v) => (
                <a href={v.url} target="_blank" rel="noopener noreferrer" class="lp-video">
                  <span class="lp-video-thumb">
                    <img src={v.thumbnail} alt={v.title} width="480" height="360" loading="lazy" decoding="async" />
                    <span class="lp-video-play" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                  </span>
                  <span class="lp-video-titulo">{v.title}</span>
                </a>
              ))}
            </div>
            <a href="/videos" class="lp-link lp-link-dark">Todos os vídeos</a>
          </div>
        </section>
      )}

      <!-- ===================== 14. COMO FUNCIONA ===================== -->
      <section class="lp-secao">
        <div class="lp-wrap">
          <p class="lp-eyebrow lp-eyebrow-dark">Como funciona</p>
          <h2 class="lp-h2">Do primeiro contato ao palco</h2>
          <ol class="lp-etapas">
            {etapas.map((e, i) => (
              <li class="lp-etapa">
                <span class="lp-etapa-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="lp-etapa-titulo">{e.titulo}</h3>
                <p class="lp-etapa-texto">{e.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ===================== 15. FAQ ===================== -->
      <section class="lp-secao lp-secao-alt">
        <div class="lp-wrap lp-faq-wrap">
          <p class="lp-eyebrow lp-eyebrow-dark">Perguntas frequentes</p>
          <h2 class="lp-h2">O que costumam perguntar antes de fechar</h2>
          <!-- <details> nativo: acordeão sem JavaScript, e o texto da resposta
               continua no HTML mesmo fechado — que é o que o rastreador lê. -->
          <div class="lp-faq">
            {faq.map((f) => (
              <details class="lp-faq-item">
                <summary class="lp-faq-q">{f.q}</summary>
                <p class="lp-faq-a">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== 16. CTA FINAL ===================== -->
      <section class="lp-cta">
        <div class="lp-wrap lp-cta-inner">
          <h2 class="lp-cta-titulo">Leve essa conversa para o seu evento</h2>
          <p class="lp-cta-texto">
            Conte o contexto, o público e a data. Retorno com tema, formato e disponibilidade.
          </p>
          <a href="/contato" class="lp-btn lp-btn-inverso">Solicitar palestra <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer class="lp-footer">
      <div class="lp-wrap lp-footer-inner">
        <div>
          <p class="lp-footer-marca">Paul Gomes</p>
          <p class="lp-footer-nota">
            Palestras sobre inteligência artificial, GEO e transformação AI Native.
          </p>
        </div>
        <nav class="lp-footer-nav" aria-label="Links do site">
          <a href="/">Início</a>
          <a href="/sobre">Sobre</a>
          <a href="/blog">Blog</a>
          <a href="/contato">Contato</a>
        </nav>
        <SocialIcons size={20} className="lp-footer-social" />
      </div>
      <div class="lp-wrap lp-footer-base">
        <p>© {new Date().getFullYear()} Paul Gomes · Todos os direitos reservados</p>
        <a href="/privacidade">Privacidade</a>
      </div>
    </footer>
  </body>
</html>

<style>
  /* O hero, as faixas de posição e o CTA são escuros nos dois temas de
     propósito: numa landing a hierarquia visual precisa ser previsível, e não
     seguir a preferência de tema do visitante. */
  .lp {
    --lp-azul: #0103f9;
    --lp-azul-claro: #6063ff;
    --lp-escuro: #07070c;
  }
  :global(.dark) .lp { --lp-azul: #3d40ff; }

  .lp-wrap {
