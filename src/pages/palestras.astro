    font-weight: 600;
    color: var(--color-ink) !important;
  }

  /* ---------- temas ---------- */
  .lp-temas { display: grid; gap: 1.25rem; margin-top: 3rem; }
  @media (min-width: 760px) { .lp-temas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1060px) {
    .lp-temas { grid-template-columns: repeat(6, 1fr); }
    /* Cinco cards em duas fileiras: 3 em cima, 2 embaixo ocupando metade cada.
       Sem isso o quinto card fica sozinho e a fileira parece quebrada. */
    .lp-tema:nth-child(-n + 3) { grid-column: span 2; }
