    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
  }

  /* ---------- botões e links ---------- */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--lp-azul);
