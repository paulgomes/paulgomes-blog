    font-weight: 600;
    font-size: 0.98rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .lp-btn:hover { filter: brightness(1.15); transform: translateY(-1px); }
  .lp-btn-sm { padding: 0.55rem 1.1rem; font-size: 0.85rem; }
  .lp-btn-inverso { background: #fff; color: var(--lp-escuro); }

  .lp-link {
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
