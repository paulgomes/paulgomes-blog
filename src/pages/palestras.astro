---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const temas = [
  {
    titulo: 'A internet invisível',
    resumo: 'A próxima camada da web não será navegada, será interpretada por modelos. O que muda quando a descoberta deixa de passar pelo clique.',
  },
  {
    titulo: 'GEO: ser encontrado pelos modelos',
    resumo: 'A disputa por atenção migrou do Google para os sistemas de IA. Como marcas viram referência dentro das respostas, não só nos resultados.',
  },
  {
    titulo: 'Terceirizando a cognição',
    resumo: 'A IA está moldando decisão, percepção e memória coletiva em silêncio. Uma leitura estratégica sobre dependência cognitiva e comportamento.',
  },
  {
    titulo: 'O futuro dos negócios na era dos agentes',
    resumo: 'Quando o software deixa de responder e passa a agir, a vantagem competitiva muda de lugar. O que antecipar antes que vire consenso.',
  },
];

const formatos = [
  { nome: 'Keynote', desc: 'Palestra de abertura ou encerramento para eventos e convenções.' },
  { nome: 'Imersão para liderança', desc: 'Sessão fechada com o time de decisão sobre IA, GEO e estratégia digital.' },
  { nome: 'Painel e mediação', desc: 'Participação em debates sobre o futuro da tecnologia e dos negócios.' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`Palestras — ${SITE_TITLE}`}
      description="Paul Gomes em palestras sobre inteligência artificial, GEO, o futuro da internet e das empresas. Solicite uma palestra para seu evento ou time de liderança."
    />
  </head>
  <body>
    <Header />

    <main class="container-wide pt-16 pb-24 md:pt-24">
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em]" style="color: #0103F9">Palestras</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tight md:text-6xl">Enxergar o próximo movimento antes que ele seja óbvio</h1>
        <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-muted)">
          Falo sobre as transformações silenciosas que estão redesenhando a internet, os negócios e a forma como as pessoas pensam. Palestras para quem precisa entender a mudança enquanto ela ainda está acontecendo, e não depois.
        </p>
        <a href="/contato" class="cta mt-8 inline-flex items-center gap-2">Solicitar palestra <span aria-hidden="true">&rarr;</span></a>
      </header>

      <!-- Temas -->
      <section class="mt-20">
        <h2 class="font-display text-2xl font-bold md:text-3xl">Temas</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {temas.map((t) => (
            <article class="card">
              <h3 class="font-display text-xl font-bold">{t.titulo}</h3>
              <p class="mt-3 text-base leading-relaxed" style="color: var(--color-muted)">{t.resumo}</p>
            </article>
          ))}
        </div>
        <p class="mt-6 text-sm" style="color: var(--color-muted)">Temas adaptados ao contexto do seu público e do seu setor.</p>
      </section>

      <!-- Formatos -->
      <section class="mt-20">
        <h2 class="font-display text-2xl font-bold md:text-3xl">Formatos</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-3">
          {formatos.map((f) => (
            <div class="card">
              <h3 class="font-display text-lg font-bold">{f.nome}</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-muted)">{f.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="mt-20 rounded-3xl p-10 md:p-14" style="background: color-mix(in srgb, #0103F9 8%, transparent)">
        <h2 class="font-display text-2xl font-bold md:text-3xl">Leve essa conversa para o seu evento</h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed" style="color: var(--color-muted)">
          Conte o contexto, o público e a data. Retorno com tema, formato e disponibilidade.
        </p>
        <a href="/contato" class="cta mt-7 inline-flex items-center gap-2">Solicitar palestra <span aria-hidden="true">&rarr;</span></a>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--color-paper) 60%, transparent);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover { border-color: color-mix(in srgb, #0103F9 40%, var(--color-border)); transform: translateY(-2px); }
  :global(.dark) .card:hover { border-color: color-mix(in srgb, #3D40FF 45%, var(--color-border)); }

  .cta {
    background: #0103F9; color: #fff;
    font-weight: 600; font-size: 0.95rem;
    padding: 0.75rem 1.4rem; border-radius: 999px;
    text-decoration: none;
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .cta:hover { filter: brightness(1.1); transform: translateY(-1px); }
  :global(.dark) .cta { background: #3D40FF; }

  @media (prefers-reduced-motion: reduce) {
    .card, .cta { transition: none; }
    .card:hover, .cta:hover { transform: none; }
  }
</style>
