  }
  .lp-marcas + .lp-nota { margin-top: 1.5rem; }

  /* ---------- diagnóstico ---------- */
  .lp-diagnostico { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) {
    .lp-diagnostico { grid-template-columns: 0.85fr 1fr; gap: 4rem; }
  }
  .lp-destaque {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
