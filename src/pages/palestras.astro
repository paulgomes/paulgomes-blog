  .lp-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    /* Quase opaca: com muita transparência o texto das seções claras atravessa
       a barra e o topo da página fica sujo durante a rolagem. */
    background: color-mix(in srgb, var(--lp-escuro) 96%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .lp-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
