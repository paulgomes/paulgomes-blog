    margin: 1rem 0 0;
  }
  .lp-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 2.7rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.028em;
    margin: 0.9rem 0 0;
    max-width: 24ch;
