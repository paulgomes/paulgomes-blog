    <!-- Barra fixa de ação no celular. A página é longa; sem ela, quem está no
         meio do texto precisa rolar até uma das pontas para agir. Só aparece
         depois que o hero sai da tela, para não competir com o botão de lá. -->
    <div class="lp-acao-movel" id="acaoMovel" hidden>
      <a href="/contato" class="lp-btn lp-btn-bloco">Solicitar palestra <span aria-hidden="true">→</span></a>
    </div>

    <script is:inline>
      (() => {
        const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* ---- entrada dos blocos ----
           Geometria conferida no proprio handler de rolagem, em vez de
           IntersectionObserver. O observador entrega as notificacoes em lote e,
           sob rolagem muito rapida ou restauracao de posicao, chega a pular
           blocos — e um bloco pulado aqui nao e uma animacao perdida, e um
           pedaco da pagina invisivel. Com 33 elementos, a varredura custa nada,
           e a lista so encolhe. */
        let pendentes = [].slice.call(document.querySelectorAll('.reveal'));
        const revelar = (el) => el.classList.add('is-in');

        if (semMovimento) {
          pendentes.forEach(revelar);
          pendentes = [];
        }

        const revelarVisiveis = () => {
          if (!pendentes.length) return;
          const de = document.documentElement;
          // No fim da pagina nao sobra rolagem para revelar o que ficou abaixo
          // do limite. Sem esta saida, um bloco que caia nos ultimos pixels
          // ficaria invisivel para sempre.
          if (de.scrollTop + de.clientHeight >= de.scrollHeight - 4) {
            pendentes.forEach(revelar);
            pendentes = [];
            return;
          }
          const limite = innerHeight * 0.92;
          pendentes = pendentes.filter((el) => {
            if (el.getBoundingClientRect().top > limite) return true;
            revelar(el);
            return false;
          });
        };

        /* ---- parallax da faixa de citacao ----
           O fundo anda mais devagar que a pagina. Entra no mesmo handler de
           rolagem do resto: um segundo listener so disputaria o mesmo quadro.
           Quem pediu menos movimento nao recebe nada e a midia fica parada no
           meio da folga, que e exatamente onde ela ja esta sem `transform`. */
        const faixaCitacao = document.querySelector('.lp-citacao');
        const midiaCitacao = faixaCitacao && faixaCitacao.querySelector('.lp-citacao-midia');
        const folgaParallax = faixaCitacao
          ? parseFloat(getComputedStyle(faixaCitacao).getPropertyValue('--parallax-folga')) || 0
          : 0;
        const temParallax = Boolean(midiaCitacao) && !semMovimento && folgaParallax > 0;
        if (temParallax) faixaCitacao.classList.add('tem-parallax');

        const moverFundo = () => {
          if (!temParallax) return;
          const r = faixaCitacao.getBoundingClientRect();
          // Fora da tela nao ha o que mover, e escrever no style a toa forcaria
          // trabalho de composicao em quadro que ninguem ve.
          if (r.bottom < 0 || r.top > innerHeight) return;
          // -1 com a faixa entrando por baixo, +1 depois que ela saiu por cima.
          // O deslocamento nunca passa da folga, entao a borda da midia nao
          // aparece em nenhum ponto do percurso.
          const meio = r.top + r.height / 2;
          const progresso = (innerHeight / 2 - meio) / ((innerHeight + r.height) / 2);
          midiaCitacao.style.transform =
            `translate3d(0, ${(progresso * folgaParallax).toFixed(1)}px, 0)`;
        };

        /* ---- progresso de leitura + estado da barra ---- */
        const barra = document.getElementById('progressoBarra');
        const nav = document.getElementById('nav');
        let agendado = false;

        const atualizar = () => {
          const de = document.documentElement;
          const total = de.scrollHeight - de.clientHeight;
          const pct = total > 0 ? Math.min(1, de.scrollTop / total) : 0;
          if (barra) barra.style.transform = `scaleX(${pct})`;
          if (nav) nav.classList.toggle('is-rolado', de.scrollTop > 12);
          revelarVisiveis();
          moverFundo();
          agendado = false;
        };

        const agendar = () => {
          if (agendado) return;
          agendado = true;
          requestAnimationFrame(atualizar);
        };

        addEventListener('scroll', agendar, { passive: true });
        addEventListener('resize', agendar, { passive: true });
        atualizar();

        /* ---- video de fundo da citacao ----
           Sem `autoplay` no HTML: o arquivo so comeca a baixar quando a faixa
           chega perto da tela. Numa pagina com 11 mil pixels de altura, baixar
           o video no carregamento e gastar banda de gente que talvez nunca
           role ate la. */
        const video = document.getElementById('videoCitacao');
        const botao = document.getElementById('videoCitacaoBotao');
        if (video && botao) {
          let pausadoPelaPessoa = semMovimento; // quem pediu menos movimento comeca parado
          let carregado = false;

          const marcarEstado = () => {
            const parado = video.paused;
            botao.toggleAttribute('data-parado', parado);
            botao.setAttribute('aria-label', parado ? 'Reproduzir vídeo de fundo' : 'Pausar vídeo de fundo');
          };

          const carregar = () => {
            if (carregado) return;
            carregado = true;
            video.src = video.dataset.src;
          };

          const tocar = () => {
            carregar();
            // play() devolve promessa e pode ser recusado (economia de bateria,
            // politica de midia). Se for, fica o poster e o botao mostra play.
            const p = video.play();
            if (p && p.catch) p.catch(marcarEstado);
          };

          botao.hidden = false;
          marcarEstado();

          botao.addEventListener('click', () => {
            if (video.paused) {
              pausadoPelaPessoa = false;
              tocar();
            } else {
              pausadoPelaPessoa = true;
              video.pause();
            }
            marcarEstado();
          });

          video.addEventListener('play', marcarEstado);
          video.addEventListener('pause', marcarEstado);

          if ('IntersectionObserver' in window) {
            new IntersectionObserver(
              ([e]) => {
                if (pausadoPelaPessoa) return;
                if (e.isIntersecting) tocar();
                else if (carregado) video.pause(); // fora da tela nao precisa gastar CPU
              },
              { rootMargin: '200px 0px' }
            ).observe(video);
          } else if (!semMovimento) {
            tocar();
          }
        }

        /* ---- acao fixa no celular ---- */
        const acao = document.getElementById('acaoMovel');
        const hero = document.querySelector('.lp-hero');
        if (acao && hero) {
          if ('IntersectionObserver' in window) {
            new IntersectionObserver(([e]) => { acao.hidden = e.isIntersecting; }, { threshold: 0 })
              .observe(hero);
          } else {
            // Sem observador, a barra fica sempre disponivel: melhor um botao a
            // mais do que nenhum caminho de acao no meio da pagina.
            acao.hidden = false;
          }
        }
      })();
    </script>
  </body>
</html>

<style>
  /* ==================================================================
     TOKENS
     O hero, a citação, a posição e o CTA fogem do tema claro/escuro de
     propósito: numa landing a hierarquia visual precisa ser previsível,
     e não seguir a preferência de tema do visitante.
     ================================================================== */
  .lp {
    --az: #0103f9;
    --az-claro: #6063ff;
    --tinta: #08080d;
    --tinta-2: #101018;

    /* Escala de espaço: um passo só, usado em toda a página. */
    --s-secao: clamp(4.5rem, 9vw, 8.5rem);
    --s-bloco: clamp(2.5rem, 5vw, 4rem);
  }
  :global(.dark) .lp { --az: #4f52ff; --az-claro: #8f91ff; }

  .lp-wrap {
    margin-inline: auto;
    width: 100%;
    max-width: 1200px;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  /* ---------- acessibilidade ---------- */
  .lp-pular {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 60;
    background: var(--az);
    color: #fff;
    padding: 0.7rem 1.2rem;
    border-radius: 0 0 0.6rem 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: top 0.18s ease;
  }
  .lp-pular:focus { top: 0; }

  /* O projeto não define foco visível em lugar nenhum. Numa página que existe
     para receber contato, navegar por teclado sem ver onde se está é um jeito
     silencioso de perder o lead. */
  .lp :is(a, button, summary):focus-visible {
    outline: 2px solid var(--az-claro);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ---------- entrada ---------- */
  :global(html.js) .reveal { opacity: 0; transform: translateY(22px); }
  :global(html.js) .reveal.is-in {
    opacity: 1;
    transform: none;
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ---------- barra ---------- */
  .lp-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  /* Transparente sobre o hero e sólida depois: o topo da página fica limpo, e
     a barra só ganha peso quando passa a flutuar sobre conteúdo claro. */
  .lp-nav.is-rolado {
    background: color-mix(in srgb, var(--tinta) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: rgb(255 255 255 / 0.1);
  }
  .lp-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }
  .lp-brand {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
  }
  .lp-progresso {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
  }
  .lp-progresso i {
    display: block;
    height: 100%;
    background: var(--az-claro);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* ---------- botões e links ---------- */
  .lp-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--az);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .lp-btn span { transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
  .lp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -12px color-mix(in srgb, var(--az) 75%, transparent);
  }
  .lp-btn:hover span { transform: translateX(4px); }
  .lp-btn-sm { padding: 0.6rem 1.2rem; font-size: 0.84rem; }
  .lp-btn-inverso { background: #fff; color: var(--tinta); }
  .lp-btn-inverso:hover { box-shadow: 0 12px 28px -12px rgb(255 255 255 / 0.4); }
  .lp-btn-bloco { display: flex; justify-content: center; width: 100%; }

  .lp-link {
    position: relative;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    padding-bottom: 3px;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Sublinhado que recolhe e volta pelo outro lado — detalhe pequeno, mas é o
     tipo de coisa que separa "tem link" de "foi desenhado". */
  .lp-link:hover { background-size: 0% 1px; }
  .lp-link-escuro { display: inline-block; margin-top: 2rem; color: var(--az); }

  /* ---------- tipografia ---------- */
  .lp-rotulo {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    line-height: 1.7;
    margin: 0;
    max-width: 44ch;
  }
  .lp-rotulo-claro { color: var(--az-claro); }
  .lp-rotulo-escuro { color: var(--az); }

  .lp-h1 {
    font-size: clamp(2.6rem, 6.6vw, 5.1rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.042em;
    margin: 1.5rem 0 0;
    text-wrap: balance;
  }
  .lp-h2 {
    font-size: clamp(1.85rem, 3.9vw, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.033em;
    margin: 1.1rem 0 0;
    max-width: 20ch;
    text-wrap: balance;
  }
  .lp-h3 {
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0;
  }
  .lp-lead {
    margin: 1.75rem 0 0;
    max-width: 40rem;
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.68;
    color: rgb(255 255 255 / 0.7);
  }
  .lp-cabecalho { margin-bottom: var(--s-bloco); }
  .lp-nota {
    margin: 2.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 58ch;
  }
  .lp-nota-forte { font-size: 1.05rem; font-weight: 600; color: var(--color-ink); }

  /* ---------- hero ---------- */
  .lp-hero {
    position: relative;
    overflow: hidden;
    background: var(--tinta);
    color: #fff;
    /* A barra é sticky e transparente no topo; o padding negativo puxa o hero
       para trás dela em vez de deixar uma faixa vazia. */
    margin-top: -4.4rem;
    padding-top: 4.4rem;
  }
  .lp-hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: -25%;
    width: 62vw;
    height: 115%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--az) 62%, transparent), transparent 72%);
    opacity: 0.42;
    pointer-events: none;
  }
  .lp-hero-grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(3rem, 5vw, 5rem);
  }
  @media (min-width: 1000px) {
    .lp-hero-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
  }
  .lp-hero-acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }

  .lp-hero-figura { position: relative; margin: 0; }
  /* Moldura deslocada: a foto ganha profundidade sem precisar de sombra, que
     ficaria invisível sobre preto. */
  .lp-hero-figura::before {
    content: '';
    position: absolute;
    inset: 1.5rem -1.5rem -1.5rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 1.5rem;
    pointer-events: none;
  }
  /* Proporcao fixa em vez de herdada do arquivo. A foto do hero e trocavel (basta
     commitar `hero.*` em src/assets/palestrante), e sem isto o tamanho do bloco
     inteiro passaria a depender do formato do arquivo que alguem subiu: um
     retrato em pe deixa a coluna gigante, uma foto deitada deixa o hero raso e
     desequilibrado ao lado do texto. Com `cover`, qualquer formato serve.

     `object-position` puxa o corte para a metade de cima, que e onde o rosto
     fica na maioria dos enquadramentos. Se a foto nova ficar cortada errada, e
     este numero que se ajusta. */
  .lp-hero-img {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 28%;
    border-radius: 1.5rem;
    filter: saturate(1.04) contrast(1.03);
  }

  /* ---------- evidência ---------- */
  .lp-evidencias {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 1.5rem;
    margin: 0;
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  @media (min-width: 880px) { .lp-evidencias { grid-template-columns: repeat(4, 1fr); gap: 2rem; } }
  .lp-evidencia { position: relative; }
  /* Filete vertical entre colunas, no lugar de caixas: separa sem desenhar. */
  @media (min-width: 880px) {
    .lp-evidencia + .lp-evidencia { padding-left: 2rem; }
    .lp-evidencia + .lp-evidencia::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.35rem;
      bottom: 0.35rem;
      width: 1px;
      background: rgb(255 255 255 / 0.12);
    }
  }
  .lp-evidencia-valor {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: clamp(1.9rem, 3.5vw, 2.7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .lp-evidencia-sufixo {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--az-claro);
  }
  .lp-evidencia-label {
    margin: 0.75rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.6);
    max-width: 26ch;
  }

  /* ---------- seções ---------- */
  .lp-secao { padding-block: var(--s-secao); }
  .lp-secao-alt { background: var(--color-subtle); }
  /* O alvo de âncora precisa parar ABAIXO da barra fixa, senão o título fica
     escondido atrás dela. */
  [id] { scroll-margin-top: 5.5rem; }

  /* ---------- marcas ---------- */
  .lp-marcas-secao { padding-block: clamp(3rem, 5vw, 4.5rem); }
  /* Rotulo longo: com 0.26em de tracking, 44ch quebra em tres linhas. */
  .lp-marcas-secao .lp-rotulo { max-width: 68ch; }
  .lp-marcas {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 2.25rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Nomes soltos e espaçados leem como lista de clientes; dentro de pílulas,
     leem como filtro de e-commerce. */
  .lp-marcas li {
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    opacity: 0.78;
    transition: opacity 0.2s ease;
  }
  .lp-marcas li:hover { opacity: 1; }
  .lp-marcas-nota {
    margin: 2rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-muted);
  }

  /* ---------- diagnóstico ---------- */
  .lp-diag { display: grid; gap: var(--s-bloco); }
  @media (min-width: 980px) {
    .lp-diag { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
    .lp-diag-titulo { position: sticky; top: 7rem; }
  }
  .lp-destaque {
    margin: 1.75rem 0 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--az);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .lp-diag-corpo p {
    margin: 0 0 1.4rem;
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    line-height: 1.8;
    color: var(--color-muted);
  }
  .lp-diag-corpo p:last-child { margin-bottom: 0; }
  .lp-punch {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem) !important;
    font-weight: 700;
    line-height: 1.45 !important;
    letter-spacing: -0.02em;
    color: var(--color-ink) !important;
    padding-block: 0.5rem;
  }

  /* ---------- temas ---------- */
  .lp-temas {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .lp-tema {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.3s ease;
  }
  @media (min-width: 860px) {
    .lp-tema { grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; }
  }
  .lp-tema:hover { background: color-mix(in srgb, var(--az) 3.5%, transparent); }
  .lp-tema-num {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 2;
    color: color-mix(in srgb, var(--az) 55%, transparent);
    transition: color 0.3s ease;
  }
  .lp-tema:hover .lp-tema-num { color: var(--az); }
  .lp-tema-titulo {
    font-size: clamp(1.2rem, 2.1vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }
  .lp-tema-resumo {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ---------- citação ---------- */
  /* Altura fixa em vez de derivada da proporcao do arquivo: assim a faixa nao
     muda de tamanho quando a midia troca de imagem para video, e nao ha salto
     de layout enquanto ela carrega. Ela mora aqui, e nao na midia, porque com
     o parallax a midia e de proposito mais alta que a faixa — quem define o
     recorte visivel passa a ser o `overflow` deste bloco. */
  .lp-citacao {
    position: relative;
    background: var(--tinta);
    isolation: isolate;
    overflow: hidden;
    height: clamp(380px, 52vw, 660px);
    /* Folga que a midia tem para deslizar sem descobrir a borda. O script le
       este mesmo valor, entao os dois lados nao saem de sincronia. */
    --parallax-folga: 70px;
  }
  .lp-citacao-midia {
    position: absolute;
    left: 0;
    top: calc(-1 * var(--parallax-folga));
    width: 100%;
    height: calc(100% + 2 * var(--parallax-folga));
    object-fit: cover;
    object-position: 30% 40%;
    display: block;
    background: var(--tinta);
  }
  /* So quando o parallax esta de fato ativo: `will-change` custa memoria de
     video, e sem movimento nao ha o que prometer ao compositor. */
  .lp-citacao.tem-parallax .lp-citacao-midia { will-change: transform; }

  .lp-citacao-botao {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: clamp(1.5rem, 4vw, 3rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: rgb(8 8 13 / 0.5);
    backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  .lp-citacao-botao:hover,
  .lp-citacao-botao:focus-visible { opacity: 1; border-color: rgb(255 255 255 / 0.6); }
  .lp-citacao-botao[hidden] { display: none; }
  /* Um icone so no SVG: mostra as duas barras quando esta tocando e o
     triangulo quando esta parado. */
  .lp-icone-play { display: none; }
  .lp-citacao-botao[data-parado] .lp-icone-play { display: block; }
  .lp-citacao-botao[data-parado] .lp-icone-pausa { display: none; }
  .lp-citacao-overlay {
    position: absolute;
    inset: 0;
    /* O overlay cobre a faixa inteira; sem isto ele engoliria o clique do
       botao de pausa que fica embaixo dele. */
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    background: linear-gradient(to top, rgb(8 8 13 / 0.94) 10%, rgb(8 8 13 / 0.2) 58%, transparent);
  }
  .lp-citacao-texto {
    font-size: clamp(1.4rem, 3.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #fff;
    max-width: 22ch;
    margin: 0;
    border: 0;
    padding: 0;
    text-wrap: balance;
  }
  .lp-citacao-autor {
    margin: 1.25rem 0 0;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    color: var(--az-claro);
  }

  /* ---------- entregas ---------- */
  .lp-entregas { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 840px) { .lp-entregas { grid-template-columns: repeat(3, 1fr); } }
  .lp-entrega { padding-top: 1.5rem; border-top: 2px solid var(--color-ink); }
  .lp-entrega-num {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--az);
  }
  .lp-entrega-titulo {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0.9rem 0 0;
  }
  .lp-entrega-texto {
    margin: 0.85rem 0 0;
    font-size: 0.96rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ---------- formatos ---------- */
  .lp-formatos { display: grid; gap: 1.25rem; }
  @media (min-width: 840px) { .lp-formatos { grid-template-columns: repeat(3, 1fr); } }
  .lp-formato {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    transition: border-color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lp-formato:hover {
    border-color: color-mix(in srgb, var(--az) 40%, var(--color-border));
    transform: translateY(-4px);
  }
  .lp-formato-nome {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .lp-formato-desc {
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-muted);
    flex: 1;
  }
  .lp-formato-duracao {
    margin: 1.75rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--az);
  }

  /* ---------- filtro de intenção ---------- */
  .lp-filtro { display: grid; gap: var(--s-bloco); }
  @media (min-width: 860px) {
    .lp-filtro { grid-template-columns: repeat(2, 1fr); gap: clamp(3rem, 6vw, 5rem); }
  }
  .lp-filtro-col { padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .lp-filtro-marca {
    margin: 0 0 1.25rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    color: var(--color-muted);
  }
  .lp-filtro-marca-sim { color: var(--az); }
  .lp-filtro-col p:last-child {
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  /* ---------- sobre ---------- */
  .lp-sobre { display: grid; gap: var(--s-bloco); align-items: center; }
  @media (min-width: 960px) {
    .lp-sobre { grid-template-columns: 440px minmax(0, 1fr); gap: clamp(3rem, 6vw, 5rem); }
  }
  .lp-sobre-foto {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 1.5rem;
    /* Gradiente com cor de verdade: com o painel quase branco, o recorte
       (que tambem e claro nas bordas) simplesmente desaparecia dentro dele. */
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--az) 26%, var(--color-paper)),
      color-mix(in srgb, var(--az) 7%, var(--color-paper))
    );
  }
  .lp-sobre-img {
    /* Mais largo que o painel e ancorado embaixo: o recorte "senta" na base em
       vez de flutuar no meio, que é o que denuncia um PNG sem fundo. */
    width: 122%;
    max-width: none;
    height: auto;
    display: block;
  }
  .lp-sobre-copy p {
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .lp-sobre-copy p:first-of-type { margin-top: 1.75rem; }
  .lp-sobre-copy a { color: var(--az); }

  /* ---------- territórios ---------- */
  .lp-territorios { display: grid; gap: 2.5rem; }
  @media (min-width: 880px) { .lp-territorios { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }
  .lp-territorio-titulo {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .lp-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .lp-tags li {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--az) 22%, transparent);
    color: var(--az);
  }

  /* ---------- posição ---------- */
  .lp-posicao {
    background: var(--az);
    color: #fff;
    background-image: radial-gradient(90% 120% at 88% 0%, rgb(255 255 255 / 0.16), transparent 60%);
  }
  .lp-posicao-inner { display: grid; gap: var(--s-bloco); padding-block: var(--s-secao); }
  @media (min-width: 940px) {
    .lp-posicao-inner { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); gap: clamp(3rem, 6vw, 5rem); }
  }
  .lp-posicao-titulo {
    font-size: clamp(2rem, 4.6vw, 3.3rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .lp-posicao-corpo p {
    margin: 0 0 1.25rem;
    font-size: 1.02rem;
    line-height: 1.75;
    color: rgb(255 255 255 / 0.84);
  }
  .lp-posicao-punch {
    margin: 2rem 0 0 !important;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.28);
    font-size: 1.2rem !important;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff !important;
  }

  /* ---------- galeria ---------- */
  .lp-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .lp-galeria { grid-template-columns: repeat(3, 1fr); } }
  .lp-galeria-item { margin: 0; overflow: hidden; border-radius: 1rem; }
  .lp-galeria-item :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lp-galeria-item:hover :global(img) { transform: scale(1.04); }

  /* ---------- etapas ---------- */
  .lp-etapas { display: grid; gap: 2.5rem 2rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 880px) { .lp-etapas { grid-template-columns: repeat(3, 1fr); } }
  .lp-etapa { position: relative; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .lp-etapa-num {
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: color-mix(in srgb, var(--az) 20%, transparent);
  }
  .lp-etapa-titulo {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 1rem 0 0;
  }
  .lp-etapa-texto {
    margin: 0.8rem 0 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ---------- FAQ ---------- */
  .lp-faq-wrap { max-width: 900px; }
  .lp-faq { border-top: 1px solid var(--color-border); }
  .lp-faq-item { border-bottom: 1px solid var(--color-border); }
  .lp-faq-q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    cursor: pointer;
    list-style: none;
    padding: 1.5rem 0;
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.4;
    transition: color 0.2s ease;
  }
  .lp-faq-q:hover { color: var(--az); }
  .lp-faq-q::-webkit-details-marker { display: none; }
  /* Sinal de abre/fecha desenhado em CSS: um ícone a mais no HTML por pergunta
     seria só ruído para leitor de tela, que já anuncia o estado do <details>. */
  .lp-faq-q::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    margin-top: 0.45rem;
    border-right: 2px solid var(--az);
    border-bottom: 2px solid var(--az);
    transform: rotate(45deg);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lp-faq-item[open] .lp-faq-q::after { transform: rotate(-135deg); margin-top: 0.8rem; }

  .lp-faq-a {
    display: grid;
    grid-template-rows: 1fr;
    padding-bottom: 1.75rem;
  }
  .lp-faq-a p {
    margin: 0;
    max-width: 70ch;
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  /* ---------- CTA ---------- */
  .lp-cta {
    background: var(--tinta);
    color: #fff;
    background-image: radial-gradient(70% 120% at 50% 100%, color-mix(in srgb, var(--az) 40%, transparent), transparent 65%);
  }
  .lp-cta-inner { padding-block: var(--s-secao); text-align: center; }
  .lp-cta-inner .lp-rotulo { margin-inline: auto; }
  .lp-cta-titulo {
    font-size: clamp(2rem, 4.8vw, 3.4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.038em;
    margin: 1.25rem auto 0;
    max-width: 16ch;
    text-wrap: balance;
  }
  .lp-cta-texto {
    margin: 1.5rem auto 0;
    max-width: 44ch;
    font-size: 1.02rem;
    line-height: 1.7;
