    transition: border-color 0.2s ease;
  }
  .lp-link:hover { border-color: #fff; }
  .lp-link-dark {
    display: inline-block;
    margin-top: 1.75rem;
    color: var(--lp-azul);
    border-color: color-mix(in srgb, var(--lp-azul) 40%, transparent);
  }
  .lp-link-dark:hover { border-color: var(--lp-azul); }

  /* ---------- tipografia comum ---------- */
  .lp-eyebrow {
    font-size: 0.72rem;
