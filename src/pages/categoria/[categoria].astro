---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIAS, CATEGORIA_SLUGS, type Categoria } from '../../lib/categorias';
import { breadcrumbList } from '../../lib/schema';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return CATEGORIAS.map((categoria) => {
    const slug = CATEGORIA_SLUGS[categoria];
    const posts = allPosts
      .filter((p) => (p.data.categorias || []).includes(categoria))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { categoria: slug },
      props: { categoria, posts },
    };
  });
}

const { categoria, posts } = Astro.props as { categoria: Categoria; posts: Awaited<ReturnType<typeof getCollection<'blog'>>> };
const count = posts.length;
const description = `${count} ${count === 1 ? 'ensaio' : 'ensaios'} sobre ${categoria}`;

const breadcrumbSchema = breadcrumbList([
  { name: 'Home', item: 'https://paulgomes.com.br/' },
  { name: 'Blog', item: 'https://paulgomes.com.br/blog/' },
  { name: categoria, item: Astro.url.href },
]);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`${categoria} — ${SITE_TITLE}`} description={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body>
    <Header />
    <main>
      <section class="container-wide pt-16 pb-12 md:pt-24">
        <SectionHeader
          eyebrow="Categoria"
          title={categoria}
          description={description}
          href="/blog"
          hrefLabel="Ver todos →"
        />
      </section>

      {count > 0 ? (
        <section class="container-wide pb-24 border-t" style="border-color: var(--color-border)">
          <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3 pt-12">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ) : (
        <section class="container-wide pb-24">
          <p class="text-center text-lg" style="color: var(--color-muted)">
            Nenhum ensaio nessa categoria ainda. <a href="/blog" class="underline underline-offset-4">Ver todos os ensaios →</a>
          </p>
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>
