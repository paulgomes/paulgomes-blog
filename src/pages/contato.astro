---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SOCIAL } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Contato — ${SITE_TITLE}`} description="Entre em contato com Paul Gomes." />
  </head>
  <body>
    <Header />
    <main>
      <section class="container-prose pt-16 pb-24 md:pt-24">
        <h1 class="font-display text-5xl font-bold tracking-tight md:text-6xl">Contato</h1>
        <div class="mt-10 space-y-6 text-lg leading-relaxed">
          <p>Para conversar sobre projetos, parcerias, palestras ou apenas trocar ideias, mande uma mensagem:</p>
        </div>

        <form id="contactForm" class="contact-form" novalidate>
          <!-- Honeypot anti-spam: oculto pra humanos, atraente pra bots. -->
          <div class="hp" aria-hidden="true">
            <label>Não preencha este campo
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="contact-row">
            <label class="contact-field">
              <span>Nome</span>
              <input type="text" name="name" required minlength="2" maxlength="100"
                pattern="^(?=.*\p{L}).{2,100}$" placeholder="Seu nome" autocomplete="name" />
              <small class="contact-error" data-for="name" hidden></small>
            </label>
            <label class="contact-field">
              <span>E-mail</span>
              <input type="email" name="email" required maxlength="254" inputmode="email"
                placeholder="seu@email.com" autocomplete="email" />
              <small class="contact-error" data-for="email" hidden></small>
            </label>
          </div>

          <label class="contact-field">
            <span>Assunto <em>(opcional)</em></span>
            <input type="text" name="subject" maxlength="150" placeholder="Sobre o que você quer falar?" />
            <small class="contact-error" data-for="subject" hidden></small>
          </label>

          <label class="contact-field">
            <span>Mensagem</span>
            <textarea name="message" required minlength="10" maxlength="5000" rows="6" placeholder="Escreva sua mensagem..."></textarea>
            <div class="contact-meta">
              <small class="contact-error" data-for="message" hidden></small>
              <small class="contact-counter" aria-hidden="true">0 / 5000</small>
            </div>
          </label>

          <button type="submit" class="btn-neu btn-lg btn-primary contact-submit">Enviar mensagem →</button>
          <p id="contactMessage" class="contact-msg" hidden></p>
        </form>

        <p class="contact-alt" style="color: var(--color-muted)">
          Prefere outro canal? Escreva para
          <a href={SOCIAL.email} class="underline underline-offset-4">paulgomes@wys.com.br</a>,
          ou me chame no
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener" class="underline underline-offset-4">LinkedIn</a> e
          <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="underline underline-offset-4">Instagram</a>.
        </p>
      </section>
    </main>
    <Footer />

    <script>
      const form = document.getElementById('contactForm') as HTMLFormElement | null;
      const msg = document.getElementById('contactMessage') as HTMLParagraphElement | null;

      if (form && msg) {
        const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | null;
        const errorFor = (n: string) =>
          form.querySelector(`.contact-error[data-for="${n}"]`) as HTMLElement | null;

        // Sanitização leve no cliente (o servidor revalida tudo — esta é só UX):
        // remove caracteres de controle invisíveis dos campos de 1 linha.
        const CONTROL = new RegExp('[\\x00-\\x1F\\x7F]', 'g');
        const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const HAS_LETTER = /\p{L}/u;

        function setError(name: string, text: string | null) {
          const field = el(name);
          const box = errorFor(name);
          if (field) field.setAttribute('aria-invalid', text ? 'true' : 'false');
          if (box) {
            box.textContent = text || '';
            box.hidden = !text;
          }
          return !text;
        }

        function validate(): boolean {
          const name = (el('name')?.value || '').replace(CONTROL, ' ').trim();
          const email = (el('email')?.value || '').replace(CONTROL, ' ').trim();
          const subject = (el('subject')?.value || '').replace(CONTROL, ' ').trim();
          const message = (el('message')?.value || '').trim();

          let ok = true;
          ok = setError('name',
            name.length < 2 || !HAS_LETTER.test(name) ? 'Informe um nome válido (mín. 2 letras).' : null) && ok;
          ok = setError('email',
            !EMAIL_RE.test(email) ? 'Digite um e-mail válido.' : null) && ok;
          ok = setError('subject',
            subject.length > 150 ? 'Assunto muito longo.' : null) && ok;
          ok = setError('message',
            message.length < 10 ? 'Escreva uma mensagem com mais detalhes (mín. 10 caracteres).' : null) && ok;
          return ok;
        }

        // Contador de caracteres da mensagem.
        const messageEl = el('message') as HTMLTextAreaElement | null;
        const counter = form.querySelector('.contact-counter') as HTMLElement | null;
        if (messageEl && counter) {
          const update = () => { counter.textContent = `${messageEl.value.length} / 5000`; };
          messageEl.addEventListener('input', update);
          update();
        }

        // Limpa o erro do campo assim que o usuário corrige.
        ['name', 'email', 'subject', 'message'].forEach((n) => {
          el(n)?.addEventListener('input', () => setError(n, null));
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!validate()) {
            const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
            firstInvalid?.focus();
            return;
          }

          const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
          const data = {
            name: el('name')?.value || '',
            email: el('email')?.value || '',
            subject: el('subject')?.value || '',
            message: el('message')?.value || '',
            company: (form.elements.namedItem('company') as HTMLInputElement)?.value || '',
          };
          msg.hidden = false;
          msg.textContent = 'Enviando...';
          msg.dataset.kind = 'pending';
          if (button) button.disabled = true;
          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            const json = (await res.json()) as any;
            if (!res.ok) {
              msg.textContent = json?.error || 'Erro ao enviar. Tente novamente.';
              msg.dataset.kind = 'error';
            } else {
              msg.textContent = json?.message || 'Mensagem enviada ✓';
              msg.dataset.kind = 'success';
              form.reset();
              if (counter) counter.textContent = '0 / 5000';
            }
          } catch {
            msg.textContent = 'Erro de conexão. Tente novamente.';
            msg.dataset.kind = 'error';
          } finally {
            if (button) button.disabled = false;
          }
        });
      }
    </script>

    <style>
      .contact-form {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 40rem;
      }
      .hp {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .contact-row {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }
      @media (min-width: 560px) {
        .contact-row { flex-direction: row; }
        .contact-row .contact-field { flex: 1; }
      }
      .contact-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .contact-field > span {
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-ink);
      }
      .contact-field > span em {
        font-style: normal;
        font-weight: 400;
        color: var(--color-muted);
      }
      .contact-field input,
      .contact-field textarea {
        width: 100%;
        padding: 0.85rem 1.1rem;
        border-radius: 0.75rem;
        border: 1px solid var(--color-border);
        background-color: var(--color-paper);
        color: var(--color-ink);
        font-size: 1rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .contact-field textarea { resize: vertical; min-height: 8rem; line-height: 1.55; }
      .contact-field input::placeholder,
      .contact-field textarea::placeholder { color: var(--color-muted); }
      .contact-field input:focus,
      .contact-field textarea:focus {
        border-color: #0103F9;
        box-shadow: 0 0 0 3px rgba(1, 3, 249, 0.15);
      }
      .contact-field input[aria-invalid="true"],
      .contact-field textarea[aria-invalid="true"] {
        border-color: #d33;
        box-shadow: 0 0 0 3px rgba(221, 51, 51, 0.15);
      }
      .contact-error {
        font-size: 0.8rem;
        color: #d33;
        line-height: 1.3;
      }
      .contact-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }
      .contact-counter {
        font-size: 0.75rem;
        color: var(--color-muted);
        margin-left: auto;
        white-space: nowrap;
      }
      .contact-submit { align-self: flex-start; margin-top: 0.25rem; cursor: pointer; }
      .contact-submit:disabled { opacity: 0.6; cursor: wait; }
      .contact-msg {
        margin: 0;
        font-size: 0.95rem;
        color: var(--color-muted);
        transition: color 0.15s ease;
      }
      .contact-msg[data-kind="success"] { color: #0103F9; }
      .contact-msg[data-kind="error"] { color: #d33; }
      .contact-alt {
        margin-top: 2.5rem;
        font-size: 1rem;
        line-height: 1.7;
      }

      :global(.dark) .contact-field input,
      :global(.dark) .contact-field textarea {
        background-color: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.15);
        color: #fff;
      }
      :global(.dark) .contact-field input::placeholder,
      :global(.dark) .contact-field textarea::placeholder {
        color: rgba(255, 255, 255, 0.4);
      }
    </style>
  </body>
</html>
