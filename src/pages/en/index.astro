---
// Listagem EN: /en/
//
// Espelha src/pages/blog/index.astro, mas le a colecao traduzida. Fica vazia
// (com aviso) enquanto nao houver nenhuma traducao publicada — nao inventa
// conteudo nem aponta para URLs inexistentes.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { useTranslations, BCP47 } from '../../i18n';

const lang = 'en' as const;
const t = useTranslations(lang);

// So lista traducoes que tem original PT correspondente.
const originals = new Set((await getCollection('blog')).map((p) => p.id));
const posts = (await getCollection('blogEn'))
  .filter((p) => originals.has(p.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang={BCP47[lang]}>
  <head>
    <BaseHead
      title={`${t('listagem.titulo')} — ${SITE_TITLE}`}
      description={t('listagem.descricao')}
      lang={lang}
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="container-wide pt-16 pb-12 md:pt-24">
        <h1 class="font-display text-5xl font-bold tracking-tight md:text-6xl">{t('listagem.titulo')}</h1>
        <p class="mt-4 max-w-2xl text-lg" style="color: var(--color-muted)">
          {t('listagem.descricao')}
        </p>
        <p class="mt-3 text-sm" style="color: var(--color-muted)">
          {t('listagem.traduzido_aviso')}
        </p>
      </section>
      <section class="container-wide py-12 border-t" style="border-color: var(--color-border)">
        {posts.length > 0 ? (
          <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => <PostCard post={post} lang={lang} />)}
          </div>
        ) : (
          <p class="text-lg" style="color: var(--color-muted)">{t('listagem.vazio')}</p>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
