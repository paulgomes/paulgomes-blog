---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Parceiros — ${SITE_TITLE}`} description="Parceiros e colaborações de Paul Gomes." />
  </head>
  <body>
    <Header />
    <main>
      <section class="container-prose pt-16 pb-24 md:pt-24">
        <h1 class="font-display text-5xl font-bold tracking-tight md:text-6xl">Parceiros</h1>
        <div class="mt-10 space-y-6 text-lg leading-relaxed" style="color: var(--color-muted)">
          <p>Página em construção.</p>
          <p>
            Para colaborações, projetos e parcerias, entre em contato pelo <a href="/contato" class="underline underline-offset-4">formulário de contato</a>.
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
