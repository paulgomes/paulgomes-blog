---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { readingTime } from '../lib/reading-time';
import { postAlternates, DEFAULT_LANG } from '../i18n';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	// Um post so vira par PT<->EN quando a traducao existe de fato em
	// src/content/blog-en. Sem isso, nada de hreflang nem de seletor de idioma.
	const translated = new Set((await getCollection('blogEn')).map((p) => p.id));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { ...post, hasEn: translated.has(post.id) },
	}));
}
type Props = CollectionEntry<'blog'> & { hasEn: boolean };

const { hasEn, ...post } = Astro.props;
const { Content } = await render(post as CollectionEntry<'blog'>);

const minutes = readingTime(post.body);
const alternates = hasEn ? postAlternates(post.id, ['pt', 'en']) : [];
---

<BlogPost {...post.data} minutes={minutes} id={post.id} lang={DEFAULT_LANG} alternates={alternates}>
	<Content />
</BlogPost>
