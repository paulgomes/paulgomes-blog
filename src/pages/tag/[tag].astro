---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { TAGS, TAG_SLUGS, type Tag } from '../../lib/tags';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return TAGS.map((tag) => {
    const slug = TAG_SLUGS[tag];
    const posts = allPosts
      .filter((p) => (p.data.tags || []).includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { tag: slug },
      props: { tag, posts },
    };
  });
}

const { tag, posts } = Astro.props as { tag: Tag; posts: Awaited<ReturnType<typeof getCollection<'blog'>>> };
const count = posts.length;
const description = `${count} ${count === 1 ? 'ensaio' : 'ensaios'} sobre ${tag}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`${tag} — ${SITE_TITLE}`} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <section class="container-wide pt-16 pb-12 md:pt-24">
        <SectionHeader
          eyebrow="Tag"
          title={tag}
          description={description}
          href="/blog"
          hrefLabel="Ver todos →"
        />
      </section>

      {count > 0 ? (
        <section class="container-wide pb-24 border-t" style="border-color: var(--color-border)">
          <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3 pt-12">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ) : (
        <section class="container-wide pb-24">
          <p class="text-center text-lg" style="color: var(--color-muted)">
            Nenhum ensaio nessa tag ainda. <a href="/blog" class="underline underline-offset-4">Ver todos os ensaios →</a>
          </p>
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>
