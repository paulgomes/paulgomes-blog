---
import PainelLayout from '../../../components/painel/PainelLayout.astro';
import Editor from '../../../components/painel/Editor.tsx';
import '../../../styles/painel.css';

const url = new URL(Astro.url);
const isEditing = url.searchParams.has('id') || url.searchParams.has('slug');
const currentNav = isEditing ? 'posts' : 'new';
---

<PainelLayout title="Editor — Painel" description="Editor de posts" current={currentNav}>
  <header class="editor-header">
    <a href="/painel/posts" class="editor-back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Posts
    </a>
    <div class="editor-header__spacer"></div>
    <span id="saveStatus" class="save-status"></span>
    <button id="deleteBtn" class="ed-btn ed-btn--danger" style="display: none;" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
      Excluir
    </button>
    <button id="publishBtn" class="ed-btn ed-btn--primary" type="button">Publicar</button>
    <button id="syncBtn" class="ed-btn ed-btn--primary" style="display: none;" title="Commita as alterações do painel direto em main do GitHub" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Sincronizar com Git
    </button>
  </header>

  <div id="postModeBanner" class="post-mode-banner" style="display: none;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
    <span>Editando post publicado — alterações ficam no painel até serem sincronizadas com Git.</span>
  </div>

  <div class="editor-grid">
    <article class="editor-main">
      <input id="title" class="title-input" placeholder="Título do ensaio" />
      <input id="description" class="desc-input" placeholder="Descrição curta (aparece em listagens)" />

      <Editor client:load />

      <div class="editor-meta">
        <span id="wordCount">0 palavras</span>
        <span>·</span>
        <span id="readTime">0 min de leitura</span>
      </div>
    </article>

    <aside class="editor-side">
      <section class="side-section">
        <label class="side-label">Slug</label>
        <input id="slug" class="side-input" placeholder="meu-post" />
      </section>

      <section class="side-section">
        <label id="categoryLabel" class="side-label">Categoria</label>
        <input id="category" class="side-input" placeholder="Branding, IA, etc" />
      </section>

      <section class="side-section">
        <label class="side-label">Hero Image</label>
        <div class="hero-uploader">
          <div id="heroPreview" class="hero-preview" data-empty="true">
            <div class="hero-preview-empty">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              <span>Nenhuma imagem</span>
            </div>
            <img id="heroPreviewImg" alt="" />
          </div>

          <div class="hero-actions">
            <input type="file" id="heroFileInput" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
            <button type="button" class="hero-btn" id="heroChooseBtn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <span id="heroChooseBtnLabel">Escolher arquivo</span>
            </button>
            <button type="button" class="hero-btn hero-btn-ghost" id="heroRemoveBtn" hidden>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              Remover
            </button>
          </div>

          <input type="hidden" id="heroImage" value="" />

          <details class="hero-url-toggle">
            <summary>Colar URL manualmente</summary>
            <input type="url" id="heroImageUrl" class="side-input" placeholder="https://media.paulgomes.com.br/..." />
          </details>
        </div>
      </section>

      <section class="side-section seo-section">
        <h3 class="side-section__title">SEO</h3>

        <div class="seo-counter">
          <label>Título</label>
          <div id="titleCounter">0 / 60</div>
        </div>
        <div class="seo-counter">
          <label>Descrição</label>
          <div id="descCounter">0 / 160</div>
        </div>

        <div class="seo-preview">
          <span class="seo-preview-url">paulgomes.com.br › blog › <span id="previewSlug">meu-post</span></span>
          <h4 id="previewTitle">Título do ensaio</h4>
          <p id="previewDesc">Descrição curta aparece aqui...</p>
        </div>
      </section>
    </aside>
  </div>

  <script>
    // ===== Modo =====
    // 'post'  → editando posts_meta via /api/posts/:slug
    // 'draft' → editando drafts via /api/drafts/:id (legado)
    const params = new URLSearchParams(window.location.search);
    const initialSlug = params.get('slug');
    const initialId = params.get('id');
    const mode: 'post' | 'draft' = initialSlug ? 'post' : 'draft';

    let draftId: string | null = initialId;
    let postSlug: string | null = initialSlug;
    let currentContent = '';
    let saveTimer: ReturnType<typeof setTimeout> | null = null;
    let retryTimer: ReturnType<typeof setTimeout> | null = null;
    let hasChanges = false;

    let editorReady = false;
    let pendingContent: string | null = null;

    // ===== Refs DOM =====
    const $title = document.getElementById('title') as HTMLInputElement;
    const $description = document.getElementById('description') as HTMLInputElement;
    const $slug = document.getElementById('slug') as HTMLInputElement;
    const $category = document.getElementById('category') as HTMLInputElement;
    const $categoryLabel = document.getElementById('categoryLabel') as HTMLLabelElement;
    const $heroImage = document.getElementById('heroImage') as HTMLInputElement;
    const $saveStatus = document.getElementById('saveStatus') as HTMLSpanElement;
    const $publishBtn = document.getElementById('publishBtn') as HTMLButtonElement;
    const $syncBtn = document.getElementById('syncBtn') as HTMLButtonElement;
    const $deleteBtn = document.getElementById('deleteBtn') as HTMLButtonElement;
    const $banner = document.getElementById('postModeBanner') as HTMLDivElement;

    const $wordCount = document.getElementById('wordCount') as HTMLSpanElement;
    const $readTime = document.getElementById('readTime') as HTMLSpanElement;

    const $titleCounter = document.getElementById('titleCounter') as HTMLDivElement;
    const $descCounter = document.getElementById('descCounter') as HTMLDivElement;
    const $previewSlug = document.getElementById('previewSlug') as HTMLSpanElement;
    const $previewTitle = document.getElementById('previewTitle') as HTMLHeadingElement;
    const $previewDesc = document.getElementById('previewDesc') as HTMLParagraphElement;

    // ===== Setup modo post =====
    if (mode === 'post') {
      $banner.style.display = 'flex';
      $publishBtn.style.display = 'none';
      $syncBtn.style.display = 'inline-flex';
      $slug.readOnly = true;
      $slug.classList.add('is-readonly');
      $categoryLabel.textContent = 'Tags (separadas por vírgula)';
      $category.placeholder = 'IA, SEO, Branding';
      $deleteBtn.style.display = 'inline-flex';
    }

    // ===== Ponte com o Editor =====
    window.addEventListener('editor:ready', () => {
      editorReady = true;
      if (pendingContent !== null) {
        window.dispatchEvent(new CustomEvent('editor:set-content', { detail: { html: pendingContent } }));
        pendingContent = null;
      }
    });

    window.addEventListener('editor:change', (e: Event) => {
      const ev = e as CustomEvent<{ html: string; md: string; wordCount: number; readTime: number }>;
      currentContent = ev.detail.md;
      $wordCount.textContent = `${ev.detail.wordCount} ${ev.detail.wordCount === 1 ? 'palavra' : 'palavras'}`;
      $readTime.textContent = `${ev.detail.readTime} min de leitura`;
      scheduleAutoSave();
    });

    function setEditorContent(html: string) {
      if (editorReady) {
        window.dispatchEvent(new CustomEvent('editor:set-content', { detail: { html } }));
      } else {
        pendingContent = html;
      }
    }

    // ===== SEO counters + preview =====
    function updateSeoCounter(el: HTMLDivElement, current: number, max: number) {
      el.textContent = `${current} / ${max}`;
      el.classList.remove('warn', 'over');
      if (current > max) el.classList.add('over');
      else if (current > max * 0.8) el.classList.add('warn');
    }

    function slugify(s: string) {
      return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }

    function updateSeoPreview() {
      const t = $title.value || 'Título do ensaio';
      const d = $description.value || 'Descrição curta aparece aqui...';
      const s = $slug.value || slugify($title.value) || 'meu-post';
      $previewTitle.textContent = t;
      $previewDesc.textContent = d;
      $previewSlug.textContent = s;

      updateSeoCounter($titleCounter, $title.value.length, 60);
      updateSeoCounter($descCounter, $description.value.length, 160);
    }
    updateSeoPreview();

    // ===== Helpers tags =====
    function tagsToString(tags: any): string {
      if (!tags) return '';
      if (Array.isArray(tags)) return tags.join(', ');
      if (typeof tags === 'string') {
        try {
          const parsed = JSON.parse(tags);
          if (Array.isArray(parsed)) return parsed.join(', ');
        } catch {}
        return tags;
      }
      return '';
    }

    function tagsToArray(s: string): string[] {
      return s.split(',').map((t) => t.trim()).filter(Boolean);
    }

    // ===== Load =====
    async function loadDraft() {
      if (!initialId) return;
      const res = await fetch(`/api/drafts/${initialId}`);
      if (!res.ok) {
        $saveStatus.textContent = 'Erro ao carregar';
        window.toast?.('Erro ao carregar rascunho', 'error');
        return;
      }
      const { draft } = await res.json();
      $title.value = draft.title || '';
      $description.value = draft.description || '';
      $slug.value = draft.slug || '';
      $category.value = draft.category || '';
      applyHeroValue(draft.hero_image_url || '');
      currentContent = draft.content_md || '';
      $deleteBtn.style.display = 'inline-flex';
      if (draft.status === 'published') {
        $publishBtn.textContent = 'Republicar';
      }
      setEditorContent(currentContent);
      updateSeoPreview();
    }

    async function loadPost() {
      if (!initialSlug) return;
      const res = await fetch(`/api/posts/${encodeURIComponent(initialSlug)}`);
      if (res.status === 401) {
        window.location.href = '/painel/login';
        return;
      }
      if (!res.ok) {
        $saveStatus.textContent = 'Erro ao carregar';
        window.toast?.('Erro ao carregar post', 'error');
        return;
      }
      const { post } = await res.json();
      $title.value = post.title || '';
      $description.value = post.description || '';
      $slug.value = post.slug || '';
      $category.value = tagsToString(post.tags);
      applyHeroValue(post.hero_image_url || '');
      currentContent = post.content_md || '';
      setEditorContent(currentContent);
      updateSeoPreview();
    }

    // ===== Auto-save =====
    function buildDraftPayload() {
      return {
        title: $title.value,
        description: $description.value,
        slug: $slug.value || slugify($title.value),
        category: $category.value,
        hero_image_url: $heroImage.value,
        content_md: currentContent,
      };
    }

    function buildPostPayload() {
      return {
        title: $title.value,
        description: $description.value,
        hero_image_url: $heroImage.value,
        content_md: currentContent,
        tags: tagsToArray($category.value),
      };
    }

    function hasAnyContent(): boolean {
      return !!(
        $title.value.trim() ||
        $description.value.trim() ||
        $slug.value.trim() ||
        $category.value.trim() ||
        $heroImage.value.trim() ||
        (currentContent && currentContent.trim())
      );
    }

    function formatTime(d: Date): string {
      return d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    }

    async function autoSave() {
      if (!hasChanges) return;

      if (mode === 'post') {
        if (!postSlug) return;
        hasChanges = false;
        $saveStatus.textContent = 'Salvando...';
        $saveStatus.classList.remove('save-status-error');

        try {
          const res = await fetch(`/api/posts/${encodeURIComponent(postSlug)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(buildPostPayload()),
          });
          if (!res.ok) throw new Error('PUT falhou');
          if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
          $saveStatus.textContent = `Salvo às ${formatTime(new Date())} · não sincronizado com Git`;
        } catch (err) {
          console.error(err);
          $saveStatus.textContent = 'Erro ao salvar — tentando de novo';
          $saveStatus.classList.add('save-status-error');
          hasChanges = true;
          if (retryTimer) clearTimeout(retryTimer);
          retryTimer = setTimeout(autoSave, 5000);
        }
        return;
      }

      if (!draftId && !hasAnyContent()) return;

      hasChanges = false;
      $saveStatus.textContent = 'Salvando...';
      $saveStatus.classList.remove('save-status-error');

      const payload = buildDraftPayload();

      try {
        if (!draftId) {
          const res = await fetch('/api/drafts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('POST falhou');
          const data = await res.json();
          draftId = data.id;
          history.replaceState({}, '', `/painel/posts/editor?id=${data.id}`);
          $deleteBtn.style.display = 'inline-flex';
        } else {
          const res = await fetch(`/api/drafts/${draftId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('PUT falhou');
        }
        if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
        $saveStatus.textContent = `Salvo às ${formatTime(new Date())}`;
      } catch (err) {
        console.error(err);
        $saveStatus.textContent = 'Erro ao salvar — tentando de novo';
        $saveStatus.classList.add('save-status-error');
        hasChanges = true;
        if (retryTimer) clearTimeout(retryTimer);
        retryTimer = setTimeout(autoSave, 5000);
      }
    }

    function scheduleAutoSave() {
      hasChanges = true;
      if (saveTimer) clearTimeout(saveTimer);
      saveTimer = setTimeout(autoSave, 1500);
    }

    // Hidden input nao dispara 'input', entao removido do watchlist —
    // mudancas no hero passam por scheduleAutoSave() direto via applyHeroValue.
    const inputsToWatch = mode === 'post'
      ? [$title, $description, $category]
      : [$title, $description, $slug, $category];

    inputsToWatch.forEach((el) => {
      el.addEventListener('input', () => {
        updateSeoPreview();
        scheduleAutoSave();
      });
    });

    // ===== Hero image uploader =====
    const $heroFileInput = document.getElementById('heroFileInput') as HTMLInputElement;
    const $heroChooseBtn = document.getElementById('heroChooseBtn') as HTMLButtonElement;
    const $heroChooseBtnLabel = document.getElementById('heroChooseBtnLabel') as HTMLSpanElement;
    const $heroRemoveBtn = document.getElementById('heroRemoveBtn') as HTMLButtonElement;
    const $heroPreview = document.getElementById('heroPreview') as HTMLDivElement;
    const $heroPreviewImg = document.getElementById('heroPreviewImg') as HTMLImageElement;
    const $heroImageUrl = document.getElementById('heroImageUrl') as HTMLInputElement;

    function applyHeroValue(url: string, opts: { schedule?: boolean } = {}) {
      const trimmed = (url || '').trim();
      if (trimmed) {
        $heroPreviewImg.src = trimmed;
        $heroPreview.dataset.empty = 'false';
        $heroRemoveBtn.hidden = false;
        $heroImage.value = trimmed;
        if ($heroImageUrl && $heroImageUrl.value !== trimmed) $heroImageUrl.value = trimmed;
      } else {
        $heroPreviewImg.removeAttribute('src');
        $heroPreview.dataset.empty = 'true';
        $heroRemoveBtn.hidden = true;
        $heroImage.value = '';
        if ($heroImageUrl) $heroImageUrl.value = '';
      }
      if (opts.schedule) scheduleAutoSave();
    }

    applyHeroValue($heroImage.value);

    $heroChooseBtn?.addEventListener('click', () => $heroFileInput?.click());

    $heroFileInput?.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        window.toast?.('Por favor selecione uma imagem', 'error');
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        window.toast?.('Imagem muito grande (máx 10MB)', 'error');
        return;
      }

      $heroChooseBtn.disabled = true;
      $heroChooseBtnLabel.textContent = 'Enviando...';
      $heroPreview.dataset.loading = 'true';

      try {
        const formData = new FormData();
        formData.append('file', file);
        const res = await fetch('/api/upload', { method: 'POST', body: formData });
        if (!res.ok) {
          const err = await res.json().catch(() => ({})) as any;
          throw new Error(err.error || 'Falha no upload');
        }
        const { url } = await res.json() as { url: string };
        applyHeroValue(url, { schedule: true });
        window.toast?.('Imagem enviada', 'success');
      } catch (err: any) {
        console.error(err);
        window.toast?.(err.message || 'Erro ao enviar imagem', 'error');
      } finally {
        $heroChooseBtn.disabled = false;
        $heroChooseBtnLabel.textContent = 'Escolher arquivo';
        $heroPreview.dataset.loading = 'false';
        $heroFileInput.value = '';
      }
    });

    $heroRemoveBtn?.addEventListener('click', async () => {
      const ok = await window.confirmAction!({
        title: 'Remover imagem hero?',
        message: 'O arquivo permanece no R2 mas não fica mais vinculado ao post.',
        confirmLabel: 'Remover',
        cancelLabel: 'Cancelar',
        danger: true,
      });
      if (!ok) return;
      applyHeroValue('', { schedule: true });
    });

    $heroImageUrl?.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value;
      applyHeroValue(v, { schedule: true });
    });

    // ===== Sincronizar com Git (post mode only) =====
    $syncBtn.addEventListener('click', async () => {
      if (mode !== 'post' || !postSlug) return;

      if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; }
      if (hasChanges) await autoSave();

      const ok = await window.confirmAction!({
        title: 'Sincronizar com Git?',
        message: 'Commita as alterações direto em main. Cloudflare vai rebuildar em ~1-2 min.',
        confirmLabel: 'Sincronizar',
        cancelLabel: 'Cancelar',
      });
      if (!ok) return;

      $syncBtn.disabled = true;
      const originalText = $syncBtn.textContent;
      $syncBtn.textContent = 'Sincronizando...';

      try {
        const res = await fetch(`/api/posts/${encodeURIComponent(postSlug)}/sync`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) {
          window.toast?.('Erro: ' + (data.error || 'desconhecido'), 'error', 6000);
          $syncBtn.disabled = false;
          $syncBtn.textContent = originalText;
          return;
        }
        $saveStatus.textContent = `Sincronizado às ${formatTime(new Date())} · rebuild em ~2 min`;
        $saveStatus.classList.remove('save-status-error');
        window.toast?.('Sincronizado com Git', 'success', 5000);
        $syncBtn.disabled = false;
        $syncBtn.textContent = originalText;
      } catch (err) {
        window.toast?.('Erro de rede ao sincronizar', 'error');
        $syncBtn.disabled = false;
        $syncBtn.textContent = originalText;
      }
    });

    // ===== Publicar (draft mode only) =====
    $publishBtn.addEventListener('click', async () => {
      if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; }
      if (hasChanges) await autoSave();

      if (!draftId) {
        window.toast?.('Adicione título e conteúdo antes de publicar', 'error');
        return;
      }

      const ok = await window.confirmAction!({
        title: 'Publicar este post?',
        message: 'Vai gerar o markdown no GitHub e o blog será reconstruído em ~1-2 min.',
        confirmLabel: 'Publicar',
        cancelLabel: 'Cancelar',
      });
      if (!ok) return;

      $publishBtn.disabled = true;
      $publishBtn.textContent = 'Publicando...';
      try {
        const res = await fetch(`/api/drafts/${draftId}/publish`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) {
          window.toast?.('Erro: ' + (data.error || 'desconhecido'), 'error');
          $publishBtn.disabled = false;
          $publishBtn.textContent = 'Publicar';
          return;
        }
        window.toast?.(`Publicado! Rebuild em ~2 min`, 'success', 5000);
        $publishBtn.disabled = false;
        $publishBtn.textContent = 'Republicar';
      } catch (err) {
        window.toast?.('Erro de rede ao publicar', 'error');
        $publishBtn.disabled = false;
        $publishBtn.textContent = 'Publicar';
      }
    });

    // ===== Excluir =====
    $deleteBtn.addEventListener('click', async () => {
      if (mode === 'post') {
        if (!postSlug) return;
        const ok = await window.confirmAction!({
          title: 'Excluir este post?',
          message: 'O post será marcado como removido no painel. O arquivo no Git permanece intacto até a próxima sincronização.',
          confirmLabel: 'Excluir',
          cancelLabel: 'Cancelar',
          danger: true,
        });
        if (!ok) return;
        const res = await fetch(`/api/posts/${encodeURIComponent(postSlug)}`, { method: 'DELETE' });
        if (res.ok) {
          window.toast?.('Post excluído', 'success');
          setTimeout(() => { window.location.href = '/painel/posts'; }, 700);
        } else {
          window.toast?.('Erro ao excluir', 'error');
        }
        return;
      }

      if (!draftId) return;
      const ok = await window.confirmAction!({
        title: 'Excluir este rascunho?',
        message: 'Esta ação não pode ser desfeita.',
        confirmLabel: 'Excluir',
        cancelLabel: 'Cancelar',
        danger: true,
      });
      if (!ok) return;

      const res = await fetch(`/api/drafts/${draftId}`, { method: 'DELETE' });
      if (res.ok) {
        window.toast?.('Rascunho excluído', 'success');
        setTimeout(() => { window.location.href = '/painel/posts'; }, 700);
      } else {
        window.toast?.('Erro ao excluir', 'error');
      }
    });

    if (mode === 'post') {
      loadPost();
    } else if (initialId) {
      loadDraft();
    }
  </script>

  <style is:global>
    /* === EDITOR HEADER (sub-header dentro do main) === */
    .editor-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding-bottom: 16px;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--painel-border);
      flex-wrap: wrap;
    }
    .editor-back {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 12px;
      border-radius: 999px;
      color: var(--painel-text-secondary);
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
