---
import BaseHead from '../../../components/BaseHead.astro';
import Editor from '../../../components/painel/Editor.tsx';
import '../../../styles/painel.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title="Editor — Painel" description="Editar post" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="painel-shell">
      <div class="painel-topbar">
        <div class="painel-topbar-inner">
          <a href="/painel/posts" class="font-display text-base font-semibold" style="color: var(--color-ink); text-decoration: none;">← Posts</a>
          <div class="flex items-center gap-3">
            <span id="saveStatus" style="font-size: 0.8rem; color: var(--color-muted);"></span>
            <button id="deleteBtn" class="painel-button danger" style="display: none;">Excluir</button>
            <button id="publishBtn" class="painel-button primary">Publicar</button>
          </div>
        </div>
      </div>

      <main class="painel-main" style="max-width: 920px;">
        <input id="title" class="painel-input" placeholder="Título do ensaio" style="font-family: var(--font-display); font-size: 2rem; font-weight: 700; border: none; padding: 0.5rem 0; margin-bottom: 0.5rem;" />
        <input id="description" class="painel-input" placeholder="Descrição curta (aparece em listagens)" style="border: none; padding: 0.5rem 0; margin-bottom: 1rem; color: var(--color-muted);" />

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 0.4rem;">Slug</label>
            <input id="slug" class="painel-input" placeholder="meu-post" />
          </div>
          <div>
            <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 0.4rem;">Categoria</label>
            <input id="category" class="painel-input" placeholder="Branding, IA, etc" />
          </div>
        </div>

        <div style="margin-bottom: 1rem;">
          <label style="display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted); margin-bottom: 0.4rem;">Hero Image URL</label>
          <input id="heroImage" class="painel-input" placeholder="https://media.paulgomes.com.br/..." />
        </div>

        <!-- React island: TipTap roda aqui -->
        <Editor client:load />

        <p style="margin-top: 1.5rem; font-size: 0.8rem; color: var(--color-muted);">Auto-save ativado · Use a barra de ferramentas para formatar · Imagens vão direto pro R2</p>
      </main>
    </div>

    <script>
      // ===== Estado =====
      const params = new URLSearchParams(window.location.search);
      const initialId = params.get('id');
      let draftId: string | null = initialId;
      let currentContent = '';
      let saveTimer: ReturnType<typeof setTimeout> | null = null;
      let hasChanges = false;

      // Editor pode demorar pra montar (client:load + hidratação). Fila de conteúdo pendente.
      let editorReady = false;
      let pendingContent: string | null = null;

      // ===== Refs DOM =====
      const $title = document.getElementById('title') as HTMLInputElement;
      const $description = document.getElementById('description') as HTMLInputElement;
      const $slug = document.getElementById('slug') as HTMLInputElement;
      const $category = document.getElementById('category') as HTMLInputElement;
      const $heroImage = document.getElementById('heroImage') as HTMLInputElement;
      const $saveStatus = document.getElementById('saveStatus') as HTMLSpanElement;
      const $publishBtn = document.getElementById('publishBtn') as HTMLButtonElement;
      const $deleteBtn = document.getElementById('deleteBtn') as HTMLButtonElement;

      // ===== Ponte com o Editor (React island) =====
      window.addEventListener('editor:ready', () => {
        editorReady = true;
        if (pendingContent !== null) {
          window.dispatchEvent(new CustomEvent('editor:set-content', { detail: { html: pendingContent } }));
          pendingContent = null;
        }
      });

      window.addEventListener('editor:change', (e: Event) => {
        const ev = e as CustomEvent<{ html: string; md: string }>;
        currentContent = ev.detail.md;
        scheduleAutoSave();
      });

      function setEditorContent(html: string) {
        if (editorReady) {
          window.dispatchEvent(new CustomEvent('editor:set-content', { detail: { html } }));
        } else {
          pendingContent = html;
        }
      }

      // ===== Load existing draft =====
      async function loadDraft() {
        if (!initialId) return;
        const res = await fetch(`/api/drafts/${initialId}`);
        if (!res.ok) {
          $saveStatus.textContent = 'Erro ao carregar';
          return;
        }
        const { draft } = await res.json();
        $title.value = draft.title || '';
        $description.value = draft.description || '';
        $slug.value = draft.slug || '';
        $category.value = draft.category || '';
        $heroImage.value = draft.hero_image_url || '';
        currentContent = draft.content_md || '';
        $deleteBtn.style.display = 'inline-flex';
        if (draft.status === 'published') {
          $publishBtn.textContent = 'Republicar';
        }
        setEditorContent(currentContent);
      }

      // ===== Auto-save =====
      function buildPayload() {
        return {
          title: $title.value,
          description: $description.value,
          slug: $slug.value || $title.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
          category: $category.value,
          hero_image_url: $heroImage.value,
          content_md: currentContent,
        };
      }

      async function autoSave() {
        if (!hasChanges) return;
        $saveStatus.textContent = 'Salvando...';
        const payload = buildPayload();
        if (!draftId) {
          const res = await fetch('/api/drafts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok) {
            draftId = data.id;
            history.replaceState({}, '', `/painel/posts/editor?id=${data.id}`);
            $deleteBtn.style.display = 'inline-flex';
          }
        } else {
          await fetch(`/api/drafts/${draftId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        }
        hasChanges = false;
        $saveStatus.textContent = 'Salvo ✓';
        setTimeout(() => { $saveStatus.textContent = ''; }, 2000);
      }

      function scheduleAutoSave() {
        hasChanges = true;
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(autoSave, 1500);
      }

      [$title, $description, $slug, $category, $heroImage].forEach((el) => {
        el.addEventListener('input', scheduleAutoSave);
      });

      // ===== Publicar =====
      $publishBtn.addEventListener('click', async () => {
        if (!draftId) await autoSave();
        if (!draftId) { alert('Salva o rascunho antes de publicar'); return; }
        if (!confirm('Publicar este post? Vai gerar o markdown no GitHub e o blog será reconstruído em ~1-2 min.')) return;
        $publishBtn.disabled = true;
        $publishBtn.textContent = 'Publicando...';
        const res = await fetch(`/api/drafts/${draftId}/publish`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) {
          alert('Erro: ' + (data.error || 'desconhecido'));
          $publishBtn.disabled = false;
          $publishBtn.textContent = 'Publicar';
          return;
        }
        alert(`✓ Publicado!\n\n${data.message}\n\nLink: ${data.preview_url}`);
        $publishBtn.disabled = false;
        $publishBtn.textContent = 'Republicar';
      });

      // ===== Excluir =====
      $deleteBtn.addEventListener('click', async () => {
        if (!draftId) return;
        if (!confirm('Excluir este rascunho?')) return;
        await fetch(`/api/drafts/${draftId}`, { method: 'DELETE' });
        window.location.href = '/painel/posts';
      });

      // ===== Init =====
      if (initialId) {
        loadDraft();
      }
    </script>
  </body>
</html>
