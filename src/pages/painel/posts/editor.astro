---
import PainelLayout from '../../../components/painel/PainelLayout.astro';
import Editor from '../../../components/painel/Editor.tsx';
import '../../../styles/painel.css';

const url = new URL(Astro.url);
const isEditing = url.searchParams.has('id') || url.searchParams.has('slug');
const currentNav = isEditing ? 'posts' : 'new';
---

<PainelLayout title="Editor — Painel" description="Editor de posts" current={currentNav}>
  <header class="editor-header">
    <a href="/painel/posts" class="editor-back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Posts
    </a>
    <div class="editor-header__spacer"></div>
    <span id="saveStatus" class="save-status"></span>
    <button id="deleteBtn" class="btn-neu btn-md btn-danger" style="display: none;" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
      Excluir
    </button>
    <button id="publishBtn" class="btn-neu btn-md btn-primary" type="button">Publicar</button>
    <button id="btnSavePost" class="btn-neu btn-lg btn-primary" style="display: none;" title="Salva e publica direto no site (rebuild em ~1-2 min)" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Salvar
    </button>
  </header>

  <div id="postModeBanner" class="post-mode-banner" style="display: none;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
    <span>Editando post publicado — alterações ficam no painel até serem sincronizadas com Git.</span>
  </div>

  <div class="editor-grid">
    <article class="editor-main">
      <textarea id="title" class="title-input" rows="1" placeholder="Título do post"></textarea>
      <input id="description" class="desc-input" placeholder="Descrição curta (aparece em listagens)" />

      <Editor client:load />

      <div class="editor-meta">
        <span id="wordCount">0 palavras</span>
        <span>·</span>
        <span id="readTime">0 min de leitura</span>
      </div>
    </article>

    <aside class="editor-side">
      <section class="side-section">
        <label class="side-label">Slug</label>
        <input id="slug" class="side-input" placeholder="meu-post" />
      </section>

      <section class="side-section">
        <label id="categoryLabel" class="side-label">Categoria</label>
        <input id="category" class="side-input" placeholder="Branding, IA, etc" />
      </section>

      <section class="side-section">
        <label class="side-label">Hero Image</label>
        <div class="hero-uploader">
          <div id="heroPreview" class="hero-preview" data-empty="true">
            <div class="hero-preview-empty">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              <span>Nenhuma imagem</span>
            </div>
            <img id="heroPreviewImg" alt="" />
          </div>

          <div class="hero-actions">
            <input type="file" id="heroFileInput" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
            <button type="button" class="btn-neu btn-sm" id="heroChooseBtn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <span id="heroChooseBtnLabel">Escolher arquivo</span>
            </button>
            <button type="button" class="btn-neu btn-sm btn-danger" id="heroRemoveBtn" hidden>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              Remover
            </button>
          </div>

          <input type="hidden" id="heroImage" value="" />

          <details class="hero-url-toggle">
            <summary>Colar URL manualmente</summary>
            <input type="url" id="heroImageUrl" class="side-input" placeholder="https://media.paulgomes.com.br/..." />
          </details>

          <div class="hero-alt-block" id="heroAltBlock" hidden>
            <label class="hero-alt-label" for="heroImageAlt">
              Alt text
              <span class="hero-alt-hint">(descreva o que aparece — SEO + acessibilidade)</span>
            </label>
            <input
              type="text"
              id="heroImageAlt"
              class="side-input"
              maxlength="200"
              placeholder="Ex: Paul Gomes palestrando sobre IA…"
            />
            <p class="hero-alt-counter" id="heroAltCounter">0/200</p>
          </div>
        </div>
      </section>

      <section class="side-section" id="publishedAtBlock" hidden>
        <label class="side-label" for="publishedAtInput">Data de publicação</label>
        <div class="date-row">
          <input type="datetime-local" id="publishedAtInput" class="side-input date-input" />
          <button type="button" id="publishedAtNow" class="btn-neu btn-sm" title="Usar agora">Agora</button>
        </div>
        <p class="field-hint" id="publishedAtHint">
          Datas no passado/presente. Futuro será suportado em breve.
        </p>
      </section>

      <section class="side-section" id="featuredBlock" hidden>
        <label class="side-label">Destaque</label>
        <div class="featured-toggle">
          <input type="checkbox" id="isFeatured" />
          <label for="isFeatured" class="featured-toggle-label">
            <span class="featured-star">★</span>
            Destacar este post na home
          </label>
        </div>
        <small id="featuredHint" class="featured-hint">
          Vários posts podem ficar em destaque no carrossel da home.
        </small>
      </section>

      <section class="side-section seo-section">
        <h3 class="side-section__title">SEO</h3>

        <div class="seo-toolbar">
          <button type="button" id="seoGenerate" class="seo-gen-btn">✨ Gerar SEO</button>
          <span class="seo-score-badge" id="seoScoreBadge">--</span>
        </div>

        <div class="seo-field">
          <label for="focusKeyword">Palavra-chave foco</label>
          <input type="text" id="focusKeyword" class="side-input" placeholder="ex: marketing digital" />
        </div>

        <div class="seo-field">
          <label for="metaTitle">Meta título <small id="mtCounter">0/60</small></label>
          <input type="text" id="metaTitle" class="side-input" maxlength="80" placeholder="50-60 caracteres" />
        </div>

        <div class="seo-field">
          <label for="metaDescription">Meta descrição <small id="mdCounter">0/160</small></label>
          <textarea id="metaDescription" class="side-input seo-textarea" maxlength="220" rows="3" placeholder="150-160 caracteres"></textarea>
        </div>

        <div class="seo-preview">
          <span class="seo-preview-url">paulgomes.com.br › <span id="previewSlug">meu-post</span></span>
          <h4 id="previewTitle">Título do post</h4>
          <p id="previewDesc">Descrição curta aparece aqui...</p>
        </div>

        <div class="seo-analysis" id="seoAnalysis">
          <h4 class="seo-analysis-title">Análise SEO</h4>
          <ul class="seo-checks" id="seoChecks"></ul>
        </div>
      </section>

      <section class="side-section" id="historyBlock" hidden>
        <label class="side-label">Histórico de versões</label>
        <div id="historyList" class="history-list"><p class="history-empty">Carregando…</p></div>
      </section>
    </aside>
  </div>

  <script>
    import { analyzeSEO, detectFocusKeyword, generateMetaTitle, generateMetaDescription } from '../../../lib/seo-analyzer';

    // ===== Modo =====
    // 'post'  → editando posts_meta via /api/posts/:slug
    // 'draft' → editando drafts via /api/drafts/:id (legado)
    const params = new URLSearchParams(window.location.search);
    const initialSlug = params.get('slug');
    const initialId = params.get('id');
    const mode: 'post' | 'draft' = initialSlug ? 'post' : 'draft';

    let draftId: string | null = initialId;
    let postSlug: string | null = initialSlug;
    let currentContent = '';
    let saveTimer: ReturnType<typeof setTimeout> | null = null;
    let retryTimer: ReturnType<typeof setTimeout> | null = null;
    let hasChanges = false;

    let editorReady = false;
    let pendingContent: string | null = null;

    // ===== Refs DOM =====
    const $title = document.getElementById('title') as HTMLTextAreaElement;
    // Titulo: textarea auto-crescente — quebra linha em vez de cortar titulos longos.
    function autoGrowTitle() {
      $title.style.height = 'auto';
      $title.style.height = $title.scrollHeight + 'px';
    }
    $title.addEventListener('input', autoGrowTitle);
    // Enter no titulo nao insere quebra de linha (o wrap e automatico/visual).
    $title.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
    const $description = document.getElementById('description') as HTMLInputElement;
    const $slug = document.getElementById('slug') as HTMLInputElement;
    const $category = document.getElementById('category') as HTMLInputElement;
    const $categoryLabel = document.getElementById('categoryLabel') as HTMLLabelElement;
    const $heroImage = document.getElementById('heroImage') as HTMLInputElement;
    const $saveStatus = document.getElementById('saveStatus') as HTMLSpanElement;
    const $publishBtn = document.getElementById('publishBtn') as HTMLButtonElement;
    const $btnSavePost = document.getElementById('btnSavePost') as HTMLButtonElement;
    const $deleteBtn = document.getElementById('deleteBtn') as HTMLButtonElement;
    const $banner = document.getElementById('postModeBanner') as HTMLDivElement;

    const $wordCount = document.getElementById('wordCount') as HTMLSpanElement;
    const $readTime = document.getElementById('readTime') as HTMLSpanElement;

    const $previewSlug = document.getElementById('previewSlug') as HTMLSpanElement;
    const $previewTitle = document.getElementById('previewTitle') as HTMLHeadingElement;
    const $previewDesc = document.getElementById('previewDesc') as HTMLParagraphElement;

    // === SEO Yoast-like ===
    const $focusKeyword = document.getElementById('focusKeyword') as HTMLInputElement;
    const $metaTitle = document.getElementById('metaTitle') as HTMLInputElement;
    const $metaDescription = document.getElementById('metaDescription') as HTMLTextAreaElement;
    const $mtCounter = document.getElementById('mtCounter') as HTMLElement;
    const $mdCounter = document.getElementById('mdCounter') as HTMLElement;
    const $seoGenBtn = document.getElementById('seoGenerate') as HTMLButtonElement;
    const $seoScoreBadge = document.getElementById('seoScoreBadge') as HTMLSpanElement;
    const $seoChecks = document.getElementById('seoChecks') as HTMLUListElement;

    // === Destaque (featured) — só aparece em modo post publicado ===
    const $featuredBlock = document.getElementById('featuredBlock') as HTMLElement;
    const $isFeatured = document.getElementById('isFeatured') as HTMLInputElement;
    const $featuredHint = document.getElementById('featuredHint') as HTMLElement;

    // === Hero image alt text (campo aparece so quando hero existe) ===
    const $heroAltBlock = document.getElementById('heroAltBlock') as HTMLElement;
    const $heroImageAlt = document.getElementById('heroImageAlt') as HTMLInputElement;
    const $heroAltCounter = document.getElementById('heroAltCounter') as HTMLElement;

    function refreshHeroAltCounter() {
      const len = $heroImageAlt.value.length;
      $heroAltCounter.textContent = `${len}/200`;
      $heroAltCounter.classList.toggle('warn', len > 180);
    }
    $heroImageAlt?.addEventListener('input', () => {
      refreshHeroAltCounter();
      scheduleAutoSave();
    });

    // === Data de publicacao — so aparece em modo post publicado ===
    const $publishedAtBlock = document.getElementById('publishedAtBlock') as HTMLElement;
    const $publishedAtInput = document.getElementById('publishedAtInput') as HTMLInputElement;
    const $publishedAtNowBtn = document.getElementById('publishedAtNow') as HTMLButtonElement;
    const $publishedAtHint = document.getElementById('publishedAtHint') as HTMLElement;

    // ===== Setup modo post =====
    if (mode === 'post') {
      $banner.style.display = 'flex';
      $publishBtn.style.display = 'none';
      $btnSavePost.style.display = 'inline-flex';
      $slug.readOnly = true;
      $slug.classList.add('is-readonly');
      $categoryLabel.textContent = 'Categorias (separadas por vírgula)';
      $category.placeholder = 'IA, SEO, Branding';
      $deleteBtn.style.display = 'inline-flex';
      $featuredBlock.hidden = false;
      $publishedAtBlock.hidden = false;
    } else {
      // modo rascunho: também mostra o calendário de data — futura = agendar, passada = retroativa
      $publishedAtBlock.hidden = false;
      refreshPublishedAtHint();
      refreshPublishButton();
    }

    // ===== Ponte com o Editor =====
    window.addEventListener('editor:ready', () => {
      editorReady = true;
      if (pendingContent !== null) {
        window.dispatchEvent(new CustomEvent('editor:set-content', { detail: { html: pendingContent } }));
        pendingContent = null;
      }
    });

    // Defensiva: se Editor.tsx montou ANTES deste script registrar o listener
    // de editor:ready (race em cold cache), o evento ja passou. Detecta via flag.
    if ((window as any).__editorMounted) {
      editorReady = true;
      if (pendingContent !== null) {
        window.dispatchEvent(new CustomEvent('editor:set-content', { detail: { html: pendingContent } }));
        pendingContent = null;
      }
    }

    window.addEventListener('editor:change', (e: Event) => {
      const ev = e as CustomEvent<{ html: string; md: string; wordCount: number; readTime: number }>;
      currentContent = ev.detail.md;
      $wordCount.textContent = `${ev.detail.wordCount} ${ev.detail.wordCount === 1 ? 'palavra' : 'palavras'}`;
      $readTime.textContent = `${ev.detail.readTime} min de leitura`;
      scheduleAutoSave();
    });

    function setEditorContent(html: string) {
      if (editorReady) {
        window.dispatchEvent(new CustomEvent('editor:set-content', { detail: { html } }));
      } else {
        pendingContent = html;
      }
    }

    // ===== SEO preview + counters dos novos campos =====
    // Mantenha em sync com functions/api/_utils/slugify.ts
    function slugify(s: string) {
      return String(s ?? '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .replace(/-+/g, '-');
    }

    function setCounter(el: HTMLElement, current: number, max: number) {
      el.textContent = `${current}/${max}`;
      el.classList.remove('warn', 'over');
      if (current > max) el.classList.add('over');
      else if (current > max * 0.85) el.classList.add('warn');
    }

    function updateSeoPreview() {
      // Preview usa meta_title/meta_description se preenchidos, fallback pro title/description
      const t = $metaTitle.value.trim() || $title.value || 'Título do post';
      const d = $metaDescription.value.trim() || $description.value || 'Descrição curta aparece aqui...';
      const s = $slug.value || slugify($title.value) || 'meu-post';
      $previewTitle.textContent = t;
      $previewDesc.textContent = d;
      $previewSlug.textContent = s;
      setCounter($mtCounter, $metaTitle.value.length, 60);
      setCounter($mdCounter, $metaDescription.value.length, 160);
    }
    updateSeoPreview();

    // ===== SEO Yoast-like (analise + gerar automatico) =====
    function escapeForList(s: string): string {
      const div = document.createElement('div');
      div.textContent = String(s);
      return div.innerHTML;
    }

    function updateSeoAnalysis() {
      const analysis = analyzeSEO({
        title: $title.value || '',
        metaTitle: $metaTitle.value || '',
        metaDescription: $metaDescription.value || '',
        focusKeyword: $focusKeyword.value || '',
        content: currentContent || '',
      });
      $seoScoreBadge.textContent = String(analysis.score);
      $seoScoreBadge.className = 'seo-score-badge ' + analysis.grade;
      $seoChecks.innerHTML = analysis.checks.map((c) => {
        const icon = c.status === 'pass' ? '✓' : c.status === 'warn' ? '!' : '✗';
        return `<li>
          <span class="seo-check-icon ${c.status}">${icon}</span>
          <div class="seo-check-text">
            <span class="seo-check-label">${escapeForList(c.label)}:</span>
            ${escapeForList(c.message)}
          </div>
        </li>`;
      }).join('');
    }

    let seoTimer: ReturnType<typeof setTimeout> | null = null;
    function scheduleSeoAnalysis() {
      if (seoTimer) clearTimeout(seoTimer);
      seoTimer = setTimeout(updateSeoAnalysis, 300);
    }

    $seoGenBtn?.addEventListener('click', () => {
      const t = $title.value || '';
      const content = currentContent || '';
      if (!t.trim() && !content.trim()) {
        window.toast?.('Adicione título e conteúdo primeiro', 'error');
        return;
      }
      const kw = detectFocusKeyword(t, content);
      if (kw && !$focusKeyword.value.trim()) $focusKeyword.value = kw;
      if (!$metaTitle.value.trim()) $metaTitle.value = generateMetaTitle(t, kw);
      if (!$metaDescription.value.trim()) $metaDescription.value = generateMetaDescription(content, kw);
      updateSeoPreview();
      updateSeoAnalysis();
      scheduleAutoSave();
      window.toast?.('SEO preenchido. Edite livremente.', 'success');
    });

    // Re-analisa quando usuario digita nos campos SEO
    [$focusKeyword, $metaTitle, $metaDescription].forEach((el) => {
      el?.addEventListener('input', () => {
        updateSeoPreview();
        scheduleSeoAnalysis();
        scheduleAutoSave();
      });
    });

    // Re-analisa quando conteudo do TipTap muda (digitacao organica)
    window.addEventListener('editor:content-changed', scheduleSeoAnalysis);

    // Analise inicial
    setTimeout(updateSeoAnalysis, 200);

    // ===== Helpers categorias =====
    function categoriasToString(categorias: any): string {
      if (!categorias) return '';
      if (Array.isArray(categorias)) return categorias.join(', ');
      if (typeof categorias === 'string') {
        try {
          const parsed = JSON.parse(categorias);
          if (Array.isArray(parsed)) return parsed.join(', ');
        } catch {}
        return categorias;
      }
      return '';
    }

    function categoriasToArray(s: string): string[] {
      return s.split(',').map((t) => t.trim()).filter(Boolean);
    }

    // ===== Data de publicacao: helpers + validador =====
    // datetime-local opera em horario LOCAL do navegador (sem timezone).
    // tsToLocalInput/localInputToTs usam getHours()/new Date() pra preservar local.
    function tsToLocalInput(ts: number | string | null | undefined): string {
      if (!ts) return '';
      const d = new Date(typeof ts === 'string' ? Number(ts) || ts : ts);
      if (Number.isNaN(d.getTime())) return '';
      const pad = (n: number) => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }
    function localInputToTs(value: string): number | null {
      if (!value) return null;
      const ts = new Date(value).getTime();
      return Number.isFinite(ts) ? ts : null;
    }
    function isFuturePublishedAt(value: string): boolean {
      const ts = localInputToTs(value);
      return ts !== null && ts > Date.now() + 60_000;
    }
    function validatePublishedAt(value: string): { ok: boolean; msg?: string } {
      if (!value) return { ok: true };
      const ts = localInputToTs(value);
      if (ts === null) return { ok: false, msg: 'Data inválida' };
      // Passado (retroativo) E futuro (agendado) sao permitidos.
      return { ok: true };
    }
    function refreshPublishedAtHint() {
      const value = $publishedAtInput.value;
      const v = validatePublishedAt(value);
      if (!v.ok) {
        $publishedAtHint.textContent = `⚠ ${v.msg}`;
        $publishedAtHint.classList.add('warn');
        return;
      }
      $publishedAtHint.classList.remove('warn');
      if (isFuturePublishedAt(value)) {
        const d = new Date(localInputToTs(value) as number);
        $publishedAtHint.textContent = `🗓 Agendado para ${d.toLocaleString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}.`;
      } else {
        $publishedAtHint.textContent = 'Escolha qualquer data — passada (retroativa) ou futura (agenda o post).';
      }
      // Reflete no botao de publicar (Publicar agora ↔ Agendar)
      if (typeof refreshPublishButton === 'function') refreshPublishButton();
    }

    // ===== Load =====
    async function loadDraft() {
      if (!initialId) return;
      const res = await fetch(`/api/drafts/${initialId}`);
      if (!res.ok) {
        $saveStatus.textContent = 'Erro ao carregar';
        window.toast?.('Erro ao carregar rascunho', 'error');
        return;
      }
      const { draft } = await res.json();
      $title.value = draft.title || '';
      autoGrowTitle();
      $description.value = draft.description || '';
      $slug.value = draft.slug || '';
      $category.value = draft.category || '';
      $focusKeyword.value = draft.focus_keyword || '';
      $metaTitle.value = draft.meta_title || '';
      $metaDescription.value = draft.meta_description || '';
      applyHeroValue(draft.hero_image_url || '');
      $heroImageAlt.value = draft.hero_image_alt || '';
      refreshHeroAltCounter();
      currentContent = draft.content_md || '';
      $deleteBtn.style.display = 'inline-flex';
      if (draft.status === 'published') {
        $publishBtn.textContent = 'Republicar';
      }
      setEditorContent(currentContent);
      updateSeoPreview();
      updateSeoAnalysis();
    }

    async function loadPost() {
      if (!initialSlug) return;
      const res = await fetch(`/api/posts/${encodeURIComponent(initialSlug)}`);
      if (res.status === 401) {
        window.location.href = '/painel/login';
        return;
      }
      if (!res.ok) {
        $saveStatus.textContent = 'Erro ao carregar';
        window.toast?.('Erro ao carregar post', 'error');
        return;
      }
      const { post } = await res.json();
      $title.value = post.title || '';
      autoGrowTitle();
      $description.value = post.description || '';
      $slug.value = post.slug || '';
      $category.value = categoriasToString(post.categorias);
      $focusKeyword.value = post.focus_keyword || '';
      $metaTitle.value = post.meta_title || '';
      $metaDescription.value = post.meta_description || '';
      applyHeroValue(post.hero_image_url || '');
      $heroImageAlt.value = post.hero_image_alt || '';
      refreshHeroAltCounter();
      currentContent = post.content_md || '';
      $isFeatured.checked = Boolean(post.is_featured);
      $publishedAtInput.value = tsToLocalInput(post.published_at);
      refreshPublishedAtHint();
      setEditorContent(currentContent);
      updateSeoPreview();
      updateSeoAnalysis();
      updateFeaturedHint();
      loadHistory();
    }

    // === Histórico de versões (commits do Git via /api/posts/:slug/history) ===
    async function loadHistory() {
      const block = document.getElementById('historyBlock') as HTMLElement | null;
      const list = document.getElementById('historyList') as HTMLElement | null;
      if (!block || !list || !initialSlug) return;
      block.hidden = false;
      try {
        const res = await fetch(`/api/posts/${encodeURIComponent(initialSlug)}/history?limit=15`);
        if (!res.ok) { list.innerHTML = '<p class="history-empty">Não foi possível carregar o histórico.</p>'; return; }
        const { versions } = await res.json();
        if (!versions || !versions.length) { list.innerHTML = '<p class="history-empty">Sem histórico ainda.</p>'; return; }
        const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
        list.innerHTML = versions.map((v: any) => {
          const date = v.date ? new Date(v.date).toLocaleString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
          return `<a class="history-item" href="${esc(v.url)}" target="_blank" rel="noopener" title="Ver commit no GitHub">
            <span class="history-msg">${esc(v.message || '(sem mensagem)')}</span>
            <span class="history-meta">${esc(date)}${v.author ? ' · ' + esc(v.author) : ''} · <code>${esc(v.shortSha)}</code></span>
          </a>`;
        }).join('');
      } catch {
        list.innerHTML = '<p class="history-empty">Erro ao carregar histórico.</p>';
      }
    }

    // === Featured hint ===
    async function updateFeaturedHint() {
      if (!$featuredHint) return;
      if ($isFeatured.checked) {
        $featuredHint.textContent = '★ Este post aparece no carrossel de destaques da home.';
        $featuredHint.style.color = 'var(--painel-success)';
        return;
      }
      try {
        const res = await fetch('/api/posts/featured');
        const data = await res.json();
        const featured = Array.isArray(data.featured) ? data.featured : [];
        const others = featured.filter((f: any) => f.slug !== postSlug);
        if (others.length === 0) {
          $featuredHint.textContent = 'Nenhum post em destaque no momento.';
        } else {
          $featuredHint.textContent = `${others.length} post(s) em destaque no carrossel.`;
        }
        $featuredHint.style.color = 'var(--painel-text-secondary)';
      } catch {
        $featuredHint.textContent = 'Vários posts podem ficar em destaque no carrossel da home.';
        $featuredHint.style.color = 'var(--painel-text-secondary)';
      }
    }

    // ===== Auto-save =====
    function buildDraftPayload() {
      return {
        title: $title.value,
        description: $description.value,
        slug: $slug.value || slugify($title.value),
        category: $category.value,
        hero_image_url: $heroImage.value,
        hero_image_alt: $heroImageAlt.value.trim() || null,
        content_md: currentContent,
        focus_keyword: $focusKeyword.value,
        meta_title: $metaTitle.value,
        meta_description: $metaDescription.value,
      };
    }

    function buildPostPayload() {
      const payload: Record<string, any> = {
        title: $title.value,
        description: $description.value,
        hero_image_url: $heroImage.value,
        hero_image_alt: $heroImageAlt.value.trim() || null,
        content_md: currentContent,
        categorias: categoriasToArray($category.value),
        focus_keyword: $focusKeyword.value,
        meta_title: $metaTitle.value,
        meta_description: $metaDescription.value,
      };
      // Soft-fail: se published_at invalido (futuro), nao envia — hint visual avisa.
      // Resto do post continua salvando normal.
      const pubValidation = validatePublishedAt($publishedAtInput.value);
      if (pubValidation.ok) {
        const ts = localInputToTs($publishedAtInput.value);
        if (ts !== null) payload.published_at = ts;
      }
      return payload;
    }

    function hasAnyContent(): boolean {
      return !!(
        $title.value.trim() ||
        $description.value.trim() ||
        $slug.value.trim() ||
        $category.value.trim() ||
        $heroImage.value.trim() ||
        (currentContent && currentContent.trim())
      );
    }

    function formatTime(d: Date): string {
      return d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    }

    async function autoSave() {
      if (!hasChanges) return;

      if (mode === 'post') {
        if (!postSlug) return;
        hasChanges = false;
        $saveStatus.textContent = 'Salvando...';
        $saveStatus.classList.remove('save-status-error');

        try {
          const res = await fetch(`/api/posts/${encodeURIComponent(postSlug)}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(buildPostPayload()),
          });
          if (!res.ok) throw new Error('PUT falhou');
          if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
          $saveStatus.textContent = `Salvo às ${formatTime(new Date())} · não sincronizado com Git`;
        } catch (err) {
          console.error(err);
          $saveStatus.textContent = 'Erro ao salvar — tentando de novo';
          $saveStatus.classList.add('save-status-error');
          hasChanges = true;
          if (retryTimer) clearTimeout(retryTimer);
          retryTimer = setTimeout(autoSave, 5000);
        }
        return;
      }

      if (!draftId && !hasAnyContent()) return;

      hasChanges = false;
      $saveStatus.textContent = 'Salvando...';
      $saveStatus.classList.remove('save-status-error');

      const payload = buildDraftPayload();

      try {
        if (!draftId) {
          const res = await fetch('/api/drafts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('POST falhou');
          const data = await res.json();
          draftId = data.id;
          history.replaceState({}, '', `/painel/posts/editor?id=${data.id}`);
          $deleteBtn.style.display = 'inline-flex';
        } else {
          const res = await fetch(`/api/drafts/${draftId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('PUT falhou');
        }
        if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
        $saveStatus.textContent = `Salvo às ${formatTime(new Date())}`;
      } catch (err) {
        console.error(err);
        $saveStatus.textContent = 'Erro ao salvar — tentando de novo';
        $saveStatus.classList.add('save-status-error');
        hasChanges = true;
        if (retryTimer) clearTimeout(retryTimer);
        retryTimer = setTimeout(autoSave, 5000);
      }
    }

    function scheduleAutoSave() {
      hasChanges = true;
      if (saveTimer) clearTimeout(saveTimer);
      saveTimer = setTimeout(autoSave, 1500);
    }

    // Hidden input nao dispara 'input', entao removido do watchlist —
    // mudancas no hero passam por scheduleAutoSave() direto via applyHeroValue.
    const inputsToWatch = mode === 'post'
      ? [$title, $description, $category]
      : [$title, $description, $slug, $category];

    inputsToWatch.forEach((el) => {
      el.addEventListener('input', () => {
        updateSeoPreview();
        scheduleSeoAnalysis();
        scheduleAutoSave();
      });
    });

    // ===== Hero image uploader =====
    const $heroFileInput = document.getElementById('heroFileInput') as HTMLInputElement;
    const $heroChooseBtn = document.getElementById('heroChooseBtn') as HTMLButtonElement;
    const $heroChooseBtnLabel = document.getElementById('heroChooseBtnLabel') as HTMLSpanElement;
    const $heroRemoveBtn = document.getElementById('heroRemoveBtn') as HTMLButtonElement;
    const $heroPreview = document.getElementById('heroPreview') as HTMLDivElement;
    const $heroPreviewImg = document.getElementById('heroPreviewImg') as HTMLImageElement;
    const $heroImageUrl = document.getElementById('heroImageUrl') as HTMLInputElement;

    function applyHeroValue(url: string, opts: { schedule?: boolean } = {}) {
      const trimmed = (url || '').trim();
      if (trimmed) {
        $heroPreviewImg.src = trimmed;
        $heroPreview.dataset.empty = 'false';
        $heroRemoveBtn.hidden = false;
        $heroImage.value = trimmed;
        if ($heroImageUrl && $heroImageUrl.value !== trimmed) $heroImageUrl.value = trimmed;
        if ($heroAltBlock) $heroAltBlock.hidden = false;
      } else {
        $heroPreviewImg.removeAttribute('src');
        $heroPreview.dataset.empty = 'true';
        $heroRemoveBtn.hidden = true;
        $heroImage.value = '';
        if ($heroImageUrl) $heroImageUrl.value = '';
        if ($heroAltBlock) $heroAltBlock.hidden = true;
        if ($heroImageAlt) $heroImageAlt.value = '';
        refreshHeroAltCounter();
      }
      if (opts.schedule) scheduleAutoSave();
    }

    applyHeroValue($heroImage.value);

    $heroChooseBtn?.addEventListener('click', () => $heroFileInput?.click());

    $heroFileInput?.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        window.toast?.('Por favor selecione uma imagem', 'error');
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        window.toast?.('Imagem muito grande (máx 10MB)', 'error');
        return;
      }

      $heroChooseBtn.disabled = true;
      $heroChooseBtnLabel.textContent = 'Enviando...';
      $heroPreview.dataset.loading = 'true';

      try {
        const formData = new FormData();
        formData.append('file', file);
        const res = await fetch('/api/upload', { method: 'POST', body: formData });
        if (!res.ok) {
          const err = await res.json().catch(() => ({})) as any;
          throw new Error(err.error || 'Falha no upload');
        }
        const { url } = await res.json() as { url: string };
        applyHeroValue(url, { schedule: true });
        window.toast?.('Imagem enviada', 'success');
      } catch (err: any) {
        console.error(err);
        window.toast?.(err.message || 'Erro ao enviar imagem', 'error');
      } finally {
        $heroChooseBtn.disabled = false;
        $heroChooseBtnLabel.textContent = 'Escolher arquivo';
        $heroPreview.dataset.loading = 'false';
        $heroFileInput.value = '';
      }
    });

    $heroRemoveBtn?.addEventListener('click', async () => {
      const ok = await window.confirmAction!({
        title: 'Remover imagem hero?',
        message: 'O arquivo permanece no R2 mas não fica mais vinculado ao post.',
        confirmLabel: 'Remover',
        cancelLabel: 'Cancelar',
        danger: true,
      });
      if (!ok) return;
      applyHeroValue('', { schedule: true });
    });

    $heroImageUrl?.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value;
      applyHeroValue(v, { schedule: true });
    });

    // ===== Data de publicacao: listeners =====
    $publishedAtNowBtn?.addEventListener('click', () => {
      $publishedAtInput.value = tsToLocalInput(Date.now());
      refreshPublishedAtHint();
      scheduleAutoSave();
    });
    $publishedAtInput?.addEventListener('input', () => {
      refreshPublishedAtHint();
      scheduleAutoSave();
    });

    // ===== Salvar = Publicar (post mode only) =====
    // 1 click finaliza auto-save pendente + dispara sync com Git.
    // Sem confirmAction — modelo WordPress.
    $btnSavePost.addEventListener('click', async () => {
      if (mode !== 'post' || !postSlug) return;

      if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; }
      if (hasChanges) await autoSave();

      $btnSavePost.disabled = true;
      const originalHtml = $btnSavePost.innerHTML;
      $btnSavePost.textContent = 'Salvando...';

      try {
        const res = await fetch(`/api/posts/${encodeURIComponent(postSlug)}/sync`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'desconhecido');
        }
        $saveStatus.textContent = `✓ Publicado às ${formatTime(new Date())} · rebuild em ~2 min`;
        $saveStatus.classList.remove('save-status-error');
        window.toast?.('Publicado! Rebuild em ~2 min.', 'success', 4000);
      } catch (err: any) {
        $saveStatus.textContent = `⚠ ${err.message || 'Erro ao publicar'}`;
        $saveStatus.classList.add('save-status-error');
        window.toast?.(err.message || 'Erro ao publicar', 'error', 6000);
      } finally {
        $btnSavePost.disabled = false;
        $btnSavePost.innerHTML = originalHtml;
      }
    });

    // Relabel do botao conforme a data: futura = "Agendar", senão "Publicar".
    function refreshPublishButton() {
      if (mode !== 'draft') return;
      $publishBtn.textContent = isFuturePublishedAt($publishedAtInput.value) ? 'Agendar' : 'Publicar';
    }

    // ===== Publicar / Agendar (draft mode only) =====
    $publishBtn.addEventListener('click', async () => {
      if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; }
      if (hasChanges) await autoSave();

      if (!draftId) {
        window.toast?.('Adicione título e conteúdo antes de publicar', 'error');
        return;
      }

      // === Agendamento: data futura → salva como "scheduled" (não publica agora) ===
      if (isFuturePublishedAt($publishedAtInput.value)) {
        const whenTs = localInputToTs($publishedAtInput.value) as number;
        const when = new Date(whenTs).toLocaleString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        const okSch = await window.confirmAction!({
          title: 'Agendar publicação?',
          message: `O post fica como "Agendado" para ${when} e será publicado automaticamente nesse horário (o robô verifica a cada ~15 min).`,
          confirmLabel: 'Agendar',
          cancelLabel: 'Cancelar',
        });
        if (!okSch) return;
        $publishBtn.disabled = true;
        $publishBtn.textContent = 'Agendando...';
        try {
          const res = await fetch(`/api/drafts/${draftId}`, {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ status: 'scheduled', scheduled_at: whenTs }),
          });
          if (!res.ok) {
            window.toast?.('Erro ao agendar', 'error');
          } else {
            window.toast?.(`Post agendado para ${when}`, 'success', 5000);
          }
        } catch {
          window.toast?.('Erro de rede ao agendar', 'error');
        } finally {
          $publishBtn.disabled = false;
          refreshPublishButton();
        }
        return;
      }

      const ok = await window.confirmAction!({
        title: 'Publicar este post?',
        message: 'Vai gerar o markdown no GitHub e o blog será reconstruído em ~1-2 min.',
        confirmLabel: 'Publicar',
        cancelLabel: 'Cancelar',
      });
      if (!ok) return;

      $publishBtn.disabled = true;
      $publishBtn.textContent = 'Publicando...';
      try {
        // Envia a data escolhida (passada/presente) p/ backdate; vazio = publica agora.
        const pickedTs = localInputToTs($publishedAtInput.value);
        const res = await fetch(`/api/drafts/${draftId}/publish`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(pickedTs !== null ? { published_at: pickedTs } : {}),
        });
        const data = await res.json();
        if (!res.ok) {
          window.toast?.('Erro: ' + (data.error || 'desconhecido'), 'error');
          $publishBtn.disabled = false;
          $publishBtn.textContent = 'Publicar';
          return;
        }
        window.toast?.(`Publicado! Rebuild em ~2 min`, 'success', 5000);
        $publishBtn.disabled = false;
        $publishBtn.textContent = 'Republicar';
      } catch (err) {
        window.toast?.('Erro de rede ao publicar', 'error');
        $publishBtn.disabled = false;
        $publishBtn.textContent = 'Publicar';
      }
    });

    // ===== Excluir =====
    $deleteBtn.addEventListener('click', async () => {
      if (mode === 'post') {
        if (!postSlug) return;
        const ok = await window.confirmAction!({
          title: 'Excluir este post?',
          message: 'O post será marcado como removido no painel. O arquivo no Git permanece intacto até a próxima sincronização.',
          confirmLabel: 'Excluir',
          cancelLabel: 'Cancelar',
          danger: true,
        });
        if (!ok) return;
        const res = await fetch(`/api/posts/${encodeURIComponent(postSlug)}`, { method: 'DELETE' });
        if (res.ok) {
          window.toast?.('Post excluído', 'success');
          setTimeout(() => { window.location.href = '/painel/posts'; }, 700);
        } else {
          window.toast?.('Erro ao excluir', 'error');
        }
        return;
      }

      if (!draftId) return;
      const ok = await window.confirmAction!({
        title: 'Excluir este rascunho?',
        message: 'Esta ação não pode ser desfeita.',
        confirmLabel: 'Excluir',
        cancelLabel: 'Cancelar',
        danger: true,
      });
      if (!ok) return;

      const res = await fetch(`/api/drafts/${draftId}`, { method: 'DELETE' });
      if (res.ok) {
        window.toast?.('Rascunho excluído', 'success');
        setTimeout(() => { window.location.href = '/painel/posts'; }, 700);
      } else {
        window.toast?.('Erro ao excluir', 'error');
      }
    });

    // === Featured toggle handler ===
    // Click no checkbox dispara API imediatamente (independe do botao Salvar).
    // Multiplos destaques: marcar/desmarcar este post nao afeta os demais.
    $isFeatured?.addEventListener('change', async (e) => {
      const cb = e.target as HTMLInputElement;
      const willFeature = cb.checked;

      if (!postSlug || mode !== 'post') {
        cb.checked = false;
        return;
      }

      cb.disabled = true;
      try {
        const res = await fetch(`/api/posts/${encodeURIComponent(postSlug)}/feature`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_featured: willFeature }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Falha ao alterar destaque');

        // Sync automatico (modelo Salvar=Publicar): commita o .md deste post
        // com (ou sem) "featured: true" no frontmatter.
        try {
          const syncRes = await fetch(`/api/posts/${encodeURIComponent(postSlug)}/sync`, { method: 'POST' });
          if (!syncRes.ok) {
            const syncErr = await syncRes.json().catch(() => ({})) as any;
            throw new Error(syncErr.error || 'Falha ao publicar destaque');
          }
        } catch (syncErr: any) {
          window.toast?.(`Destaque salvo no painel, mas sync falhou: ${syncErr.message}`, 'error', 6000);
          await updateFeaturedHint();
          return;
        }

        if (willFeature) {
          window.toast?.('★ Post adicionado ao carrossel de destaques! Rebuild em ~2 min.', 'success', 5000);
        } else {
          window.toast?.('Destaque removido. Rebuild em ~2 min.', 'info', 5000);
        }
        await updateFeaturedHint();
      } catch (err: any) {
        window.toast?.(err.message || 'Erro ao alterar destaque', 'error', 5000);
        cb.checked = !willFeature;
      } finally {
        cb.disabled = false;
      }
    });

    if (mode === 'post') {
      loadPost();
    } else if (initialId) {
      loadDraft();
    }
  </script>

  <style is:global>
    /* === EDITOR HEADER (sub-header dentro do main) === */
