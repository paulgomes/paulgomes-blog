      line-height: 1.4;
    }
    .desc-input::placeholder { color: var(--painel-text-disabled); }

    /* TipTap (.editor-wrapper) sobrescreve com tokens novos */
    .editor-main .editor-wrapper {
      border: 1px solid var(--painel-border);
      border-radius: var(--painel-radius);
      background: var(--painel-surface);
    }
    .editor-main .editor-toolbar {
      background: var(--painel-bg);
      border-bottom: 1px solid var(--painel-border);
      border-radius: var(--painel-radius) var(--painel-radius) 0 0;
    }

    .editor-main .editor-meta {
      margin-top: 16px;
      font-size: 12px;
      color: var(--painel-text-disabled);
    }

    /* === SIDE PANEL === */
    .editor-side {
