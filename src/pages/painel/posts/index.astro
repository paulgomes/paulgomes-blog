---
import PainelLayout from '../../../components/painel/PainelLayout.astro';
import { TAGS } from '../../../lib/tags';
import '../../../styles/painel.css';
---

<PainelLayout title="Posts — Painel" description="Lista de posts" current="posts">
  <section class="page-header">
    <h1>Posts</h1>
    <p class="subtitle">Gerencie rascunhos e publicados.</p>
  </section>

  <div class="posts-toolbar">
    <label class="field field--search">
      <svg class="field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="searchInput" type="search" placeholder="Buscar por título..." autocomplete="off" />
    </label>
    <label class="field field--select">
      <select id="tagFilter">
        <option value="">Todas as tags</option>
        {TAGS.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
    <a href="/painel/posts/editor" class="btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo post
    </a>
  </div>

  <div class="filter-pills" role="tablist">
    <button class="pill is-active" data-filter="all" role="tab">Todos</button>
    <button class="pill" data-filter="draft" role="tab">Rascunhos</button>
    <button class="pill" data-filter="published" role="tab">Publicados</button>
    <button class="pill" data-filter="scheduled" role="tab">Agendados</button>
    <button class="pill pill--trash" data-filter="deleted" role="tab">
      Lixeira
      <span id="countDeleted" class="pill-count">—</span>
    </button>
  </div>

  <div id="postsList" class="posts-list">
    <p class="muted">Carregando...</p>
  </div>

  <div id="pagination" class="posts-pagination hidden">
    <button id="prevPage" class="pag-btn" disabled>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Anterior
    </button>
    <span id="pageInfo" class="pag-info"></span>
    <button id="nextPage" class="pag-btn" disabled>
      Próximo
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <script>
    const PER_PAGE = 50;
    let currentStatus = 'all';
    let currentQ = '';
    let currentTag = '';
    let currentPage = 1;
    let totalPages = 1;
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function badgeClass(status: string) {
      if (status === 'published') return 'badge2 badge2--published';
      if (status === 'scheduled') return 'badge2 badge2--scheduled';
      return 'badge2 badge2--draft';
    }
    function badgeLabel(status: string) {
      if (status === 'published') return 'Publicado';
      if (status === 'scheduled') return 'Agendado';
      return 'Rascunho';
    }

    function readUrlState() {
      const u = new URL(window.location.href);
      currentStatus = u.searchParams.get('status') || 'all';
      currentQ = u.searchParams.get('q') || '';
      currentTag = u.searchParams.get('tag') || '';
      currentPage = Math.max(1, parseInt(u.searchParams.get('page') || '1', 10));

      (document.getElementById('searchInput') as HTMLInputElement).value = currentQ;
      (document.getElementById('tagFilter') as HTMLSelectElement).value = currentTag;
      document.querySelectorAll<HTMLButtonElement>('.pill').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.filter === currentStatus);
      });
    }

    function writeUrlState(replace = false) {
      const u = new URL(window.location.href);
      u.searchParams.set('status', currentStatus);
      if (currentQ) u.searchParams.set('q', currentQ); else u.searchParams.delete('q');
      if (currentTag) u.searchParams.set('tag', currentTag); else u.searchParams.delete('tag');
      if (currentPage > 1) u.searchParams.set('page', String(currentPage)); else u.searchParams.delete('page');
      const method = replace ? 'replaceState' : 'pushState';
      window.history[method](null, '', u.toString());
    }

    async function loadPosts() {
      const params = new URLSearchParams();
      params.set('status', currentStatus);
      if (currentQ) params.set('q', currentQ);
      if (currentTag) params.set('tag', currentTag);
      params.set('page', String(currentPage));
      params.set('per_page', String(PER_PAGE));

      const container = document.getElementById('postsList');
      if (container) container.innerHTML = `<p class="muted">Carregando...</p>`;

      const res = await fetch(`/api/posts?${params.toString()}`);
      if (res.status === 401) {
        window.location.href = '/painel/login';
        return;
      }
      const data = await res.json();
      totalPages = data.total_pages || 1;
      renderItems(data.items || []);
      renderPagination(data.total || 0);
    }

    function renderItems(items: any[]) {
      const container = document.getElementById('postsList');
      if (!container) return;
      const isTrash = currentStatus === 'deleted';

      if (!items.length) {
        const emptyMsg = isTrash
          ? `<p style="margin:0;font-weight:500;color:var(--painel-text-primary)">Lixeira vazia</p>
             <p style="margin:4px 0 0;font-size:13px">Posts deletados aparecem aqui pra serem restaurados ou excluídos pra sempre.</p>`
          : `<p style="margin:0;font-weight:500;color:var(--painel-text-primary)">Nenhum post encontrado</p>
             <p style="margin:4px 0 0;font-size:13px">Ajuste os filtros ou crie um novo post.</p>`;
        container.innerHTML = `
          <div class="empty-state">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:.4;margin-bottom:12px">${isTrash ? '<polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>' : '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>'}</svg>
            ${emptyMsg}
          </div>`;
        return;
      }

      container.innerHTML = items.map((it: any) => {
        const isDraft = it.type === 'draft';
        const editorHref = isDraft
          ? `/painel/posts/editor?id=${encodeURIComponent(it.id.replace(/^draft:/, ''))}`
          : `/painel/posts/editor?slug=${encodeURIComponent(it.slug)}`;
        const deletePath = isDraft
          ? `/api/drafts/${encodeURIComponent(it.id.replace(/^draft:/, ''))}`
          : `/api/posts/${encodeURIComponent(it.slug)}`;
        const dateTs = Number(it.updated_at || it.published_at || 0);
        const dateLabel = dateTs ? new Date(dateTs).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
        const syncBadge = !isDraft && it.git_synced === 0
          ? `<span class="badge2 badge2--unsynced" title="Alterações pendentes de sincronização com Git">● Não sincronizado</span>`
          : '';
        const thumb = it.hero_image_url
          ? `<img src="${escapeHtml(it.hero_image_url)}" alt="" loading="lazy" />`
          : `<div class="thumb-placeholder"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>`;
        const title = escapeHtml(it.title || 'Sem título');
        const desc = escapeHtml(it.description || '');

        // Trash mode: sem link, sem badge de status, 2 botoes de acao
        if (isTrash) {
          return `
            <article class="post-row post-row--deleted" data-id="${escapeHtml(it.id)}">
              <div class="post-row__link">
                <div class="post-row__thumb">${thumb}</div>
                <div class="post-row__body">
                  <div class="post-row__meta">
                    <span class="badge2 badge2--deleted">🗑 Deletado</span>
                    <span class="post-row__date">${dateLabel}</span>
                  </div>
                  <h3 class="post-row__title">${title}</h3>
                  <p class="post-row__desc">${desc}</p>
                </div>
              </div>
              <div class="post-row__trash-actions">
                <button class="btn-restore" data-restore="${escapeHtml(it.slug)}" data-title="${title}">★ Restaurar</button>
                <button class="btn-purge" data-purge="${escapeHtml(it.slug)}" data-title="${title}">✕ Excluir Permanentemente</button>
              </div>
            </article>
          `;
        }

        return `
          <article class="post-row" data-id="${escapeHtml(it.id)}">
            <a href="${editorHref}" class="post-row__link">
              <div class="post-row__thumb">${thumb}</div>
              <div class="post-row__body">
                <div class="post-row__meta">
                  <span class="${badgeClass(it.status)}">${badgeLabel(it.status)}</span>
                  ${syncBadge}
                  <span class="post-row__date">${dateLabel}</span>
                </div>
                <h3 class="post-row__title">${title}</h3>
                <p class="post-row__desc">${desc}</p>
              </div>
            </a>
            <button class="post-row__delete" data-delete-path="${escapeHtml(deletePath)}" data-delete-title="${title}" aria-label="Excluir">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
            </button>
          </article>
        `;
      }).join('');

      container.querySelectorAll<HTMLButtonElement>('[data-delete-path]').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const path = btn.dataset.deletePath!;
          const title = btn.dataset.deleteTitle || 'este post';
          const ok = await window.confirmAction!({
            title: 'Excluir post?',
            message: `Tem certeza que quer excluir "${title}"? O post some do site e do painel — fica na Lixeira pra recuperação.`,
            confirmLabel: 'Excluir',
            cancelLabel: 'Cancelar',
            danger: true,
          });
          if (!ok) return;
          const r = await fetch(path, { method: 'DELETE' });
          if (r.ok) {
            window.toast?.('Post movido pra Lixeira', 'success');
            loadPosts();
            updateDeletedCounter();
          } else {
            window.toast?.('Erro ao excluir', 'error');
          }
        });
      });

      // === RESTORE ===
      container.querySelectorAll<HTMLButtonElement>('[data-restore]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = btn.dataset.restore!;
          const title = btn.dataset.title || slug;
          const ok = await window.confirmAction!({
            title: 'Restaurar post?',
            message: `O post "${title}" volta a ficar publicado em paulgomes.com.br após ~2 min.`,
            confirmLabel: 'Restaurar',
            cancelLabel: 'Cancelar',
          });
          if (!ok) return;
          btn.disabled = true;
          try {
            const res = await fetch(`/api/posts/${encodeURIComponent(slug)}/restore`, { method: 'POST' });
            const data = await res.json();
            if (!res.ok) {
              if (res.status === 422) {
                window.toast?.('Este post não tem conteúdo no painel — não pode ser restaurado automaticamente.', 'error', 6000);
              } else {
                throw new Error(data.error || 'Falha ao restaurar');
              }
              return;
            }
            window.toast?.(`★ "${data.title}" restaurado. Rebuild em ~2 min.`, 'success', 5000);
            loadPosts();
            updateDeletedCounter();
          } catch (err: any) {
            window.toast?.(err.message || 'Erro ao restaurar', 'error', 5000);
          } finally {
            btn.disabled = false;
          }
        });
      });

      // === PURGE (hard delete) ===
      container.querySelectorAll<HTMLButtonElement>('[data-purge]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = btn.dataset.purge!;
          const title = btn.dataset.title || slug;
          const ok = await window.confirmAction!({
            title: '⚠️ Excluir permanentemente?',
            message: `O post "${title}" será REMOVIDO PARA SEMPRE do painel e do Git. Esta ação NÃO pode ser desfeita.`,
            confirmLabel: 'Sim, excluir para sempre',
            cancelLabel: 'Cancelar',
            danger: true,
          });
          if (!ok) return;
          btn.disabled = true;
          try {
            const res = await fetch(`/api/posts/${encodeURIComponent(slug)}/purge`, { method: 'DELETE' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Falha ao excluir permanentemente');
            const extra = data.git_already_removed ? ' (Git já estava limpo)' : '';
            window.toast?.(`✕ "${data.title}" removido permanentemente${extra}.`, 'success', 5000);
            loadPosts();
            updateDeletedCounter();
          } catch (err: any) {
            window.toast?.(err.message || 'Erro ao excluir', 'error', 5000);
          } finally {
            btn.disabled = false;
          }
        });
      });
    }

    async function updateDeletedCounter() {
      const el = document.getElementById('countDeleted');
      if (!el) return;
      try {
        const res = await fetch('/api/posts?status=deleted&per_page=1');
        if (!res.ok) return;
        const data = await res.json();
        el.textContent = String(data.total || 0);
      } catch {}
    }

    function renderPagination(total: number) {
      const pag = document.getElementById('pagination');
      const info = document.getElementById('pageInfo');
      const prev = document.getElementById('prevPage') as HTMLButtonElement;
      const next = document.getElementById('nextPage') as HTMLButtonElement;
      if (!pag || !info || !prev || !next) return;

      if (total <= PER_PAGE) {
        pag.classList.add('hidden');
        return;
      }
      pag.classList.remove('hidden');
      info.textContent = `Página ${currentPage} de ${totalPages} · ${total} ${total === 1 ? 'item' : 'itens'}`;
      prev.disabled = currentPage <= 1;
      next.disabled = currentPage >= totalPages;
    }

    // === Bindings ===
    document.querySelectorAll<HTMLButtonElement>('.pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.pill').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentStatus = btn.dataset.filter || 'all';
        currentPage = 1;
        writeUrlState();
        loadPosts();
      });
    });

    document.getElementById('searchInput')?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        currentQ = val.trim();
        currentPage = 1;
        writeUrlState();
        loadPosts();
      }, 300);
    });

    document.getElementById('tagFilter')?.addEventListener('change', (e) => {
      currentTag = (e.target as HTMLSelectElement).value;
      currentPage = 1;
      writeUrlState();
      loadPosts();
    });

    document.getElementById('prevPage')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        writeUrlState();
        loadPosts();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    document.getElementById('nextPage')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        writeUrlState();
        loadPosts();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    window.addEventListener('popstate', () => {
      readUrlState();
      loadPosts();
    });

    readUrlState();
    writeUrlState(true);
    loadPosts();
    updateDeletedCounter();
  </script>

  <style is:global>
    /* === TOOLBAR (search + tag + cta) === */
    .posts-toolbar {
      display: grid;
      grid-template-columns: 1fr 200px auto;
      gap: 12px;
      margin-bottom: 20px;
    }
    @media (max-width: 720px) {
      .posts-toolbar {
        grid-template-columns: 1fr;
      }
      .posts-toolbar .btn-primary { justify-content: center; }
    }
    .field {
      position: relative;
      display: flex;
      align-items: center;
      background: var(--painel-surface);
      border: 1px solid var(--painel-border);
      border-radius: var(--painel-radius);
      padding: 0 12px;
      height: 40px;
      transition: border-color .15s, box-shadow .15s;
    }
    .field:hover { border-color: var(--painel-border-strong); }
    .field:focus-within {
      border-color: var(--painel-accent);
      box-shadow: 0 0 0 3px rgba(26,115,232,0.15);
    }
    .field-icon { color: var(--painel-text-secondary); flex-shrink: 0; }
    .field input,
    .field select {
      border: 0;
      background: transparent;
      outline: 0;
      width: 100%;
      font-family: var(--painel-font);
      font-size: 14px;
      color: var(--painel-text-primary);
      padding: 0 8px;
    }
    .field select { cursor: pointer; appearance: none; padding-right: 24px; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235f6368' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>"); background-repeat: no-repeat; background-position: right 8px center; background-size: 16px; }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 40px;
      padding: 0 18px;
      background: var(--painel-accent);
      color: #fff;
      border: 0;
      border-radius: var(--painel-radius);
      font-family: var(--painel-font);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      transition: background .15s, box-shadow .15s;
    }
    .btn-primary:hover { background: var(--painel-accent-hover); box-shadow: var(--painel-shadow-sm); }

    /* === FILTER PILLS === */
    .filter-pills {
      display: flex;
      gap: 8px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }
    .pill {
      padding: 6px 16px;
      background: var(--painel-surface);
      border: 1px solid var(--painel-border);
      border-radius: 999px;
      color: var(--painel-text-secondary);
      font-family: var(--painel-font);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background .15s, color .15s, border-color .15s;
    }
    .pill:hover {
      background: rgba(60,64,67,0.04);
      color: var(--painel-text-primary);
    }
    .pill.is-active {
      background: var(--painel-accent-soft);
      color: var(--painel-accent);
      border-color: #c9dcfa;
    }

    /* === POSTS LIST === */
    .posts-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .muted { color: var(--painel-text-secondary); font-size: 14px; }

    .post-row {
      display: flex;
      align-items: stretch;
      background: var(--painel-surface);
      border: 1px solid var(--painel-border);
      border-radius: var(--painel-radius);
      overflow: hidden;
      transition: border-color .15s, box-shadow .15s;
    }
    .post-row:hover {
      border-color: var(--painel-border-strong);
      box-shadow: var(--painel-shadow-sm);
    }
    .post-row__link {
      flex: 1;
      min-width: 0;
      display: flex;
      gap: 16px;
      padding: 12px;
      text-decoration: none;
      color: inherit;
    }
    .post-row__thumb {
      flex-shrink: 0;
      width: 120px;
      height: 80px;
      border-radius: 6px;
      overflow: hidden;
      background: #f1f3f4;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .post-row__thumb img { width: 100%; height: 100%; object-fit: cover; }
    .thumb-placeholder { color: var(--painel-text-disabled); }
    .post-row__body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
    .post-row__meta { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap; }
    .post-row__date {
      font-size: 12px;
      color: var(--painel-text-disabled);
      margin-left: auto;
    }
    .post-row__title {
      font-size: 16px;
      font-weight: 500;
      color: var(--painel-text-primary);
      margin: 0 0 4px;
      line-height: 1.3;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
    }
    .post-row__desc {
      font-size: 14px;
      color: var(--painel-text-secondary);
      margin: 0;
      line-height: 1.4;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
    }
    .post-row__delete {
      flex-shrink: 0;
      width: 44px;
      background: transparent;
      border: 0;
      border-left: 1px solid var(--painel-border);
      color: var(--painel-text-disabled);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s, color .15s;
    }
    .post-row__delete:hover {
      background: #fce8e6;
      color: var(--painel-danger);
    }
    @media (max-width: 640px) {
      .post-row__thumb { width: 80px; height: 60px; }
      .post-row__link { padding: 10px; gap: 12px; }
      .post-row__date { margin-left: 0; }
    }

    /* === BADGES (versão D) === */
    .badge2 {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 500;
      line-height: 1.5;
    }
    .badge2--published { background: #e6f4ea; color: #1e8e3e; }
    .badge2--draft     { background: #f1f3f4; color: #5f6368; }
    .badge2--scheduled { background: #e8f0fe; color: #1a73e8; }
    .badge2--unsynced  { background: #feefc3; color: #b06000; }
    .badge2--deleted   { background: #f1f3f4; color: #5f6368; font-weight: 600; }

    /* === LIXEIRA — pill + counter === */
    .pill--trash {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .pill-count {
      display: inline-block;
      min-width: 18px;
      padding: 1px 6px;
      border-radius: 999px;
      background: var(--painel-bg);
      color: var(--painel-text-secondary);
      font-size: 11px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      line-height: 1.4;
    }
    .pill--trash.is-active .pill-count {
      background: var(--painel-accent-soft);
      color: var(--painel-accent);
    }

    /* === ROW LIXEIRA — visual desaturado + 2 botoes === */
    .post-row--deleted {
      background: var(--painel-bg);
      opacity: 0.85;
    }
    .post-row--deleted:hover {
      box-shadow: none;
      border-color: var(--painel-border);
    }
    .post-row--deleted .post-row__link {
      cursor: default;
    }
    .post-row--deleted .post-row__title {
      text-decoration: line-through;
      color: var(--painel-text-secondary);
    }
    .post-row--deleted .post-row__thumb {
      filter: grayscale(0.6);
    }

    .post-row__trash-actions {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 12px;
      border-left: 1px solid var(--painel-border);
    }
    .btn-restore,
    .btn-purge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 12px;
      border-radius: var(--painel-radius);
      font-family: var(--painel-font);
      font-size: 12px;
      font-weight: 500;
      background: var(--painel-surface);
      border: 1px solid var(--painel-border);
      cursor: pointer;
      transition: background .15s, border-color .15s, color .15s;
      white-space: nowrap;
    }
    .btn-restore { color: var(--painel-success); }
    .btn-restore:hover {
      background: #e6f4ea;
      border-color: var(--painel-success);
    }
    .btn-purge { color: var(--painel-danger); }
    .btn-purge:hover {
      background: #fce8e6;
      border-color: var(--painel-danger);
    }
    .btn-restore:disabled,
    .btn-purge:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    @media (max-width: 640px) {
      .post-row__trash-actions {
        flex-direction: column;
        padding: 8px;
      }
      .btn-restore, .btn-purge { font-size: 11px; padding: 4px 8px; }
    }

    /* === PAGINATION === */
    .posts-pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid var(--painel-border);
    }
    .posts-pagination.hidden { display: none; }
    .pag-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--painel-surface);
      border: 1px solid var(--painel-border);
      border-radius: var(--painel-radius);
      color: var(--painel-text-primary);
      font-family: var(--painel-font);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background .15s, border-color .15s;
    }
    .pag-btn:hover:not(:disabled) {
      background: rgba(60,64,67,0.04);
      border-color: var(--painel-border-strong);
    }
    .pag-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .pag-info {
      font-size: 13px;
      color: var(--painel-text-secondary);
    }
  </style>
</PainelLayout>
