---
import PainelLayout from '../../components/painel/PainelLayout.astro';
import '../../styles/painel.css';
---

<PainelLayout title="Importar — Painel" description="Importar conteúdo de outras plataformas" current="import">
  <section class="page-header">
    <h1>Importar conteúdo</h1>
    <p class="subtitle">Traga posts de outra plataforma (WordPress, etc.) — o conteúdo é convertido para o formato nativo e mostrado em prévia, tudo no seu navegador.</p>
  </section>

  <section class="imp-card">
    <div class="imp-row">
      <label class="imp-field">
        <span class="imp-label">Origem</span>
        <select id="impConnector" class="imp-input">
          <option value="wordpress-xml">WordPress (export XML / WXR)</option>
        </select>
      </label>
      <label class="imp-field">
        <span class="imp-label">Limite (opcional)</span>
        <input id="impLimit" class="imp-input" type="number" min="1" placeholder="todos" />
      </label>
    </div>

    <label class="imp-drop" id="impDrop">
      <input id="impFile" type="file" accept=".xml,application/xml,text/xml" hidden />
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      <span class="imp-drop-text" id="impDropText">Clique para escolher o arquivo .xml</span>
    </label>

    <div class="imp-actions">
      <button type="button" id="impAnalyze" class="imp-btn imp-btn--primary" disabled>Analisar</button>
      <span id="impStatus" class="imp-status"></span>
    </div>
  </section>

  <section id="impResult" hidden>
    <div class="imp-mapping" id="impMapping" hidden>
      <p class="imp-map-title">Mapear categorias da origem → categorias do site <span class="imp-muted">(as não mapeadas ficam sem categoria)</span></p>
      <div class="imp-map-grid" id="impMapGrid"></div>
      <button type="button" id="impReapply" class="imp-btn imp-btn--primary imp-btn--sm">Reaplicar mapeamento</button>
    </div>

    <div class="imp-summary" id="impSummary"></div>
    <div class="imp-toolbar">
      <button type="button" id="impCreateDrafts" class="imp-btn imp-btn--primary">Criar rascunhos no painel</button>
      <button type="button" id="impDownloadAll" class="imp-btn">Baixar todos os .md</button>
      <span id="impCreateStatus" class="imp-status"></span>
    </div>
    <p class="imp-note">Os rascunhos aparecem em <a href="/painel/posts?status=draft">Posts → Rascunhos</a> para você revisar e publicar pelo fluxo normal — nada vai ao ar sem sua revisão. (Para commitar direto no repositório via CLI: <code>node dist/cli/import.js --source &lt;arquivo&gt; --publish</code>.)</p>
    <div class="imp-table-wrap">
      <table class="imp-table">
        <thead>
          <tr><th>Título</th><th>Slug</th><th>Data</th><th>Categorias</th><th>Status</th><th></th></tr>
        </thead>
        <tbody id="impRows"></tbody>
      </table>
    </div>
  </section>

  <script>
    import { runImport, KNOWN_CATEGORIES } from '../../lib/migration-engine.browser.js';

    const byId = (id: string) => document.getElementById(id)!;
    const $connector = byId('impConnector') as HTMLSelectElement;
    const $limit = byId('impLimit') as HTMLInputElement;
    const $file = byId('impFile') as HTMLInputElement;
    const $dropText = byId('impDropText');
    const $analyze = byId('impAnalyze') as HTMLButtonElement;
    const $status = byId('impStatus');
    const $result = byId('impResult');
    const $summary = byId('impSummary');
    const $rows = byId('impRows');
    const $downloadAll = byId('impDownloadAll');
    const $createDrafts = byId('impCreateDrafts') as HTMLButtonElement;
    const $createStatus = byId('impCreateStatus');
    const $mapping = byId('impMapping');
    const $mapGrid = byId('impMapGrid');
    const $reapply = byId('impReapply');

    const noopLogger: any = { debug() {}, info() {}, warn() {}, error() {}, child() { return noopLogger; } };
    let lastPosts: any[] = [];
    let lastXml = '';

    function esc(s: string): string {
      return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    }
    function download(name: string, content: string) {
      const blob = new Blob([content], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = name; document.body.appendChild(a); a.click();
      a.remove(); URL.revokeObjectURL(url);
    }

    $file.addEventListener('change', () => {
      const f = $file.files && $file.files[0];
      $dropText.textContent = f ? f.name : 'Clique para escolher o arquivo .xml';
      $analyze.disabled = !f;
    });

    async function analyze(xml: string, mapping: Record<string, string>) {
      $analyze.disabled = true; $status.textContent = 'Analisando…';
      try {
        const limit = $limit.value ? Number($limit.value) : undefined;
        const result = await runImport({
          connectorId: $connector.value, source: 'upload', sourceContent: xml,
          categoryMapping: mapping, allowedCategories: KNOWN_CATEGORIES, limit,
          logger: noopLogger, signal: AbortSignal.timeout(120000), secrets: { get: async () => undefined },
        });
        lastPosts = result.posts; lastXml = xml;
        renderSummary(result.report);
        renderRows(result.posts);
        renderMapping(result.posts, mapping);
        $result.hidden = false;
        $status.textContent = `Concluído: ${result.report.totals.posts} artigos.`;
      } catch (err: any) {
        $status.textContent = 'Erro: ' + (err && err.message ? err.message : String(err));
      } finally {
        $analyze.disabled = false;
      }
    }

    function renderSummary(r: any) {
      $summary.innerHTML =
        `<span class="imp-stat"><b>${r.totals.posts}</b> artigos</span>` +
        `<span class="imp-stat"><b>${r.seoPreserved}</b> com data</span>` +
        `<span class="imp-stat"><b>${r.duplicated}</b> duplicados</span>` +
        `<span class="imp-stat ${r.errors ? 'imp-stat--err' : ''}"><b>${r.errors}</b> erros</span>` +
        `<span class="imp-stat">${r.durationMs} ms</span>`;
    }

    function renderRows(posts: any[]) {
      $rows.innerHTML = posts.map((p) => {
        const cats = p.categorias.length ? p.categorias.map((c: string) => `<span class="imp-chip">${esc(c)}</span>`).join('') : '<span class="imp-muted">—</span>';
        const st = p.status === 'ok' ? 'ok' : (p.status === 'needs-review' ? 'rev' : 'empty');
        const pub = (p.content.match(/pubDate:\s*([0-9-]+)/) || [])[1] || '';
        return `<tr>
          <td class="imp-title">${esc(p.title)}</td>
          <td><code>${esc(p.slug)}</code></td>
          <td>${esc(pub)}</td>
          <td>${cats}</td>
          <td><span class="imp-badge imp-badge--${st}">${esc(p.status)}</span></td>
          <td><button type="button" class="imp-btn imp-btn--sm" data-slug="${esc(p.slug)}">Baixar</button></td>
        </tr>`;
      }).join('');
      $rows.querySelectorAll('button[data-slug]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const slug = (btn as HTMLElement).dataset.slug as string;
          const post = lastPosts.find((x) => x.slug === slug);
          if (post) download(slug + '.md', post.content);
        });
      });
    }

    function renderMapping(posts: any[], mapping: Record<string, string>) {
      const enumSet = new Set(KNOWN_CATEGORIES as readonly string[]);
      const raw = new Set<string>();
      posts.forEach((p) => p.rawCategories.forEach((c: string) => { if (!enumSet.has(c)) raw.add(c); }));
      const list = [...raw].sort();
      if (!list.length) { $mapping.hidden = true; return; }
      $mapGrid.innerHTML = list.map((c) => {
        const opts = ['<option value="">— ignorar —</option>']
          .concat((KNOWN_CATEGORIES as readonly string[]).map((k) => `<option value="${esc(k)}"${mapping[c] === k ? ' selected' : ''}>${esc(k)}</option>`))
          .join('');
        return `<label class="imp-map-row"><span class="imp-map-raw">${esc(c)}</span><select class="imp-input" data-raw="${esc(c)}">${opts}</select></label>`;
      }).join('');
      $mapping.hidden = false;
    }

    $analyze.addEventListener('click', async () => {
      const f = $file.files && $file.files[0];
      if (!f) return;
      await analyze(await f.text(), {});
    });

    $reapply.addEventListener('click', () => {
      const mapping: Record<string, string> = {};
      $mapGrid.querySelectorAll('select[data-raw]').forEach((sel) => {
        const raw = (sel as HTMLElement).dataset.raw as string;
        const val = (sel as HTMLSelectElement).value;
        if (val) mapping[raw] = val;
      });
      analyze(lastXml, mapping);
    });

    $downloadAll.addEventListener('click', () => {
      lastPosts.forEach((p, i) => setTimeout(() => download(p.slug + '.md', p.content), i * 60));
    });

    // Cria um rascunho por post via /api/drafts (endpoint existente, auth-protegido).
    // Reusa o fluxo testado: NAO publica direto — entra em Posts > Rascunhos para revisao.
    $createDrafts.addEventListener('click', async () => {
      if (!lastPosts.length) return;
      if (!confirm(`Criar ${lastPosts.length} rascunho(s) no painel?`)) return;
      $createDrafts.disabled = true; $downloadAll.disabled = true;
      let ok = 0, fail = 0;
      for (let i = 0; i < lastPosts.length; i++) {
        const p = lastPosts[i];
        try {
          const res = await fetch('/api/drafts', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug: p.slug, title: p.title, description: p.description, content_md: p.bodyMarkdown, categorias: p.categorias }),
          });
          if (res.ok) ok++; else fail++;
        } catch { fail++; }
        $createStatus.textContent = `Criando rascunhos… ${i + 1}/${lastPosts.length}`;
      }
      $createStatus.innerHTML = `✓ ${ok} rascunho(s) criado(s)${fail ? `, ${fail} falha(s)` : ''}. <a href="/painel/posts?status=draft">Ver rascunhos →</a>`;
      $createDrafts.disabled = false; $downloadAll.disabled = false;
    });
  </script>

  <style>
    .imp-card { background: var(--painel-surface); border: 1px solid var(--painel-border); border-radius: var(--painel-radius); padding: 24px; margin-bottom: 24px; }
    .imp-row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
    .imp-field { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 180px; }
    .imp-label { font-size: 12px; font-weight: 600; color: var(--painel-text-secondary); text-transform: uppercase; letter-spacing: .04em; }
    .imp-input { font-family: var(--painel-font); font-size: 14px; padding: 9px 12px; border: 1px solid var(--painel-border); border-radius: 8px; background: var(--painel-bg); color: var(--painel-text-primary); }
    .imp-drop { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 32px; border: 1.5px dashed var(--painel-border-strong, var(--painel-border)); border-radius: 10px; color: var(--painel-text-secondary); cursor: pointer; transition: background .15s, border-color .15s; }
    .imp-drop:hover { background: rgba(2,3,252,0.03); border-color: var(--painel-accent, #0203fc); }
    .imp-drop-text { font-size: 14px; }
    .imp-actions { display: flex; align-items: center; gap: 16px; margin-top: 16px; }
    .imp-status { font-size: 13px; color: var(--painel-text-secondary); }
    .imp-btn { font-family: var(--painel-font); font-size: 14px; font-weight: 500; cursor: pointer; padding: 9px 18px; border-radius: 999px; border: 1px solid var(--painel-border); background: var(--painel-surface); color: var(--painel-text-primary); transition: background .15s, border-color .15s, opacity .15s; }
    .imp-btn:hover { background: rgba(60,64,67,0.05); }
    .imp-btn:disabled { opacity: .5; cursor: not-allowed; }
    .imp-btn--primary { background: var(--painel-accent, #0203fc); color: #fff; border-color: transparent; }
    .imp-btn--primary:hover { filter: brightness(1.08); background: var(--painel-accent, #0203fc); }
    .imp-btn--sm { padding: 5px 12px; font-size: 12px; }
    .imp-mapping { background: var(--painel-surface); border: 1px solid var(--painel-border); border-radius: var(--painel-radius); padding: 18px 20px; margin-bottom: 20px; }
    .imp-map-title { font-size: 13px; font-weight: 600; margin: 0 0 14px; color: var(--painel-text-primary); }
    .imp-map-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px 16px; margin-bottom: 16px; }
    .imp-map-row { display: flex; align-items: center; gap: 10px; }
    .imp-map-raw { flex: 1; font-size: 13px; color: var(--painel-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .imp-map-row select { flex: 0 0 150px; }
    .imp-summary { display: flex; gap: 22px; flex-wrap: wrap; margin-bottom: 16px; }
    .imp-stat { font-size: 14px; color: var(--painel-text-secondary); }
    .imp-stat b { font-size: 20px; color: var(--painel-text-primary); margin-right: 5px; }
    .imp-stat--err b { color: #c0392b; }
    .imp-toolbar { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 14px; }
    .imp-note { font-size: 12.5px; color: var(--painel-text-secondary); }
    .imp-note code { background: var(--painel-bg); padding: 2px 6px; border-radius: 5px; font-size: 12px; }
    .imp-table-wrap { overflow-x: auto; border: 1px solid var(--painel-border); border-radius: var(--painel-radius); }
    .imp-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .imp-table th, .imp-table td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--painel-border); vertical-align: middle; }
    .imp-table th { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--painel-text-secondary); font-weight: 600; }
    .imp-table tr:last-child td { border-bottom: 0; }
    .imp-title { font-weight: 500; max-width: 320px; }
    .imp-table code { font-size: 12px; color: var(--painel-text-secondary); }
    .imp-chip { display: inline-block; background: var(--painel-accent-soft, rgba(2,3,252,.08)); color: var(--painel-accent, #0203fc); font-size: 11px; padding: 2px 8px; border-radius: 999px; margin: 1px 3px 1px 0; }
    .imp-muted { color: var(--painel-text-secondary); }
    .imp-badge { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 999px; }
    .imp-badge--ok { background: rgba(39,174,96,.12); color: #1e8449; }
    .imp-badge--rev { background: rgba(243,156,18,.15); color: #b9770e; }
    .imp-badge--empty { background: rgba(192,57,43,.12); color: #c0392b; }
  </style>
</PainelLayout>
