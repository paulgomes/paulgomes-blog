---
import PainelLayout from '../../components/painel/PainelLayout.astro';
import '../../styles/painel.css';
---

<PainelLayout title="Painel — Paul Gomes" description="Painel administrativo" current="home">
  <section class="page-header">
    <h1>Visão geral</h1>
    <p class="subtitle" id="welcomeSubtitle">Bem-vindo de volta.</p>
  </section>

  <section class="stats-grid">
    <a href="/painel/posts" class="stat-card">
      <p class="label">Total</p>
      <p class="value" id="statTotal"><span class="stat-skeleton"></span></p>
    </a>
    <a href="/painel/posts?status=draft" class="stat-card">
      <p class="label">Rascunhos</p>
      <p class="value" id="statDrafts"><span class="stat-skeleton"></span></p>
    </a>
    <a href="/painel/posts?status=published" class="stat-card">
      <p class="label">Publicados</p>
      <p class="value" id="statPublished"><span class="stat-skeleton"></span></p>
    </a>
    <div class="stat-card stat-card--warn" id="statUnsyncedCard">
      <p class="label">Não sincronizados</p>
      <p class="value" id="statUnsynced"><span class="stat-skeleton"></span></p>
      <p class="hint">Editados no painel, pendentes de Git</p>
      <button type="button" id="bulkSyncBtn" class="bulk-sync-btn" hidden>
        Marcar todos como sincronizados
      </button>
    </div>
    <a href="/painel/posts?status=deleted" class="stat-card stat-card--trash" id="statDeletedCard">
      <p class="label">Lixeira</p>
      <p class="value" id="statDeleted"><span class="stat-skeleton"></span></p>
      <p class="hint">Posts deletados (restaurar ou purgar)</p>
    </a>
  </section>

  <section class="quick-actions">
    <a href="/painel/posts" class="action-card">
      <p class="action-eyebrow">Posts</p>
      <p class="action-title">Gerenciar posts</p>
      <p class="action-desc">Rascunhos e publicados em um só lugar.</p>
    </a>
    <div class="action-card action-card--static">
      <p class="action-eyebrow">Atividade</p>
      <p class="action-title">Últimas edições</p>
      <ul id="recentEdits" class="recent-edits-list">
        <li class="skeleton">Carregando...</li>
      </ul>
    </div>
  </section>

  <script>
    // === Welcome com nome ===
    fetch('/api/auth/me')
      .then((r) => r.json())
      .then((data) => {
        if (data.user) {
          const $sub = document.getElementById('welcomeSubtitle');
          if ($sub) $sub.textContent = `Bem-vindo de volta, ${data.user.name}.`;
        }
      });

    // === Stats (cache cliente 10s) ===
    const STATS_CACHE_KEY = 'painel:stats';
    const STATS_TTL = 10_000;

    function renderStats(s: { total: number; drafts: number; published: number; unsynced: number; deleted?: number }) {
      const $t = document.getElementById('statTotal');
      const $d = document.getElementById('statDrafts');
      const $p = document.getElementById('statPublished');
      const $u = document.getElementById('statUnsynced');
      const $uCard = document.getElementById('statUnsyncedCard');
      const $bulkSync = document.getElementById('bulkSyncBtn') as HTMLButtonElement | null;
      const $del = document.getElementById('statDeleted');
      const $delCard = document.getElementById('statDeletedCard');
      const deletedCount = Number(s.deleted || 0);
      if ($t) $t.textContent = String(s.total);
      if ($d) $d.textContent = String(s.drafts);
      if ($p) $p.textContent = String(s.published);
      if ($u) $u.textContent = String(s.unsynced);
      if ($uCard) $uCard.classList.toggle('stat-card--warn-active', s.unsynced > 0);
      if ($bulkSync) {
        $bulkSync.hidden = s.unsynced <= 0;
        $bulkSync.dataset.count = String(s.unsynced);
      }
      if ($del) $del.textContent = String(deletedCount);
      if ($delCard) $delCard.classList.toggle('stat-card--trash-active', deletedCount > 0);
    }

    async function loadStats(force = false) {
      if (!force) {
        try {
          const raw = sessionStorage.getItem(STATS_CACHE_KEY);
          if (raw) {
            const { at, data } = JSON.parse(raw);
            if (Date.now() - at < STATS_TTL) {
              renderStats(data);
              return;
            }
          }
        } catch {}
      }
      const res = await fetch('/api/stats');
      if (!res.ok) return;
      const data = await res.json();
      renderStats(data);
      try {
        sessionStorage.setItem(STATS_CACHE_KEY, JSON.stringify({ at: Date.now(), data }));
      } catch {}
    }
    loadStats();

    // === Bulk sync: marca todos como sincronizados ===
    // Usado quando o painel detecta drift por causa de scripts antigos ou
    // edicoes manuais no Git. Idempotente (so afeta posts realmente unsynced).
    const $bulkSyncBtn = document.getElementById('bulkSyncBtn') as HTMLButtonElement | null;
    $bulkSyncBtn?.addEventListener('click', async () => {
      const count = $bulkSyncBtn.dataset.count || '0';
      const ok = await (window as any).confirmAction?.({
        title: 'Marcar todos como sincronizados?',
        message: `Vai marcar ${count} post${count === '1' ? '' : 's'} como sincronizado${count === '1' ? '' : 's'}. Use quando os arquivos no Git ja estao atualizados (manualmente ou via script).`,
        confirmLabel: 'Confirmar',
        cancelLabel: 'Cancelar',
      });
      if (!ok) return;

      const originalLabel = $bulkSyncBtn.textContent;
      $bulkSyncBtn.disabled = true;
      $bulkSyncBtn.textContent = 'Sincronizando...';

      try {
        const res = await fetch('/api/posts/sync-all', { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.error || 'falha');
        (window as any).toast?.(data.message || 'Sincronizado', 'success');
        // Invalida cache de stats e recarrega
        try { sessionStorage.removeItem(STATS_CACHE_KEY); } catch {}
        await loadStats(true);
        $bulkSyncBtn.disabled = false;
        $bulkSyncBtn.textContent = originalLabel;
      } catch (err: any) {
        (window as any).toast?.(err.message || 'Erro ao sincronizar', 'error');
        $bulkSyncBtn.disabled = false;
        $bulkSyncBtn.textContent = originalLabel;
      }
    });

    // === Atividade recente (3 últimas edições) ===
    function formatRelative(ts: number): string {
      const diff = Date.now() - ts;
      const days = Math.floor(diff / 86400000);
      if (days <= 0) return 'hoje';
      if (days === 1) return 'ontem';
      if (days < 7) return `há ${days} dias`;
      return new Date(ts).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' });
    }

    function escapeHtml(s: string): string {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    async function loadRecentEdits() {
      const list = document.getElementById('recentEdits');
      if (!list) return;
      try {
        const res = await fetch('/api/posts?status=all&page=1&per_page=3');
        if (!res.ok) throw new Error();
        const data = await res.json();
        const items = (data.items || []).slice(0, 3);
        if (!items.length) {
          list.innerHTML = '<li class="empty">Nenhuma atividade recente</li>';
          return;
        }
        list.innerHTML = items.map((it: any) => {
          const isDraft = it.type === 'draft';
          const href = isDraft
            ? `/painel/posts/editor?id=${encodeURIComponent(it.id.replace(/^draft:/, ''))}`
            : `/painel/posts/editor?slug=${encodeURIComponent(it.slug)}`;
          const ts = Number(it.updated_at || it.published_at || 0);
          return `<li>
            <a href="${href}">${escapeHtml(it.title || 'Sem título')}</a>
            <span class="recent-date">${ts ? formatRelative(ts) : '—'}</span>
          </li>`;
        }).join('');
      } catch {
        list.innerHTML = '<li class="empty">Erro ao carregar</li>';
      }
    }
    loadRecentEdits();
  </script>

  <style is:global>
    /* === STATS GRID === */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-card {
      background: var(--painel-surface);
      border: 1px solid var(--painel-border);
      border-radius: var(--painel-radius);
      padding: 20px 24px;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: box-shadow .15s, border-color .15s;
    }
    a.stat-card:hover {
      box-shadow: var(--painel-shadow-md);
      border-color: var(--painel-border-strong);
    }
    .stat-card .label {
      font-size: 13px;
      color: var(--painel-text-secondary);
      margin: 0 0 8px;
      font-weight: 500;
    }
    .stat-card .value {
      font-size: 32px;
      font-weight: 600;
      color: var(--painel-text-primary);
      line-height: 1.1;
      margin: 0;
    }
    .stat-card .hint {
      font-size: 12px;
      color: var(--painel-text-disabled);
      margin: 8px 0 0;
    }
    .stat-card--warn { border-color: var(--painel-border); }
    .stat-card--warn-active {
      background: #fff7e0;
      border-color: #fde68a;
    }
    .stat-card--warn-active .label,
    .stat-card--warn-active .value,
    .stat-card--warn-active .hint { color: #92400e; }
    .bulk-sync-btn {
      margin-top: 12px;
      padding: 6px 12px;
      background: rgba(var(--color-accent-rgb), 0.1);
      color: var(--color-accent);
      border: 1px solid rgba(var(--color-accent-rgb), 0.3);
      border-radius: 6px;
      font-family: var(--painel-font);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: background .15s, border-color .15s;
    }
    .bulk-sync-btn:hover:not(:disabled) {
      background: rgba(var(--color-accent-rgb), 0.18);
      border-color: rgba(var(--color-accent-rgb), 0.5);
    }
    .bulk-sync-btn:disabled { opacity: 0.6; cursor: wait; }
    .stat-card--trash { border-color: var(--painel-border); }
    .stat-card--trash-active {
      background: #f6f7f8;
      border-color: #dadce0;
    }
    .stat-card--trash-active .value { color: var(--painel-danger); }

    .stat-skeleton {
      display: inline-block;
      width: 64px;
      height: 32px;
      border-radius: 4px;
      background: linear-gradient(90deg, #f1f3f4 25%, #e8eaed 50%, #f1f3f4 75%);
      background-size: 200% 100%;
      animation: skel 1.4s linear infinite;
    }
    @keyframes skel {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* === QUICK ACTIONS === */
    .quick-actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
    }
    .action-card {
      background: var(--painel-surface);
      border: 1px solid var(--painel-border);
      border-radius: var(--painel-radius);
      padding: 24px;
      text-decoration: none;
      color: inherit;
      transition: box-shadow .15s, border-color .15s, transform .15s;
    }
    .action-card:hover {
      box-shadow: var(--painel-shadow-md);
      border-color: var(--painel-border-strong);
      transform: translateY(-1px);
    }
    .action-card--primary {
      background: var(--painel-accent-soft);
      border-color: #c9dcfa;
    }
    .action-card--primary .action-title { color: var(--painel-accent); }
    .action-card--static {
      cursor: default;
    }
    .action-card--static:hover {
      box-shadow: none;
      border-color: var(--painel-border);
      transform: none;
    }
    .recent-edits-list {
      list-style: none;
      padding: 0;
      margin: 12px 0 0;
      display: flex;
      flex-direction: column;
    }
    .recent-edits-list li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--painel-border);
      font-size: 14px;
    }
    .recent-edits-list li:last-child { border-bottom: 0; padding-bottom: 0; }
    .recent-edits-list li:first-child { padding-top: 0; }
    .recent-edits-list a {
      color: var(--painel-text-primary);
      text-decoration: none;
      font-weight: 500;
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .recent-edits-list a:hover { color: var(--painel-accent); }
    .recent-edits-list .recent-date {
      font-size: 12px;
      color: var(--painel-text-secondary);
      flex-shrink: 0;
    }
    .recent-edits-list .skeleton,
    .recent-edits-list .empty {
      color: var(--painel-text-disabled);
      font-size: 13px;
      text-align: center;
      padding: 12px 0;
      border-bottom: 0;
    }
    .action-eyebrow {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--painel-text-secondary);
      margin: 0 0 8px;
    }
    .action-card--primary .action-eyebrow { color: var(--painel-accent); }
    .action-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--painel-text-primary);
      margin: 0 0 6px;
    }
    .action-desc {
      font-size: 13px;
      color: var(--painel-text-secondary);
      margin: 0;
    }
  </style>
</PainelLayout>
