---
import PainelHead from '../../components/painel/PainelHead.astro';
import '../../styles/painel.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <PainelHead title="Painel — Paul Gomes" description="Painel administrativo" />
  </head>
  <body class="min-h-screen" style="background-color: var(--color-paper)">
    <div class="border-b" style="border-color: var(--color-border)">
      <div class="container-wide flex h-16 items-center justify-between">
        <h1 class="font-display text-xl font-bold">Painel · Paul Gomes</h1>
        <div class="flex items-center gap-6 text-sm">
          <span id="userInfo" style="color: var(--color-muted)">Carregando...</span>
          <button
            id="logoutBtn"
            class="text-sm underline underline-offset-4 transition-opacity hover:opacity-60"
          >
            Sair
          </button>
        </div>
      </div>
    </div>

    <main class="painel-main">
      <div class="max-w-3xl">
        <h2 class="font-display text-4xl font-bold tracking-tight mb-4">Bem-vindo ao painel</h2>
        <p class="text-lg mb-10" style="color: var(--color-muted)">Crie, edite e publique ensaios.</p>

        <div class="painel-stats-grid painel-stats-grid-4">
          <a href="/painel/posts" class="painel-stat painel-stat-link">
            <p class="painel-stat-label">Total</p>
            <p class="painel-stat-value" id="statTotal"><span class="painel-stat-skeleton"></span></p>
          </a>
          <a href="/painel/posts?status=draft" class="painel-stat painel-stat-link">
            <p class="painel-stat-label">Rascunhos</p>
            <p class="painel-stat-value" id="statDrafts"><span class="painel-stat-skeleton"></span></p>
          </a>
          <a href="/painel/posts?status=published" class="painel-stat painel-stat-link">
            <p class="painel-stat-label">Publicados</p>
            <p class="painel-stat-value" id="statPublished"><span class="painel-stat-skeleton"></span></p>
          </a>
          <div class="painel-stat painel-stat-warn" id="statUnsyncedCard">
            <p class="painel-stat-label">Não sincronizados</p>
            <p class="painel-stat-value" id="statUnsynced"><span class="painel-stat-skeleton"></span></p>
            <p class="painel-stat-hint">Editados no painel, pendentes de Git</p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/painel/posts" class="painel-card" style="text-decoration: none; color: inherit; display: block;">
            <p style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-muted); margin-bottom: 0.5rem;">📝 Posts</p>
            <p class="font-display" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Ensaios</p>
            <p style="font-size: 0.85rem; color: var(--color-muted); margin: 0;">Rascunhos e publicados</p>
          </a>

          <a href="/painel/posts/editor" class="painel-card" style="text-decoration: none; color: inherit; display: block;">
            <p style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-muted); margin-bottom: 0.5rem;">✍️ Novo</p>
            <p class="font-display" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Criar ensaio</p>
            <p style="font-size: 0.85rem; color: var(--color-muted); margin: 0;">Editor + auto-save</p>
          </a>
        </div>
      </div>
    </main>

    <script>
      // Carrega info do usuário
      fetch('/api/auth/me')
        .then((r) => r.json())
        .then((data) => {
          const userInfo = document.getElementById('userInfo');
          if (!userInfo) return;
          if (data.user) {
            userInfo.textContent = `${data.user.name} (${data.user.role})`;
          } else {
            window.location.href = '/painel/login';
          }
        });

      // Stats — cache cliente 10s pra evitar refetch ao voltar/avançar
      const STATS_CACHE_KEY = 'painel:stats';
      const STATS_TTL = 10_000;

      function renderStats(s: { total: number; drafts: number; published: number; unsynced: number }) {
        const $t = document.getElementById('statTotal');
        const $d = document.getElementById('statDrafts');
        const $p = document.getElementById('statPublished');
        const $u = document.getElementById('statUnsynced');
        const $uCard = document.getElementById('statUnsyncedCard');
        if ($t) $t.textContent = String(s.total);
        if ($d) $d.textContent = String(s.drafts);
        if ($p) $p.textContent = String(s.published);
        if ($u) $u.textContent = String(s.unsynced);
        if ($uCard) $uCard.classList.toggle('painel-stat-warn-active', s.unsynced > 0);
      }

      async function loadStats(force = false) {
        if (!force) {
          try {
            const raw = sessionStorage.getItem(STATS_CACHE_KEY);
            if (raw) {
              const { at, data } = JSON.parse(raw);
              if (Date.now() - at < STATS_TTL) {
                renderStats(data);
                return;
              }
            }
          } catch {}
        }

        const res = await fetch('/api/stats');
        if (!res.ok) return;
        const data = await res.json();
        renderStats(data);
        try {
          sessionStorage.setItem(STATS_CACHE_KEY, JSON.stringify({ at: Date.now(), data }));
        } catch {}
      }
      loadStats();

      // Logout
      document.getElementById('logoutBtn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/painel/login';
      });
    </script>
  </body>
</html>
