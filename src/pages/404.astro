---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`Página não encontrada — ${SITE_TITLE}`}
      description="A página que você procura não existe ou foi movida."
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <Header />

    <main class="nf-page">
      <section class="nf-inner container-wide">
        <p class="nf-code" aria-hidden="true">404</p>
        <h1 class="nf-title font-display">Esta página se dispersou.</h1>
        <p class="nf-text">
          O endereço que você procura não existe, mudou de lugar ou nunca esteve aqui.
          Mas há muito o que explorar adiante.
        </p>

        <div class="nf-actions">
          <a href="/" class="btn-neu btn-lg btn-primary">Voltar pra home</a>
          <a href="/blog" class="btn-neu btn-lg">Ver os ensaios →</a>
        </div>

        <p class="nf-signature">Thinking Forward.</p>
      </section>
    </main>

    <Footer />

    <style>
      .nf-page {
        display: flex;
        align-items: center;
        min-height: 64vh;
        padding: 5rem 0;
      }

      .nf-inner {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .nf-code {
        font-family: var(--font-display);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
        font-size: clamp(6rem, 22vw, 13rem);
        margin: 0;
        background: linear-gradient(135deg, #0103f9 0%, #3d40ff 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 60px rgba(1, 3, 249, 0.18);
      }

      .nf-title {
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.1;
        font-size: clamp(1.6rem, 4vw, 2.6rem);
        margin: 0.5rem 0 0;
        color: var(--color-ink);
      }

      .nf-text {
        margin: 1.25rem 0 0;
        max-width: 46ch;
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--color-muted);
      }

      .nf-actions {
        margin: 2.5rem 0 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
      }

      .nf-signature {
        margin: 3.5rem 0 0;
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 600;
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        color: #0103f9;
      }
    </style>
  </body>
</html>
