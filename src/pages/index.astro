---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import AIPromptBar from '../components/AIPromptBar.astro';
import Footer from '../components/Footer.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import TrendingPosts from '../components/TrendingPosts.astro';
import ThemePosts from '../components/ThemePosts.astro';
import AuthorBlock from '../components/AuthorBlock.astro';
import BrandsMarquee from '../components/BrandsMarquee.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import paulAvatar from '../assets/brand/paul-avatar.png';

// Preload do LCP: gera variants identicos ao <Image> do AuthorBlock
// pra browser comecar download antes de parsear o markup do hero.
const lcpAvatar = await getImage({
  src: paulAvatar,
  widths: [360, 540, 720, 1080, 1494],
  sizes: '(max-width: 640px) 360px, (max-width: 1280px) 680px, 760px',
  format: 'webp',
});

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Prioridade: post explicitamente marcado como featured no painel ->
// fallback pro mais recente com hero -> ultimo recurso primeiro overall
const featured =
  allPosts.find((p) => p.data.featured === true) ||
  allPosts.find((p) => p.data.heroImage) ||
  allPosts[0];
const latest = allPosts.filter((p) => p.id !== featured?.id).slice(0, 6);
const latestNews = allPosts.filter((p) => p.id !== featured?.id).slice(0, 8);
const totalPosts = allPosts.length;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- Preload do LCP (avatar do hero) — descoberta cedo, antes do JS/CSS parse -->
    <link
      rel="preload"
      as="image"
      href={lcpAvatar.src}
      imagesrcset={lcpAvatar.srcSet.attribute}
      imagesizes="(max-width: 640px) 360px, (max-width: 1280px) 680px, 760px"
      fetchpriority="high"
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- SOBRE O AUTOR (abertura) -->
      <AuthorBlock />

      <!-- BARRA GEO/AEO (entre hero e em destaque) — desktop apenas; no mobile aparece dentro do AuthorBlock entre foto e texto -->
      <div class="geo-desktop">
        <AIPromptBar />
      </div>

      <!-- MARCAS QUE PASSARAM POR AQUI -->
      <BrandsMarquee />

      <!-- EM DESTAQUE (banner com cantos arredondados) -->
      {featured && (
        <section style="border-color: var(--color-border)">
          <FeaturedPost post={featured} />
        </section>
      )}

      <!-- EM ALTA (trending posts) -->
      {latest.length > 0 && (
        <TrendingPosts posts={latest.slice(0, 4)} title="Em alta" />
      )}

      <!-- ÚLTIMAS NOTÍCIAS (8 posts visíveis + paginação que reflete arquivo total) -->
      {latestNews.length > 0 && (
        <ThemePosts
          posts={latestNews}
          title="Últimas notícias"
          totalCount={totalPosts}
          perPage={8}
          archiveHref="/blog"
        />
      )}

    </main>
    <Footer />

    <style>
      /* No mobile a barra GEO aparece dentro do AuthorBlock (entre foto e texto) */
      @media (max-width: 1023px) {
        .geo-desktop {
          display: none;
        }
      }

    </style>
  </body>
</html>
