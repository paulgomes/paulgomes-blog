---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import AIPromptBar from '../components/AIPromptBar.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import TrendingPosts from '../components/TrendingPosts.astro';
import AuthorBlock from '../components/AuthorBlock.astro';
import BrandsMarquee from '../components/BrandsMarquee.astro';
import { SITE_TITLE, SITE_DESCRIPTION, FEATURED_THEME } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allPosts.find((p) => p.data.heroImage) || allPosts[0];
const latest = allPosts.filter((p) => p.id !== featured?.id).slice(0, 6);
const themePosts = allPosts
  .filter((p) => p.id !== featured?.id)
  .filter((post) => {
    const haystack = `${post.data.title} ${post.data.description || ''} ${post.id}`.toLowerCase();
    return FEATURED_THEME.keywords.some((kw) => haystack.includes(kw));
  })
  .slice(0, 4);

const totalEnsaios = allPosts.length;
const firstYear = allPosts.length
  ? Math.min(...allPosts.map((p) => p.data.pubDate.getFullYear()))
  : new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <!-- SOBRE O AUTOR (abertura) -->
      <AuthorBlock />

      <!-- BARRA GEO/AEO (entre hero e em destaque) — desktop apenas; no mobile aparece dentro do AuthorBlock entre foto e texto -->
      <div class="geo-desktop">
        <AIPromptBar />
      </div>

      <!-- EM DESTAQUE (banner full-bleed) -->
      {featured && (
        <section class="border-t" style="border-color: var(--color-border)">
          <FeaturedPost post={featured} />
        </section>
      )}

      <!-- EM ALTA (trending posts) -->
      {latest.length > 0 && (
        <TrendingPosts posts={latest.slice(0, 4)} title="Em alta" />
      )}

      <!-- MARCAS QUE PASSARAM POR AQUI -->
      <BrandsMarquee />

      <!-- TEMA DO MÊS -->
      {themePosts.length > 0 && (
        <section class="theme-section border-t" style="border-color: var(--color-border)">
          <div class="container-wide py-16 md:py-20">
            <SectionHeader
              eyebrow={`Tema do mês · ${FEATURED_THEME.label}`}
              title="O que ler agora sobre IA e tecnologia"
              description={FEATURED_THEME.description}
            />
            <div class="grid gap-10 md:grid-cols-2">
              {themePosts.map((post) => <PostCard post={post} />)}
            </div>
          </div>
        </section>
      )}

      <!-- ARQUIVO -->
      <section class="container-wide py-16 md:py-24 border-t" style="border-color: var(--color-border)">
        <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-end">
          <div class="max-w-2xl">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.25em]" style="color: var(--color-muted)">
              ◆ Arquivo
            </p>
            <h2 class="font-display text-4xl font-bold leading-tight tracking-tight md:text-6xl">
              <span class="block">{totalEnsaios} ensaios</span>
              <span class="block" style="color: var(--color-muted)">desde {firstYear}.</span>
            </h2>
            <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-muted)">
              Todo o pensamento publicado aqui — do mais recente ao primeiro registro. Explore por ano, tema ou palavra-chave.
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <a href="/blog" class="inline-flex items-center gap-3 self-start rounded-full px-6 py-3 text-sm font-medium transition-opacity hover:opacity-80" style="background-color: var(--color-ink); color: var(--color-paper);">
              Explorar arquivo
              <span aria-hidden="true">→</span>
            </a>
            <a href="/rss.xml" class="inline-flex items-center gap-3 self-start text-sm underline underline-offset-4 transition-opacity hover:opacity-60">
              Assinar RSS
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />

    <style>
      .theme-section {
        background-color: var(--color-subtle);
      }

      /* No mobile a barra GEO aparece dentro do AuthorBlock (entre foto e texto) */
      @media (max-width: 1023px) {
        .geo-desktop {
          display: none;
        }
      }
    </style>
  </body>
</html>
