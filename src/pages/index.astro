---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts[0];
const rest = posts.slice(1);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="container-wide pt-16 pb-12 md:pt-24 md:pb-16">
        <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight md:text-7xl">
          Branding, tecnologia<br />
          e o futuro dos negócios.
        </h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl" style="color: var(--color-muted)">
          Ensaios e ideias de Paul Gomes sobre como marcas, produtos e pessoas se constroem na era da inteligência artificial.
        </p>
      </section>

      {featured && (
        <section class="container-wide py-12 md:py-16 border-t" style="border-color: var(--color-border)">
          <FeaturedPost post={featured} />
        </section>
      )}

      {rest.length > 0 && (
        <section class="container-wide py-12 md:py-16 border-t" style="border-color: var(--color-border)">
          <div class="mb-10 flex items-baseline justify-between">
            <h2 class="font-display text-2xl font-bold md:text-3xl">Últimos ensaios</h2>
            <a href="/blog" class="text-sm underline underline-offset-4 transition-opacity hover:opacity-60">
              Ver todos →
            </a>
          </div>
          <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>
