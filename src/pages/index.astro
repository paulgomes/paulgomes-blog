---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import AIPromptBar from '../components/AIPromptBar.astro';
import Footer from '../components/Footer.astro';
import FeaturedShowcase from '../components/FeaturedShowcase.astro';
import CategoryBar from '../components/CategoryBar.astro';
import TrendingPosts from '../components/TrendingPosts.astro';
import ThemePosts from '../components/ThemePosts.astro';
import AuthorBlock from '../components/AuthorBlock.astro';
import BrandsMarquee from '../components/BrandsMarquee.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import paulAvatar from '../assets/brand/paul-avatar.png';

// Preload do LCP: gera variants identicos ao <Image> do AuthorBlock
// pra browser comecar download antes de parsear o markup do hero.
const lcpAvatar = await getImage({
  src: paulAvatar,
  widths: [360, 540, 720, 1080, 1494],
  sizes: '(max-width: 640px) 360px, (max-width: 1280px) 680px, 760px',
  format: 'webp',
});

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Destaques: TODOS os posts marcados como featured no painel (ordem: mais recente
// primeiro, herdada do sort acima). Fallback pro mais recente com hero -> primeiro
// overall, garantindo que o carrossel sempre tenha ao menos 1 slide.
const featuredPosts = allPosts.filter((p) => p.data.featured === true);
const carouselPosts =
  featuredPosts.length > 0
    ? featuredPosts
    : [allPosts.find((p) => p.data.heroImage) || allPosts[0]].filter(Boolean);
const featuredIds = new Set(carouselPosts.map((p) => p!.id));
const latest = allPosts.filter((p) => !featuredIds.has(p.id)).slice(0, 6);
const latestNews = allPosts.filter((p) => !featuredIds.has(p.id)).slice(0, 8);
const totalPosts = allPosts.length;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- Open-Meteo: conexão antecipada pro widget de tempo (fetch client-side) -->
    <link rel="preconnect" href="https://api.open-meteo.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.open-meteo.com" />
    <!-- Preload do LCP (avatar do hero) — descoberta cedo, antes do JS/CSS parse -->
    <link
      rel="preload"
      as="image"
      href={lcpAvatar.src}
      imagesrcset={lcpAvatar.srcSet.attribute}
      imagesizes="(max-width: 640px) 360px, (max-width: 1280px) 680px, 760px"
      fetchpriority="high"
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- SOBRE O AUTOR (abertura) -->
      <AuthorBlock />

      <!-- BARRA GEO/AEO (entre hero e em destaque) — desktop apenas; no mobile aparece dentro do AuthorBlock entre foto e texto -->
      <div class="geo-desktop">
        <AIPromptBar />
      </div>

      <!-- BARRA DE CATEGORIAS (pills roláveis com setas) -->
      <CategoryBar />

      <!-- EM DESTAQUE (carrossel + card do autor) -->
      {carouselPosts.length > 0 && (
        <FeaturedShowcase posts={carouselPosts} />
      )}

      <!-- EM ALTA (trending posts) -->
      {latest.length > 0 && (
        <TrendingPosts posts={latest.slice(0, 4)} title="Em alta" />
      )}

      <!-- MARCAS QUE PASSARAM POR AQUI -->
      <BrandsMarquee />

      <!-- O TEMPO AGORA (Open-Meteo, grátis e sem chave; oculto se indisponível) -->
      <WeatherWidget />

      <!-- ÚLTIMAS NOTÍCIAS (8 posts visíveis + paginação que reflete arquivo total) -->
      {latestNews.length > 0 && (
        <ThemePosts
          posts={latestNews}
          title="Últimas notícias"
          totalCount={totalPosts}
          perPage={8}
          archiveHref="/blog"
        />
      )}

      <!-- ESPAÇO PARA BANNER ADS (placeholder; pronto pra receber o código do anúncio) -->
      <AdSlot />

    </main>
    <Footer />

    <style>
      /* No mobile a barra GEO aparece dentro do AuthorBlock (entre foto e texto) */
      @media (max-width: 1023px) {
        .geo-desktop {
          display: none;
        }
      }

    </style>
  </body>
</html>
