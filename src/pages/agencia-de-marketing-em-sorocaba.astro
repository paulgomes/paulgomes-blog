---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SOCIAL } from '../consts';
import { faqPage } from '../lib/schema';

const PAGE_TITLE = 'Agência de Marketing em Sorocaba | Agência WYS';
const PAGE_DESC =
  'A Agência de Marketing WYS é um ecossistema de inovação criativa em Sorocaba: tráfego pago, criação de sites, branding, redes sociais, SEO e sistemas. Marca com propósito, comunicação com resultado.';

// CTAs apontam pra agenciawys.com.br (destino seguro). Trocar por WhatsApp se houver número confirmado.
const CTA_URL = 'https://agenciawys.com.br';
const PHONE_DISPLAY = '+55 (11) 3198-9073';
const PHONE_TEL = 'tel:+551131989073';
const ADDRESS = 'Rua Oronário Domingos dos Santos, 15 - Parque Campolim, Sorocaba / SP';

const solutions = [
  { icon: 'traffic', title: 'Gestão de Tráfego Pago', desc: 'Escalamos campanhas pagas para gerar leads, vendas e crescimento real, com foco total em performance e ROI.' },
  { icon: 'site', title: 'Criação de Sites', desc: 'Sites profissionais e velozes para aumentar o volume de leads qualificados e fortalecer sua autoridade digital.' },
  { icon: 'brand', title: 'Criação de Marca', desc: 'Desenvolvemos identidades visuais impactantes e discursos estratégicos para valorizar o seu negócio.' },
  { icon: 'social', title: 'Redes Sociais', desc: 'Gestão de conteúdo com engajamento e conexão real para transformar seguidores em clientes fiéis.' },
  { icon: 'seo', title: 'Consultoria SEO', desc: 'Estratégias de conteúdo para posicionar a sua empresa nos primeiros resultados orgânicos do Google.' },
  { icon: 'apps', title: 'Apps e Sistemas', desc: 'Desenvolvimento de soluções tecnológicas personalizadas e sistemas complexos com usabilidade simples.' },
];

const stats = [
  { value: '+15', label: 'Anos de história' },
  { value: '+2.000', label: 'Clientes atendidos' },
  { value: '+9 mi', label: 'Em mídia gerenciada' },
  { value: '+17', label: 'Países atendidos' },
];

const clients = ['Heliar', 'Smoov', '99 Pop', 'Disney', 'Ihara', 'Celmar'];

const steps = [
  { n: '01', title: 'Agende uma conversa', desc: 'Entre em contato via WhatsApp ou formulário para entendermos o seu momento.' },
  { n: '02', title: 'Proposta sob medida', desc: 'Desenhamos uma estratégia personalizada de acordo com os seus objetivos.' },
  { n: '03', title: 'Início do projeto', desc: 'Colocamos o plano em ação com foco total em performance e crescimento.' },
];

const faqs = [
  {
    q: 'O que faz uma agência de marketing em Sorocaba?',
    a: 'Cuida de toda a presença e o crescimento da sua marca: estratégia, branding, criação de sites, gestão de tráfego pago, redes sociais, SEO e desenvolvimento de sistemas. O objetivo é simples: mais visibilidade, mais leads qualificados e mais vendas.',
  },
  {
    q: 'Por que contratar a Agência WYS?',
    a: 'Somos um ecossistema de inovação criativa com metodologia projetual própria, mais de 15 anos de história e mais de 2.000 clientes atendidos em 17 países. Unimos estratégia humana e inteligência artificial (Made by humans, Powered by AI) para entregar resultados tangíveis.',
  },
  {
    q: 'Qual o investimento necessário?',
    a: 'Depende do escopo e dos objetivos do seu negócio. Desenhamos propostas sob medida, do projeto pontual ao acompanhamento contínuo. Fale com um especialista para receber um orçamento personalizado.',
  },
  {
    q: 'Vou vender mais com marketing digital?',
    a: 'Marketing digital bem executado conecta e converte. Com estratégias de tráfego, conteúdo e SEO focadas em performance e ROI, ampliamos a sua geração de leads e as suas vendas de forma mensurável.',
  },
  {
    q: 'Como iniciamos o projeto?',
    a: 'Em três passos: agende uma conversa pelo WhatsApp ou formulário, receba uma proposta personalizada e, na sequência, colocamos o plano em ação com foco total em performance.',
  },
];

const ICONS: Record<string, string> = {
  traffic: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v6h-6"/></svg>',
  site: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M9 21h6M12 18v3"/></svg>',
  brand: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.3 5.7L20 11l-5.7 2.3L12 19l-2.3-5.7L4 11l5.7-2.3z"/></svg>',
  social: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.5L3 21l2-5.7A8.5 8.5 0 1 1 21 11.5z"/></svg>',
  seo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>',
  apps: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Agência WYS · Marketing em Sorocaba',
  description: PAGE_DESC,
  url: 'https://paulgomes.com.br/agencia-de-marketing-em-sorocaba/',
  telephone: '+551131989073',
  areaServed: 'Sorocaba, SP',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Oronário Domingos dos Santos, 15 - Parque Campolim',
    addressLocality: 'Sorocaba',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  founder: { '@type': 'Person', name: 'Paul Gomes', url: 'https://paulgomes.com.br/sobre' },
  sameAs: ['https://agenciawys.com.br', SOCIAL.linkedin, SOCIAL.instagram],
};

const faqSchema = faqPage(faqs);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={PAGE_TITLE} description={PAGE_DESC} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <Header />

    <main class="lp">
      <!-- HERO -->
      <section class="lp-hero">
        <div class="container-wide lp-hero-inner">
          <p class="lp-eyebrow">Agência WYS · Sorocaba</p>
          <h1 class="lp-hero-title font-display">
            Agência de Marketing<br />em <span class="lp-accent">Sorocaba</span>
          </h1>
          <p class="lp-hero-sub">
            A Agência de Marketing WYS é um ecossistema de inovação criativa, impulsionando o futuro
            das empresas através de soluções inteligentes.
          </p>
          <div class="lp-cta-row">
            <a class="lp-btn lp-btn-primary" href={CTA_URL} target="_blank" rel="noopener">Falar com especialista</a>
            <a class="lp-btn lp-btn-ghost" href="#solucoes">Conheça as soluções</a>
          </div>
          <p class="lp-made">Made by humans · Powered by AI</p>
        </div>
      </section>

      <!-- POSICIONAMENTO -->
      <section class="lp-section">
        <div class="container-wide lp-narrow">
          <h2 class="lp-h2 font-display">
            Junto com a Agência de Marketing WYS, negócios no mundo inteiro estão indo além
          </h2>
          <p class="lp-lead">
            Marca com propósito, comunicação com resultado: potencializamos a sua comunicação e
            minimizamos as distâncias entre produtos, serviços e consumidores. Somos especialistas
            em cuidar da imagem de empresas que querem se diferenciar em meio à concorrência.
          </p>
          <p class="lp-lead">
            Seguimos uma metodologia projetual própria, com alta performance e resultados tangíveis.
            Liderada por <a href="/sobre">Paul Gomes</a>, fundador e CEO do Grupo WYS.
          </p>
        </div>
      </section>

      <!-- SOLUÇÕES -->
      <section id="solucoes" class="lp-section lp-section-subtle">
        <div class="container-wide">
          <header class="lp-head">
            <p class="lp-eyebrow">Soluções Agência WYS</p>
            <h2 class="lp-h2 font-display">Conheça as nossas soluções</h2>
            <p class="lp-head-sub">
              Ajudamos empresas a alcançarem mais resultados com estratégias de marketing que
              realmente conectam e convertem.
            </p>
          </header>
          <div class="lp-grid lp-grid-3">
            {solutions.map((s) => (
              <article class="lp-card">
                <span class="lp-card-ic" aria-hidden="true" set:html={ICONS[s.icon]} />
                <h3 class="lp-card-title font-display">{s.title}</h3>
                <p class="lp-card-desc">{s.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- NÚMEROS -->
      <section class="lp-stats">
        <div class="container-wide">
          <p class="lp-stats-intro">Junto com a Agência de Marketing WYS, negócios no mundo inteiro estão indo além</p>
          <div class="lp-grid lp-grid-4">
            {stats.map((st) => (
              <div class="lp-stat">
                <span class="lp-stat-value font-display">{st.value}</span>
                <span class="lp-stat-label">{st.label}</span>
              </div>
            ))}
          </div>
          <ul class="lp-clients" aria-label="Marcas atendidas">
            {clients.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </section>

      <!-- PASSOS -->
      <section class="lp-section">
        <div class="container-wide">
          <header class="lp-head">
            <p class="lp-eyebrow">Processo</p>
            <h2 class="lp-h2 font-display">Três passos para profissionalizar o seu marketing</h2>
            <p class="lp-head-sub">Um processo simples, transparente e focado em resultados reais.</p>
          </header>
          <div class="lp-grid lp-grid-3 lp-steps">
            {steps.map((step) => (
              <article class="lp-step">
                <span class="lp-step-n font-display">{step.n}</span>
                <h3 class="lp-card-title font-display">{step.title}</h3>
                <p class="lp-card-desc">{step.desc}</p>
              </article>
            ))}
          </div>
          <div class="lp-center">
            <a class="lp-btn lp-btn-primary" href={CTA_URL} target="_blank" rel="noopener">Falar com especialista</a>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="lp-section lp-section-subtle">
        <div class="container-wide lp-narrow">
          <header class="lp-head">
            <p class="lp-eyebrow">FAQ informativo</p>
            <h2 class="lp-h2 font-display">Como transformamos a sua marca em Sorocaba</h2>
          </header>
          <div class="lp-faq">
            {faqs.map((f) => (
              <details class="lp-faq-item">
                <summary>
                  <span>{f.q}</span>
                  <svg class="lp-faq-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTATO -->
      <section class="lp-section">
        <div class="container-wide lp-contact">
          <div class="lp-contact-copy">
            <p class="lp-eyebrow">Vamos conversar</p>
            <h2 class="lp-h2 font-display">Não espere mais. Fale com um especialista hoje mesmo</h2>
            <p class="lp-lead">
              Estamos no Campolim, a região mais nobre e acessível de Sorocaba, prontos para receber
              você e a sua equipe em um ambiente projetado para inspirar.
            </p>
            <div class="lp-cta-row">
              <a class="lp-btn lp-btn-primary" href={CTA_URL} target="_blank" rel="noopener">Falar com especialista</a>
            </div>
          </div>
          <ul class="lp-contact-info">
            <li>
              <span class="lp-contact-label">Endereço</span>
              <span class="lp-contact-value">{ADDRESS}</span>
            </li>
            <li>
              <span class="lp-contact-label">Telefone</span>
              <a class="lp-contact-value" href={PHONE_TEL}>{PHONE_DISPLAY}</a>
            </li>
            <li>
              <span class="lp-contact-label">Site</span>
              <a class="lp-contact-value" href={CTA_URL} target="_blank" rel="noopener">agenciawys.com.br</a>
            </li>
          </ul>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .lp {
    color: var(--color-ink);
    background: var(--color-paper);
  }

  .lp-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lp-accent { color: var(--color-accent); }

  .lp-h2 {
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    color: var(--color-ink);
  }

  .lp-lead {
    margin: 1.25rem 0 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .lp-lead a {
    color: var(--color-accent);
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }

  /* === SECTIONS === */
  .lp-section { padding: clamp(3.5rem, 7vw, 6rem) 0; }
  .lp-section-subtle { background: var(--color-subtle); }
  .lp-narrow { max-width: 760px; }
  .lp-center { margin-top: 3rem; text-align: center; }

  .lp-head { max-width: 680px; margin: 0 auto clamp(2.5rem, 5vw, 3.5rem); text-align: center; }
  .lp-head-sub { margin: 1rem 0 0; font-size: 1.05rem; line-height: 1.65; color: var(--color-muted); }

  /* === HERO === */
  .lp-hero {
    position: relative;
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(3.5rem, 7vw, 5.5rem);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .lp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 60% at 50% 0%, rgba(var(--color-accent-rgb), 0.1), transparent 70%);
  }
  .lp-hero-inner { max-width: 820px; }
  .lp-hero-title {
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    font-size: clamp(2.4rem, 7vw, 4.4rem);
    color: var(--color-ink);
  }
  .lp-hero-sub {
    margin: 1.5rem auto 0;
    max-width: 620px;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-muted);
  }

  .lp-cta-row {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
  }
  .lp-made {
    margin: 1.75rem 0 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.7;
  }

  /* === BOTÕES === */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.75rem;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    border: 1.5px solid transparent;
  }
  .lp-btn-primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 10px 24px rgba(var(--color-accent-rgb), 0.28);
  }
  .lp-btn-primary:hover {
    transform: translateY(-2px);
    background: var(--color-accent-2);
    box-shadow: 0 14px 30px rgba(var(--color-accent-rgb), 0.38);
  }
  .lp-btn-ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border);
  }
  .lp-btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* === GRIDS === */
  .lp-grid { display: grid; gap: 1.25rem; }
  .lp-grid-3 { grid-template-columns: repeat(3, 1fr); }
  .lp-grid-4 { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 900px) { .lp-grid-3 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .lp-grid-3, .lp-grid-4 { grid-template-columns: 1fr; }
  }

  /* === CARDS DE SOLUÇÃO === */
  .lp-card {
    padding: 1.75rem;
    border-radius: 18px;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .lp-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--color-accent-rgb), 0.5);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
  }
  .lp-card-ic {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .lp-card-ic :global(svg) { width: 26px; height: 26px; }
  .lp-card-title { margin: 0 0 0.6rem; font-size: 1.2rem; font-weight: 700; color: var(--color-ink); }
  .lp-card-desc { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--color-muted); }

  /* === NÚMEROS === */
  .lp-stats {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    background: var(--color-accent);
    color: #fff;
  }
  .lp-stats-intro {
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
    max-width: 640px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    line-height: 1.3;
  }
  .lp-stat { text-align: center; }
  .lp-stat-value { display: block; font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 800; line-height: 1; letter-spacing: -0.02em; }
  .lp-stat-label { display: block; margin-top: 0.5rem; font-size: 0.85rem; font-weight: 500; opacity: 0.85; }

  .lp-clients {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: clamp(1.75rem, 3vw, 2.25rem) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .lp-clients li {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.01em;
    opacity: 0.9;
  }

  /* === PASSOS === */
  .lp-step {
    padding: 2rem 1.75rem;
    border-radius: 18px;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
  }
  .lp-step-n {
    display: block;
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
    color: rgba(var(--color-accent-rgb), 0.25);
    margin-bottom: 1rem;
  }

  /* === FAQ === */
  .lp-faq {
    max-width: 720px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
  }
  .lp-faq-item { border-bottom: 1px solid var(--color-border); }
  .lp-faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-ink);
  }
  .lp-faq-item summary::-webkit-details-marker { display: none; }
  .lp-faq-chev { width: 20px; height: 20px; flex-shrink: 0; color: var(--color-accent); transition: transform 0.25s ease; }
  .lp-faq-item[open] .lp-faq-chev { transform: rotate(180deg); }
  .lp-faq-item p {
    margin: 0;
    padding: 0 0.25rem 1.4rem;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* === CONTATO === */
  .lp-contact {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 800px) { .lp-contact { grid-template-columns: 1fr; } }
  .lp-contact-info {
    list-style: none;
    margin: 0;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-radius: 18px;
    border: 1px solid var(--color-border);
    background: var(--color-subtle);
  }
  .lp-contact-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }
  .lp-contact-value {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink);
    text-decoration: none;
  }
  a.lp-contact-value:hover { color: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .lp-btn, .lp-card, .lp-faq-chev { transition: none; }
    .lp-btn:hover, .lp-card:hover { transform: none; }
  }
</style>
