---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SOCIAL_LINKEDIN, SOCIAL_EMAIL } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Sobre — ${SITE_TITLE}`} description="Sobre Paul Gomes." />
  </head>
  <body>
    <Header />
    <main>
      <section class="container-prose pt-16 pb-24 md:pt-24">
        <h1 class="font-display text-5xl font-bold tracking-tight md:text-6xl">Sobre</h1>
        <div class="mt-10 space-y-6 text-lg leading-relaxed">
          <p>
            Sou Paul Gomes. Escrevo aqui sobre branding, tecnologia e o futuro dos negócios.
          </p>
          <p>
            Fundador e CEO do <a href="https://agenciawys.com.br" class="underline underline-offset-4">Grupo WYS</a>, ajudo marcas e empresas a se reposicionarem na era da inteligência artificial, com foco em estratégia, design e crescimento digital.
          </p>
          <p>
            Este espaço é onde compartilho ideias em construção, ensaios e descobertas — sem pressa, sem fórmula.
          </p>
        </div>

        <div class="mt-12 flex gap-6 text-sm">
          <a href={SOCIAL_LINKEDIN} target="_blank" rel="noopener" class="underline underline-offset-4 transition-opacity hover:opacity-60">LinkedIn →</a>
          <a href={SOCIAL_EMAIL} class="underline underline-offset-4 transition-opacity hover:opacity-60">E-mail →</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
